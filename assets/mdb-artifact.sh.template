#!/bin/sh
# 10-mdb-artifact.sh - install the MDB's own .mender. Generated by the installer.
#
# Starts the install and returns, so the coordinator moves straight on to the
# dashboard phase and the two run together. The MDB writes its own eMMC while
# the dashboard is being flashed and uploaded to, and neither touches what the
# other writes, so serialising them only adds their durations together.
#
# The outcome lands in RESULT_FILE. 80-reboot.sh joins on it before the reboot
# that activates both images, so this script exiting says the install started,
# never that it worked.
#
# The commit is not ours: update-service commits StateNeedsCommit at its next
# start on the full image, and u-boot rolls back a rootfs that does not boot.

INSTALLER_DIR="/data/installer"
SCRIPTS_DIR="$INSTALLER_DIR/scripts"
RESULT_FILE="$INSTALLER_DIR/mdb-artifact.result"
RUN_ID="{{RUN_ID}}"
LOG_DIR="$INSTALLER_DIR/history/$RUN_ID"
LOG="$LOG_DIR/mdb-artifact.log"
ARTIFACT="{{MDB_ARTIFACT_PATH}}"

mkdir -p "$LOG_DIR" 2>/dev/null
rm -f "$RESULT_FILE"

log() { echo "$(date '+%H:%M:%S') $*" >> "$LOG" 2>/dev/null; }

# Segment 2 of the blinker bar is this install and nothing else. The background
# subshell below inherits these, which is what lets it fill the segment long
# after this script has returned.
. "$SCRIPTS_DIR/signal.sh" || { echo "missing $SCRIPTS_DIR/signal.sh" >&2; exit 1; }

# A plan that leaves the MDB alone still queues this phase, so the join in
# 80-reboot.sh has something to read either way. Nothing lights: there is no
# main-board firmware in this run, and a segment that filled anyway would be
# claiming work nobody did.
if [ -z "$ARTIFACT" ]; then
  log "no MDB artifact in this plan"
  echo "skipped" > "$RESULT_FILE"
  # Retire on the way out like the success path does. A phase that exits
  # without removing itself has not completed as far as the coordinator is
  # concerned, so a plan with no MDB artifact re-ran this every boot until it
  # was dropped after four attempts.
  rm -f "$0" "$0.tries"
  sync
  exit 0
fi

if [ ! -f "$ARTIFACT" ]; then
  log "ERROR: $ARTIFACT is missing"
  echo "error: the MDB artifact is missing" > "$RESULT_FILE"
  rm -f "$0" "$0.tries"
  sync
  exit 0
fi

progress_set "$SEGMENT_MDB" active

# The install runs in its own unit, not as a child of this script. The
# coordinator runs phases under librescoot-onboot.service, Type=oneshot with
# the default KillMode, and stops the moment a later phase exits non-zero;
# systemd then takes every process in the unit's cgroup with it. A bare
# background subshell here died that way with the slot half-written and no
# verdict ever reaching RESULT_FILE, so 80-reboot.sh waited out its full
# limit on every retry. Where systemd-run is missing the job is at least
# detached from this shell's session; that is the fixture case, not a board.
WORKER="$INSTALLER_DIR/mdb-artifact-worker.sh"
{
  echo '#!/bin/sh'
  echo "ARTIFACT='$ARTIFACT'"
  echo "RESULT_FILE='$RESULT_FILE'"
  echo "LOG='$LOG'"
  echo "SCRIPTS_DIR='$SCRIPTS_DIR'"
  cat << 'WORKER'
log() { echo "$(date '+%H:%M:%S') $*" >> "$LOG" 2>/dev/null; }
. "$SCRIPTS_DIR/signal.sh" || exit 1
# mender refuses to install while a transaction is open. Closing it either
# way is fine here: nothing worth keeping is installed yet, and commit falls
# back to rollback when a state script fails, which is what the bootstrap
# image does.
mender-update commit >/dev/null 2>&1 || mender-update rollback >/dev/null 2>&1 || true
log "installing $ARTIFACT"
if mender-update install "$ARTIFACT" >> "$LOG" 2>&1; then
  log "install finished, the slot is pending a reboot"
  # The verdict first, the light after: 80-reboot.sh is spinning on this file
  # and must not wait behind anything cosmetic.
  echo "ok" > "$RESULT_FILE"
  progress_set "$SEGMENT_MDB" done
else
  RC=$?
  log "ERROR: mender-update install exited $RC"
  echo "error: mender-update install exited $RC" > "$RESULT_FILE"
fi
sync
rm -f "$0"
WORKER
} > "$WORKER"
chmod +x "$WORKER"

# A systemd-run that exists but cannot start the unit (no privilege, no
# system bus, a fixture) falls through to the detached job rather than
# ending the install: the unit is the better home, not the only one.
STARTED=""
if command -v systemd-run >/dev/null 2>&1; then
  systemctl stop librescoot-mdb-artifact.service >/dev/null 2>&1
  if systemd-run --unit=librescoot-mdb-artifact --collect --quiet \
      --slice=system.slice /bin/sh "$WORKER" >/dev/null 2>&1; then
    log "started as librescoot-mdb-artifact.service"
    STARTED="yes"
  else
    log "could not start the install unit, running the install detached instead"
  fi
fi
if [ -z "$STARTED" ]; then
  if command -v setsid >/dev/null 2>&1; then
    setsid /bin/sh "$WORKER" >/dev/null 2>&1 < /dev/null &
  else
    /bin/sh "$WORKER" >/dev/null 2>&1 < /dev/null &
  fi
  log "started in the background as pid $!"
fi

# Retire now, not when the install finishes: the job was to start it. Left
# queued it re-runs after the reboot and installs the same artifact again.
# 80-reboot.sh joins on RESULT_FILE, which outlives this script.
rm -f "$0" "$0.tries"
sync
exit 0

#!/bin/sh
# 10-mdb-artifact.sh — install the MDB's own .mender. Generated by the installer.
#
# Starts the install and returns, so the coordinator moves straight on to the
# dashboard phase and the two run together. The MDB writes its own eMMC while
# the dashboard is being flashed and uploaded to, and neither touches what the
# other writes, so serialising them only adds their durations together.
#
# The outcome lands in RESULT_FILE. 80-reboot.sh joins on it before the reboot
# that activates both images, so this script exiting says the install started,
# never that it worked.
#
# The commit is not ours: update-service commits StateNeedsCommit at its next
# start on the full image, and u-boot rolls back a rootfs that does not boot.

INSTALLER_DIR="/data/installer"
RESULT_FILE="$INSTALLER_DIR/mdb-artifact.result"
RUN_ID="{{RUN_ID}}"
LOG_DIR="$INSTALLER_DIR/history/$RUN_ID"
LOG="$LOG_DIR/mdb-artifact.log"
ARTIFACT="{{MDB_ARTIFACT_PATH}}"

mkdir -p "$LOG_DIR" 2>/dev/null
rm -f "$RESULT_FILE"

log() { echo "$(date '+%H:%M:%S') $*" >> "$LOG" 2>/dev/null; }

# A plan that leaves the MDB alone still queues this phase, so the join in
# 80-reboot.sh has something to read either way.
if [ -z "$ARTIFACT" ]; then
  log "no MDB artifact in this plan"
  echo "skipped" > "$RESULT_FILE"
  sync
  exit 0
fi

if [ ! -f "$ARTIFACT" ]; then
  log "ERROR: $ARTIFACT is missing"
  echo "error: the MDB artifact is missing" > "$RESULT_FILE"
  sync
  exit 0
fi

(
  # mender refuses to install while a transaction is open. Closing it either
  # way is fine here: nothing worth keeping is installed yet, and commit falls
  # back to rollback when a state script fails, which is what the bootstrap
  # image does.
  mender-update commit >/dev/null 2>&1 || mender-update rollback >/dev/null 2>&1 || true
  log "installing $ARTIFACT"
  if mender-update install "$ARTIFACT" >> "$LOG" 2>&1; then
    log "install finished, the slot is pending a reboot"
    echo "ok" > "$RESULT_FILE"
  else
    RC=$?
    log "ERROR: mender-update install exited $RC"
    echo "error: mender-update install exited $RC" > "$RESULT_FILE"
  fi
  sync
) >/dev/null 2>&1 &

log "started in the background as pid $!"
exit 0

#!/bin/sh
# Librescoot install finalize - generated by the installer.
#
# Restores settings and required services before recording completion. PM may
# reboot during handover, so this phase stays queued until restoration succeeds.
#
# One copy, two callers. The laptop runs it detached at the end of an attended
# install, because restoring usb0-policy severs the transport the command
# arrived on. The coordinator runs it as the last phase of an unattended one.
# It used to be written twice, once in the trampoline and once across the
# installer's finish, and the two had already drifted.
#
# Removes itself last, not first: the coordinator counts the attempt before
# making it and gives up after three, so a run that dies part-way through gets
# another go rather than leaving a scooter half handed back.

INSTALLER_DIR="/data/installer"
SCRIPTS_DIR="$INSTALLER_DIR/scripts"
STATUS_FILE="$INSTALLER_DIR/trampoline-status"
RUN_HISTORY_DIR="$INSTALLER_DIR/history"
RUN_STATE_FILE="$INSTALLER_DIR/run-state"
HANDOVER_DIR="$INSTALLER_DIR/history/{{RUN_ID}}"
LOG="$HANDOVER_DIR/finalize.log"
SERVICE_WAIT_SECONDS=30
REBOOT_WAIT_SECONDS=60
HANDOVER_STAGE=restoring-services
CORE_SERVICES="librescoot-settings librescoot-vehicle librescoot-battery librescoot-ecu librescoot-bluetooth librescoot-keycard librescoot-ums librescoot-pm"
ADDITIONAL_SERVICES="librescoot-motion librescoot-alarm librescoot-events librescoot-modem librescoot-uplink librescoot-trip librescoot-data-server librescoot-lsd librescoot-update"

MDB_ACTION="{{MDB_ACTION}}"
FINISH_LANGUAGE="{{FINISH_LANGUAGE}}"
FINISH_CHANNEL="{{FINISH_CHANNEL}}"
RUN_ID="{{RUN_ID}}"
MODE="{{MODE}}"
DBC_VERSION="{{DBC_VERSION}}"
DBC_ACTION="{{DBC_ACTION}}"
RELEASE_TAG="{{RELEASE_TAG}}"
TILES_REGION="{{TILES_REGION}}"
DASHBOARD_RESULT="{{DASHBOARD_RESULT}}"
PRESERVE_SETTINGS="{{PRESERVE_SETTINGS}}"

log() {
  mkdir -p "$(dirname "$LOG")" 2>/dev/null
  echo "$(date "+%H:%M:%S") $*" >> "$LOG" 2>/dev/null
}

# Absent means the laptop is running this, and the laptop only gets here on a
# run that worked. Present means the trampoline wrote a verdict, and a verdict
# that is not "success" is one this must not paper over: the settings still go
# back and service mode still ends, but nothing here claims the install worked.
INSTALL_OK=yes
if [ -f "$STATUS_FILE" ]; then
  case "$(head -n1 "$STATUS_FILE" 2>/dev/null)" in
    success*) INSTALL_OK=yes ;;
    *)
      INSTALL_OK=no
      # Retry only this finalizer's restoration failures, never artifact errors.
      if grep -Fxq "run-id: $RUN_ID" "$STATUS_FILE" &&
         grep -Eq '^stage: (restoring-services|waiting-mdb-reboot)$' "$STATUS_FILE"; then
        INSTALL_OK=yes
      fi
      ;;
  esac
fi

# "Finish without completed DBC" is an explicit degraded handover, not a
# successful dashboard install. Archive the DBC error, then allow finalization
# to write a typed incomplete record. MDB boot/rollback checks below can still
# make the whole handover fatal.
if [ "$DASHBOARD_RESULT" = incomplete ] && [ "$INSTALL_OK" = no ]; then
  STATUS_STAGE=$(sed -n 's/^stage: //p' "$STATUS_FILE" 2>/dev/null | head -n 1)
  case "$STATUS_STAGE" in
    *DBC*|*dbc*)
      mkdir -p "$RUN_HISTORY_DIR/$RUN_ID"
      cp "$STATUS_FILE" "$RUN_HISTORY_DIR/$RUN_ID/dbc-incomplete-status" 2>/dev/null || true
      INSTALL_OK=yes
      log "  archived the DBC failure and continuing an explicitly incomplete handover"
      ;;
  esac
fi

# u-boot rolls back a rootfs that does not commit, and the sweep has already
# taken the status file, so absence would read as success and unlock a board
# whose install never survived its first boot. os-release cannot lag, and only
# the bootstrap images set IMAGE_ID.
RUNNING_IMAGE_ID="$(sed -n 's/^IMAGE_ID=//p' "${OS_RELEASE:-/etc/os-release}" 2>/dev/null | tr -d '"')"
FAILURE_REASON=""
case "$RUNNING_IMAGE_ID" in
  *-bootstrap)
    FAILURE_REASON="the MDB is still running the bootstrap image"
    log "  running $RUNNING_IMAGE_ID: the install did not survive its first boot"
    INSTALL_OK=no
    ;;
esac

# 80-reboot.sh records the slot it reboots away from. Coming back up on that
# same slot means u-boot rolled the installed image back, and unlike the
# bootstrap case the rolled-back board is a full image os-release cannot
# distinguish from a successful one. The slot can. Left in place on a
# mismatch: a rollback does not heal on later boots, and every retry of this
# phase must reach the same verdict.
PREVIOUS_ROOT_FILE="$INSTALLER_DIR/previous-root"
if [ -f "$PREVIOUS_ROOT_FILE" ]; then
  BOOTED_ROOT="$(sed -n 's/.*root=\([^ ]*\).*/\1/p' "${CMDLINE:-/proc/cmdline}")"
  if [ -n "$BOOTED_ROOT" ] && [ "$BOOTED_ROOT" = "$(head -n1 "$PREVIOUS_ROOT_FILE" 2>/dev/null)" ]; then
    log "  still on $BOOTED_ROOT: u-boot rolled the installed image back"
    printf 'error: the installed image failed to boot and was rolled back\nrun-id: %s\nfinish: pending\n' "$RUN_ID" > "$STATUS_FILE"
    INSTALL_OK=no
  else
    rm -f "$PREVIOUS_ROOT_FILE"
  fi
fi
log "finalize starting (install_ok=$INSTALL_OK dashboard_result=$DASHBOARD_RESULT action=$MDB_ACTION)"

# Segment 4, the handover: settings back, service mode ended, the unlock. The
# coordinator lights it before the reboot it performs, so on a run that
# rebooted this is a no-op and the bar was already saying this from the moment
# the vehicle came back up. On one that did not reboot, this is what lights it.
. "$SCRIPTS_DIR/signal.sh" || { echo "missing $SCRIPTS_DIR/signal.sh" >&2; exit 1; }
. "$SCRIPTS_DIR/device.sh" || { echo "missing $SCRIPTS_DIR/device.sh" >&2; exit 1; }
signal_install_start
progress_set "$SEGMENT_HANDOVER" active

capture_handover_diagnostics() {
  {
    printf 'boot-id: '; cat /proc/sys/kernel/random/boot_id
    for unit in $CORE_SERVICES $ADDITIONAL_SERVICES; do
      systemctl show -p Id -p LoadState -p ActiveState -p SubState -p Result -p MainPID -p NRestarts -p ConditionResult "$unit" 2>&1
    done
    for key in battery:0 battery:1; do
      printf '\n%s (presence, state, charge, sample time, sample validity):\n' "$key"
      redis-cli -h localhost --raw hmget "$key" present state charge sample:timestamp sample:valid 2>&1
    done
    printf '\nOTA states (MDB, DBC, MDB boot, DBC boot):\n'
    redis-cli -h localhost --raw hmget ota status:mdb status:dbc status:mdb-boot status:dbc-boot 2>&1
    journalctl -b --no-pager -n 200 -u librescoot-battery -u librescoot-vehicle -u librescoot-pm -u librescoot-settings -u librescoot-bluetooth 2>&1
    printf '\nPower-management and update journal:\n'
    journalctl -b --no-pager -n 100 -u librescoot-pm -u librescoot-update 2>&1
  } > "${1:-$HANDOVER_DIR/handover-diagnostics.log}" 2>&1
}

handover_failed() {
  log "ERROR: $*"
  mkdir -p "$HANDOVER_DIR"
  failure_stage="$HANDOVER_STAGE"
  [ "$INSTALL_OK" = yes ] || failure_stage=finalization-failed
  {
    printf 'error: %s\nrun-id: %s\nfinish: pending\nstage: %s\n' "$*" "$RUN_ID" "$failure_stage"
  } > "$STATUS_FILE.tmp" && mv -f "$STATUS_FILE.tmp" "$STATUS_FILE"
  {
    printf 'run-id: %s\nactor: finalize\nstage: %s\nresult: error\nfinish: pending\n' "$RUN_ID" "$failure_stage"
  } > "$RUN_STATE_FILE.tmp" && mv -f "$RUN_STATE_FILE.tmp" "$RUN_STATE_FILE"
  for record in "$HANDOVER_DIR/record" "$INSTALLER_DIR/last-install"; do
    if [ -f "$record" ] && grep -Fxq "run-id: $RUN_ID" "$record"; then
      rm -f "$record"
    fi
  done
  capture_handover_diagnostics
  signal_error
  sync
  # A failed handover still needs power management. Record the failure before
  # starting PM, which may execute a pending reboot. Keep the retry queued.
  device_timeout 45 systemctl start librescoot-pm 2>/dev/null || log "WARNING: PM restoration failed"
  exit 1
}

require_service() {
  unit="$1"; action="$2"
  [ "$(systemctl show -p LoadState --value "$unit" 2>/dev/null)" = loaded ] ||
    handover_failed "$unit is missing or masked"
  device_timeout 45 systemctl "$action" "$unit" 2>/dev/null || handover_failed "could not $action $unit"
  # Uplink is enabled in the image but its unit requires an owner-supplied
  # configuration. Only this expected skip is exempt from readiness checks.
  if [ "$unit" = librescoot-uplink ] &&
     [ ! -e /data/uplink-service/uplink.yaml ] &&
     [ "$(systemctl show -p ConditionResult --value "$unit" 2>/dev/null)" = no ] &&
     [ "$(systemctl show -p ActiveState --value "$unit" 2>/dev/null)" = inactive ] &&
     [ "$(systemctl show -p SubState --value "$unit" 2>/dev/null)" = dead ] &&
     [ "$(systemctl show -p Result --value "$unit" 2>/dev/null)" = success ]; then
    log "  uplink is not configured; systemd skipped it"
    return 0
  fi
  waited=0; stable=0; previous_pid=""
  while [ "$waited" -lt "$SERVICE_WAIT_SECONDS" ]; do
    if [ "$(systemctl show -p ActiveState --value "$unit" 2>/dev/null)" = active ] &&
       [ "$(systemctl show -p SubState --value "$unit" 2>/dev/null)" = running ] &&
       [ "$(systemctl show -p ConditionResult --value "$unit" 2>/dev/null)" = yes ]; then
      pid=$(systemctl show -p MainPID --value "$unit" 2>/dev/null)
      case "$pid" in ''|0|*[!0-9]*) stable=0 ;; *)
        if [ "$pid" = "$previous_pid" ]; then stable=$((stable + 1)); else stable=1; fi
        previous_pid="$pid"
        [ "$stable" -ge 2 ] && return 0
        ;;
      esac
    else
      stable=0
    fi
    sleep 1
    waited=$((waited + 1))
  done
  handover_failed "$unit did not become ready"
}

if [ ! -f "$HANDOVER_DIR/handover-before.log" ]; then
  capture_handover_diagnostics "$HANDOVER_DIR/handover-before.log"
fi

# ---- settings -------------------------------------------------------------
# An upgrade promised to keep the user's settings, so the pre-install copy goes
# back. A clean/full-image installation keeps a host-restored settings file only
# when the user selected that category. Leave keeps /data exactly as upgrade
# does, and both had their settings parked at connect, so both take the same arm.
# A PM-triggered reboot can return after the backup was consumed. Do not
# replace restored settings with defaults on that second pass.
if [ ! -f "$HANDOVER_DIR/settings-restored" ]; then
case "$MDB_ACTION:$PRESERVE_SETTINGS" in
  upgrade:*|leave:*)
    if [ -f /data/settings.toml.preinstall ]; then
      cp -f /data/settings.toml.preinstall /data/settings.toml.restore &&
        mv -f /data/settings.toml.restore /data/settings.toml || handover_failed "could not restore settings backup"
      log "  restored the pre-install settings"
    elif [ -f /data/settings.toml.default ]; then
      cp -f /data/settings.toml.default /data/settings.toml || handover_failed "could not restore settings snapshot"
      log "  no backup, restored the first-install snapshot"
    elif [ "$(redis-cli -h localhost --raw hget settings dashboard.service-mode-active 2>/dev/null)" = true ]; then
      # Both keys are overlaid while service mode is live, and writing anything
      # other than the overlay's own value to an overlaid key tells
      # settings-service the owner changed it. It would hand back 900 and true
      # on the clear below, over whatever was actually configured. The clear
      # already restores what it captured.
      log "  no backup, leaving the parked keys to the service-mode clear"
    else
      lsc set scooter.auto-standby-seconds 900 >/dev/null 2>&1 || true
      lsc set alarm.enabled true >/dev/null 2>&1 || true
      log "  no backup found, reset the two parked keys to defaults"
    fi
    ;;
  cleanInstall:yes|fullImage:yes)
    rm -f /data/settings.toml.preinstall
    log "  kept host-restored settings"
    ;;
  *)
    rm -f /data/settings.toml /data/settings.toml.preinstall
    log "  wiped settings (action=$MDB_ACTION erased /data anyway)"
    ;;
esac
mkdir -p "$HANDOVER_DIR"
touch "$HANDOVER_DIR/settings-restored" || handover_failed "could not record settings restoration"
sync
rm -f /data/settings.toml.preinstall
fi
require_service librescoot-settings restart

# The owner's choices go on top of the restore, never under it.
if [ "$INSTALL_OK" = yes ]; then
  [ -n "$FINISH_LANGUAGE" ] && {
    lsc set dashboard.language "$FINISH_LANGUAGE" >/dev/null 2>&1 &&
      log "  dashboard.language=$FINISH_LANGUAGE" ||
      log "  WARNING: could not persist dashboard.language"
  }
  [ -n "$FINISH_CHANNEL" ] && {
    lsc ota channel "$FINISH_CHANNEL" >/dev/null 2>&1 &&
      log "  ota channel=$FINISH_CHANNEL" ||
      log "  WARNING: could not persist the OTA channel"
  }
fi

# ---- service mode ---------------------------------------------------------
# Clearing the overlay may close the laptop's USB link. The detached finalizer
# must verify cleanup itself before recording success. Earlier failures keep
# the overlay and the phase queued so the board remains reachable for recovery.
end_service_mode() {
  # Ended before the policy is restored, not after. clear:service is consumed
  # off a list, and until it lands settings-service re-asserts the overlay over
  # any other write to an overlaid key, so a policy write that jumped the queue
  # would pin always-on for the rest of the boot. An image without the overlay
  # has no status field, so the loop ends on its first pass and this costs it
  # nothing.
  # Keep the saved overlay until the clear is observed.
  redis-cli -h localhost lpush settings:overlay clear:service >/dev/null 2>&1 ||
    handover_failed "could not request service-mode cleanup"
  i=0
  while [ $i -lt 15 ]; do
    service_mode=$(redis-cli -h localhost --raw hget settings dashboard.service-mode-active 2>/dev/null) ||
      handover_failed "could not verify service-mode cleanup"
    case "$service_mode" in
      false|'') break ;;
      true) ;;
      *) handover_failed "unknown service-mode state: $service_mode" ;;
    esac
    i=$((i + 1))
    sleep 1
  done
  [ "$service_mode" != true ] || handover_failed "service mode did not clear"
  rm -f /data/service-mode.json || handover_failed "could not remove saved service mode"
  lsc set scooter.usb0-policy auto >/dev/null 2>&1 ||
    handover_failed "could not restore usb0-policy"
  log "  service mode ended"
}

# ---- nRF firmware ---------------------------------------------------------
# bluetooth-service flashes the nRF52 on the first boot with newer zips in
# /usr/share/nrf-fw, i.e. this one. Wait for it before unlocking so nobody
# rides off mid-flash. pm-service is still stopped and the flash holds a power
# inhibitor, so the board stays up.
#
# ble[firmware-update-status]: checking/updating/recovering = in progress,
# anything else = done. Absent = not checked yet (nothing is written until the
# nRF has reported its version, and this can run before bluetooth-service is
# up), so absent gets a grace period. Valkey does not persist, so it is never
# stale. The cap stops a hung flash from keeping the vehicle locked.
NRF_STATUS_GRACE=60
NRF_STATUS_CAP=600
wait_for_nrf_firmware() {
  i=0
  last=unread
  while [ $i -lt "$NRF_STATUS_CAP" ]; do
    status="$(redis-cli -h localhost --raw hget ble firmware-update-status 2>/dev/null)"
    if [ "$status" != "$last" ]; then
      log "  nRF firmware status: ${status:-none} (after ${i}s)"
      last="$status"
    fi
    case "$status" in
      checking|updating|recovering) ;;
      "")
        if [ $i -ge "$NRF_STATUS_GRACE" ]; then
          log "  no nRF firmware status after ${NRF_STATUS_GRACE}s, not waiting"
          return 0
        fi
        ;;
      error|failed) handover_failed "nRF firmware update failed ($status)" ;;
      *) return 0 ;;
    esac
    i=$((i + 1))
    sleep 1
  done
  handover_failed "nRF firmware still ${status} after ${NRF_STATUS_CAP}s"
}

# ---- the vehicle ----------------------------------------------------------
# Preparation masks these units. Unrelated runtime masks remain untouched.
for unit in librescoot-keycard librescoot-ums; do
  systemctl unmask "$unit" 2>/dev/null || handover_failed "could not unmask $unit"
done
require_service librescoot-bluetooth start
if [ "$INSTALL_OK" = yes ]; then
  # Before the bar completes and the LED goes dark, so the wait still looks
  # like a run in progress.
  wait_for_nrf_firmware

  # The bar is complete and the vehicle goes dark. Not green: the unlock below
  # is the success signal, and it is a clearer message than an LED the owner
  # has to find and interpret. The fade also releases the blinker channels at
  # duty 0, which is the state vehicle-service expects them in.
  progress_set "$SEGMENT_HANDOVER" done
  sleep 1
  signal_install_done
fi

# The lights are handed back before vehicle-service is restarted, never
# after. On start it reloads the PWM-LED kernel module; with the installer's
# breathe loop still holding /dev/pwm_led* open the remove fails, the insert
# goes ahead regardless, and every LED ioctl from then on, this script's and
# vehicle-service's own, sleeps in the kernel for good.
#
# Restarted with the overlay still armed, so it comes back reading always-on
# and the link survives the restart on every path. On a successful run the
# service-mode end below flips the policy to auto afterwards, and
# vehicle-service picks the change up live.
require_service librescoot-vehicle restart
for unit in librescoot-battery librescoot-ecu librescoot-keycard librescoot-ums; do
  require_service "$unit" start
done

# Restore enabled application daemons without changing user-disabled services
# or rerunning boot-only jobs. Start is a no-op for an already running daemon.
for service in $ADDITIONAL_SERVICES; do
  load=$(systemctl show -p LoadState --value "$service" 2>/dev/null)
  case "$load" in
    not-found|masked) log "  leaving $service unchanged ($load)"; continue ;;
    loaded) ;;
    *) handover_failed "could not inspect $service" ;;
  esac
  enabled=$(systemctl is-enabled "$service" 2>/dev/null)
  case "$enabled" in
    enabled|enabled-runtime) require_service "$service" start ;;
    disabled|masked|masked-runtime|static|indirect|not-found)
      log "  leaving $service unchanged ($enabled)" ;;
    *) handover_failed "could not determine whether $service is enabled" ;;
  esac
done

# PM may execute a queued boot update immediately. Keep this phase queued and
# persist pending handover first, so a reboot resumes only finalization.
if [ "$INSTALL_OK" = yes ]; then
  {
    printf 'run-id: %s\nactor: finalize\nstage: restoring-services\nresult: running\nfinish: pending\n' "$RUN_ID"
  } > "$RUN_STATE_FILE.tmp" && mv -f "$RUN_STATE_FILE.tmp" "$RUN_STATE_FILE" ||
    handover_failed "could not record pending handover"
  sync
fi
require_service librescoot-pm start
finish_boot_update() {
  boot_status=$(redis-cli -h localhost --raw hget ota status:mdb-boot 2>/dev/null) ||
    handover_failed "could not inspect the MDB boot update"
  reboot_record="$HANDOVER_DIR/boot-reboot-requested"
  case "$boot_status" in
    ''|idle|staged-noop)
      if [ -f "$reboot_record" ]; then
        [ -n "$boot_status" ] || handover_failed "MDB boot-update status is unavailable after the reboot request"
        boot_id=$(cat "${BOOT_ID_FILE:-/proc/sys/kernel/random/boot_id}" 2>/dev/null)
        [ -n "$boot_id" ] || handover_failed "could not read MDB boot identity"
        [ "$(cat "$reboot_record")" != "$boot_id" ] ||
          handover_failed "MDB reboot was requested but boot identity has not changed"
      fi
      return 0 ;;
    pending-reboot) ;;
    *) handover_failed "MDB boot update is not settled: $boot_status" ;;
  esac
  HANDOVER_STAGE=waiting-mdb-reboot
  boot_id=$(cat "${BOOT_ID_FILE:-/proc/sys/kernel/random/boot_id}" 2>/dev/null)
  [ -n "$boot_id" ] || handover_failed "could not read MDB boot identity"
  if [ -f "$reboot_record" ] && [ "$(cat "$reboot_record")" != "$boot_id" ]; then
    handover_failed "MDB rebooted but its boot update is still pending; refusing a reboot loop"
  fi
  [ ! -e /data/librescoot-installer/dbc-control/owner ] ||
    handover_failed "DBC installer ownership must be resolved before reboot"
  for component in mdb dbc dbc-boot; do
    update_status=$(redis-cli -h localhost --raw hget ota "status:$component" 2>/dev/null) ||
      handover_failed "could not inspect $component before reboot"
    case "$update_status" in
      ''|idle|staged-noop) ;;
      *) handover_failed "$component update prevents the handover reboot: $update_status" ;;
    esac
  done
  [ "$(redis-cli -h localhost --raw hget vehicle state 2>/dev/null)" = stand-by ] ||
    handover_failed "lock the scooter before retrying the pending MDB reboot"
  if [ ! -f "$reboot_record" ]; then
    # Persist before dispatch: a lost reply must not queue another reboot.
    printf '%s\n' '{"active":true,"name":"service"}' > /data/service-mode.json.tmp &&
      mv -f /data/service-mode.json.tmp /data/service-mode.json ||
      handover_failed "could not retain service mode across the handover reboot"
    printf '%s\n' "$boot_id" > "$reboot_record.tmp" &&
      mv -f "$reboot_record.tmp" "$reboot_record" ||
      handover_failed "could not record the handover reboot request"
    {
      printf 'running\nrun-id: %s\nfinish: pending\nstage: waiting-mdb-reboot\n' "$RUN_ID"
    } > "$STATUS_FILE.tmp" && mv -f "$STATUS_FILE.tmp" "$STATUS_FILE" ||
      handover_failed "could not record reboot status"
    {
      printf 'run-id: %s\nactor: finalize\nstage: waiting-mdb-reboot\nresult: running\nfinish: pending\n' "$RUN_ID"
    } > "$RUN_STATE_FILE.tmp" && mv -f "$RUN_STATE_FILE.tmp" "$RUN_STATE_FILE" ||
      handover_failed "could not record pending reboot"
    sync
    redis-cli -h localhost lpush scooter:power reboot >/dev/null 2>&1 ||
      handover_failed "MDB reboot request outcome is unknown; inspect power management before retrying"
    log "requested MDB boot-update reboot through power management; finalization remains queued"
  fi
  # PM retains control of its safety gates and inhibitors. Never force a reboot.
  waited=0
  while [ "$waited" -lt "$REBOOT_WAIT_SECONDS" ]; do
    sleep 1
    waited=$((waited + 1))
  done
  handover_failed "MDB has not rebooted; inspect power-management blockers before retrying"
}
[ "$INSTALL_OK" != yes ] || finish_boot_update
capture_handover_diagnostics
sync

if [ "$INSTALL_OK" = yes ]; then

  sleep 5
  if redis-cli -h localhost lpush scooter:state unlock >/dev/null 2>&1; then
    log "  unlock requested after service restoration"
  else
    handover_failed "could not request vehicle unlock"
  fi

  # This phase runs independently of SSH. Cleanup can close that link; retain
  # the queued phase until cleanup and the completion record both succeed.
  end_service_mode
  mkdir -p "$RUN_HISTORY_DIR/$RUN_ID"
  {
    echo "result: success"
    echo "run-id: $RUN_ID"
    echo "finish: complete"
    echo "stage: complete"
    echo "mode: $MODE"
    echo "finished: $(date -u "+%Y-%m-%dT%H:%M:%S")Z"
    echo "mdb: $(sed -n 's/^VERSION_ID=//p' "${OS_RELEASE:-/etc/os-release}" 2>/dev/null | tr -d '"')"
    echo "dbc: $DBC_VERSION"
    # What the run was asked to do, not just what it ended up with. A record
    # that says only "success" cannot answer why a scooter is on the channel
    # it is on, or which region its maps came from.
    echo "release: $RELEASE_TAG"
    echo "action-mdb: $MDB_ACTION"
    echo "action-dbc: $DBC_ACTION"
    echo "language: $FINISH_LANGUAGE"
    echo "channel: $FINISH_CHANNEL"
    echo "region: $TILES_REGION"
    echo "dashboard-result: $DASHBOARD_RESULT"
    echo "services: verified"
  } > "$RUN_HISTORY_DIR/$RUN_ID/.record.tmp" || handover_failed "could not write the completion record"
  mv -f "$RUN_HISTORY_DIR/$RUN_ID/.record.tmp" "$RUN_HISTORY_DIR/$RUN_ID/record" &&
    cp "$RUN_HISTORY_DIR/$RUN_ID/record" "$INSTALLER_DIR/.last-install.tmp" &&
    mv -f "$INSTALLER_DIR/.last-install.tmp" "$INSTALLER_DIR/last-install" &&
    cp "$RUN_HISTORY_DIR/$RUN_ID/record" "$RUN_STATE_FILE.tmp" &&
    mv -f "$RUN_STATE_FILE.tmp" "$RUN_STATE_FILE" ||
    handover_failed "could not persist the completion record"
  {
    printf 'success\nrun-id: %s\nfinish: complete\nstage: complete\n' "$RUN_ID"
  } > "$STATUS_FILE.tmp" && mv -f "$STATUS_FILE.tmp" "$STATUS_FILE" ||
    handover_failed "could not persist completion status"
  sync
  log "  wrote the completion record for run $RUN_ID"
else
  # Red and the hazards, and the bar goes: it was describing a run that is not
  # going to finish. Both stop when the installer reconnects.
  signal_error
  log "  install did not succeed; left reachable for a retry, not unlocking"
  log "  keeping service mode and usb0 up so the install can be retried"

  # Finalization has reached a verdict even though the phase remains queued for
  # recovery on a later boot. Publish that verdict atomically: otherwise the
  # reconnecting installer sees the stale `result: running` state forever and
  # keeps asking for a status that will never arrive.
  if ! grep -q '^error' "$STATUS_FILE" 2>/dev/null; then
    {
      printf 'error: %s\n' "${FAILURE_REASON:-on-device finalization failed}"
      printf 'run-id: %s\n' "$RUN_ID"
      printf 'finish: pending\n'
      printf 'stage: finalization-failed\n'
    } > "$STATUS_FILE.tmp" && mv -f "$STATUS_FILE.tmp" "$STATUS_FILE"
  fi
  {
    printf 'run-id: %s\n' "$RUN_ID"
    printf 'actor: finalize\n'
    printf 'stage: finalization-failed\n'
    printf 'result: error\n'
    printf 'finish: pending\n'
    printf 'updated: %s\n' "$(date -u "+%Y-%m-%dT%H:%M:%S")Z"
  } > "$RUN_STATE_FILE.tmp" && mv -f "$RUN_STATE_FILE.tmp" "$RUN_STATE_FILE"
fi

sync
# A decline is a verdict on this attempt, not the install. Removing itself
# here left the boot that finally succeeded with no handover: new image,
# locked, service mode, indefinitely. The coordinator drops it after three.
if [ "$INSTALL_OK" = yes ]; then
  rm -f "$0" "$0.tries"
else
  log "  staying queued so the next boot can hand the vehicle back"
fi
sync

log "finalize done"
exit 0

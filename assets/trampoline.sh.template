#!/bin/sh
# Librescoot DBC Trampoline Script
# Generated by installer — runs autonomously on MDB

INSTALLER_DIR="/data/installer"
STATUS_FILE="$INSTALLER_DIR/trampoline-status"
LOG_FILE="$INSTALLER_DIR/trampoline.log"
PHASE_FILE="$INSTALLER_DIR/trampoline-phase"
DBC_IMAGE="{{DBC_IMAGE_PATH}}"
DBC_BMAP="${DBC_IMAGE%.sdimg.gz}.sdimg.bmap"
DBC_IP="192.168.7.2"
BOOT_AREA_BLOCKS=6
INSTALL_TILES="{{INSTALL_TILES}}"
OSM_TILES_FILE="{{OSM_TILES_FILE}}"
VALHALLA_TILES_FILE="{{VALHALLA_TILES_FILE}}"

mkdir -p "$INSTALLER_DIR"

log() { echo "$(date '+%H:%M:%S') $1" >> "$LOG_FILE"; }

# Per-step elapsed-time bookkeeping. SCRIPT_T0 is the wall-clock start;
# step_begin/step_end log "<label> took Ns" so post-mortem time accounting
# is one grep away. SECONDS resets per-step.
SCRIPT_T0=$(date +%s)
STEP_LABEL=""
STEP_T0=0
step_begin() {
  STEP_LABEL="$1"
  STEP_T0=$(date +%s)
  log ">>> $STEP_LABEL (T+$((STEP_T0 - SCRIPT_T0))s)"
}
step_end() {
  local now=$(date +%s)
  [ -n "$STEP_LABEL" ] && log "<<< $STEP_LABEL took $((now - STEP_T0))s"
  STEP_LABEL=""
}

# --- Boot LED (LP5562 i2c bus 2 addr 0x30) ---
bootled_init() {
  i2cset -f -y 2 0x30 0x0D 0xFF
  i2cset -f -y 2 0x30 0x01 0x3F
  i2cset -f -y 2 0x30 0x70 0x00
  i2cset -f -y 2 0x30 0x08 0x61
  i2cset -f -y 2 0x30 0x00 0xC0
  i2cset -f -y 2 0x30 0x05 0xAF
  i2cset -f -y 2 0x30 0x06 0xAF
  i2cset -f -y 2 0x30 0x07 0xAF
} 2>/dev/null

bootled() {
  case "$1" in
    amber) i2cset -f -y 2 0x30 0x02 0xFF; i2cset -f -y 2 0x30 0x03 0x00; i2cset -f -y 2 0x30 0x04 0x00 ;;
    green) i2cset -f -y 2 0x30 0x02 0x00; i2cset -f -y 2 0x30 0x03 0xFF; i2cset -f -y 2 0x30 0x04 0x00 ;;
    red)   i2cset -f -y 2 0x30 0x02 0x00; i2cset -f -y 2 0x30 0x03 0x00; i2cset -f -y 2 0x30 0x04 0xFF ;;
    off)   i2cset -f -y 2 0x30 0x02 0x00; i2cset -f -y 2 0x30 0x03 0x00; i2cset -f -y 2 0x30 0x04 0x00 ;;
  esac
} 2>/dev/null

# Blink the boot LED red/green for failure/success indication. Spawned via
# systemd-run so the loop ends up in its own transient unit under
# system.slice — independent of whatever cgroup launched us. setsid alone
# isn't enough: when this script runs from a Type=oneshot service (e.g.
# onboot.sh under librescoot-onboot.service), default KillMode=control-group
# kills every descendant when the script exits, leaving the LED stuck on
# whatever was last written. Stopped via `systemctl stop`.
BOOTLED_BLINK_UNIT="librescoot-bootled-blink"
bootled_blink_red() {
  bootled_blink_stop
  systemd-run --unit="$BOOTLED_BLINK_UNIT" --collect --quiet --slice=system.slice /bin/sh -c '
    while true; do
      i2cset -f -y 2 0x30 0x02 0x00 2>/dev/null
      i2cset -f -y 2 0x30 0x03 0x00 2>/dev/null
      i2cset -f -y 2 0x30 0x04 0xFF 2>/dev/null
      sleep 0.4
      i2cset -f -y 2 0x30 0x02 0x00 2>/dev/null
      i2cset -f -y 2 0x30 0x03 0x00 2>/dev/null
      i2cset -f -y 2 0x30 0x04 0x00 2>/dev/null
      sleep 0.4
    done
  '
}
bootled_blink_green() {
  bootled_blink_stop
  systemd-run --unit="$BOOTLED_BLINK_UNIT" --collect --quiet --slice=system.slice /bin/sh -c '
    while true; do
      i2cset -f -y 2 0x30 0x02 0x00 2>/dev/null
      i2cset -f -y 2 0x30 0x03 0xFF 2>/dev/null
      i2cset -f -y 2 0x30 0x04 0x00 2>/dev/null
      sleep 0.4
      i2cset -f -y 2 0x30 0x02 0x00 2>/dev/null
      i2cset -f -y 2 0x30 0x03 0x00 2>/dev/null
      i2cset -f -y 2 0x30 0x04 0x00 2>/dev/null
      sleep 0.4
    done
  '
}
bootled_blink_stop() {
  systemctl stop "${BOOTLED_BLINK_UNIT}.service" 2>/dev/null
  # Best-effort cleanup of any leftover PID-file blink loop from older
  # builds, in case stop-error-signals.sh wasn't updated alongside us.
  if [ -f /data/bootled-blink.pid ]; then
    pid="$(cat /data/bootled-blink.pid 2>/dev/null)"
    if [ -n "$pid" ]; then
      kill -- -"$pid" 2>/dev/null
      kill "$pid" 2>/dev/null
    fi
    rm -f /data/bootled-blink.pid
  fi
}

# --- PWM LED control via ioctl ---
# Channels: 0=headlight 1=front_ring 2=brake 3=FL 4=FR 5=plates 6=RL 7=RR
IOCTL=/usr/bin/ioctl
led_activate()   { $IOCTL /dev/pwm_led$1 0x00007549 -v 1 2>/dev/null; }
led_deactivate() { $IOCTL /dev/pwm_led$1 0x00007549 -v 0 2>/dev/null; }
led_duty()       { $IOCTL /dev/pwm_led$1 0x0000754A -v $2 2>/dev/null; }
led_fade()       { $IOCTL /dev/pwm_led$1 0x00007545 -v $2 2>/dev/null; }
led_off()        { led_duty $1 0; led_deactivate $1; }

# --- Front ring breathing (prep phase indicator) ---
BREATHE_PID=""
breathe_start() {
  local ch=$1
  led_activate $ch
  (while true; do
    led_fade $ch 0  # fade0: parking-smooth-on (3s)
    sleep 3
    led_fade $ch 1  # fade1: smooth-off (2.3s)
    sleep 3
  done) &
  BREATHE_PID=$!
}
breathe_stop() {
  [ -n "$BREATHE_PID" ] && kill $BREATHE_PID 2>/dev/null; BREATHE_PID=""
}

# --- Blinker progress bar (4 blinkers = 4 phases) ---
# Order: FL(3) -> FR(4) -> RR(7) -> RL(6)
# Phase semantics: each segment represents one overall trampoline phase.
#   phase 0 = entering Prep        (FL breathing)
#   phase 1 = Prep done, Flash     (FL filled, FR breathing)
#   phase 2 = Flash done, 1st-boot (FL/FR filled, RR breathing)
#   phase 3 = 1st-boot done, Tiles (FL/FR/RR filled, RL breathing)
#   phase 4 = all done             (all four solid dim)
# The phase number is persisted to $PHASE_FILE so onboot.sh can re-light
# the right segments after the MDB reboot between Flash and 1st-boot.
# Filled segments: static dim glow (DIM_DUTY). Active segment: breathing on
# fade4/fade9 (brake-dim-on/off, duty ~48..180 of 12000) so it stays
# distinguishable from filled. DIM_DUTY sits just under fade4's peak (156)
# so the breathing segment reads brighter at its peak than the filled trail.
BLINKER_LEDS="3 7 4 6"
DIM_DUTY=150
PROGRESS_BREATHE_PID=""
PROGRESS_LAST_PHASE=-1

# Light the segments for a given phase (0-4). Idempotent.
set_progress_phase() {
  local phase="$1"
  [ "$phase" -lt 0 ] && phase=0
  [ "$phase" -gt 4 ] && phase=4

  echo "$phase" > "$PHASE_FILE" 2>/dev/null

  [ "$phase" -eq "$PROGRESS_LAST_PHASE" ] && return
  PROGRESS_LAST_PHASE=$phase

  [ -n "$PROGRESS_BREATHE_PID" ] && kill $PROGRESS_BREATHE_PID 2>/dev/null; PROGRESS_BREATHE_PID=""

  local i=0
  for l in $BLINKER_LEDS; do
    if [ $i -lt $phase ]; then
      led_activate $l
      led_duty $l $DIM_DUTY
    elif [ $i -eq $phase ] && [ $phase -lt 4 ]; then
      led_activate $l
      (while true; do
        led_fade $l 4; sleep 3
        led_fade $l 9; sleep 3
      done) &
      PROGRESS_BREATHE_PID=$!
    else
      led_off $l
    fi
    i=$((i + 1))
  done
}

signal_progress_off() {
  [ -n "$PROGRESS_BREATHE_PID" ] && kill $PROGRESS_BREATHE_PID 2>/dev/null; PROGRESS_BREATHE_PID=""
  for l in $BLINKER_LEDS; do led_off $l; done
  rm -f "$PHASE_FILE"
  PROGRESS_LAST_PHASE=-1
}

# --- DBC boot-LED defender ---
# vehicle-service also drives the LP5562 (i2c-2 @ 0x30) for blinker
# brightness via VehicleSystem.runBlinker (vehicle-service: dbc_led.go +
# core/system.go:runBlinker). If anything fires a blinker (handlebar
# switch, alarm hazards, etc.) while the trampoline runs, that loop
# stomps the amber we set with random brightness/colour.
#
# We can't mask vehicle-service — we need it to handle `dashboard:on/off`
# for the DBC power dance. So instead: a tiny background loop that
# re-asserts amber every 2s. Cheap insurance against any LED stomp from
# vehicle-service, app-triggered blinkers, or anything else that touches
# the LP5562. Spawned via systemd-run so it survives this script exiting
# (KillMode=control-group on librescoot-onboot.service would otherwise
# clip it). Stopped via `systemctl stop`.
BOOTLED_GUARD_UNIT="librescoot-bootled-guard"
bootled_guard_start() {
  systemctl stop "${BOOTLED_GUARD_UNIT}.service" 2>/dev/null
  systemd-run --unit="$BOOTLED_GUARD_UNIT" --collect --quiet --slice=system.slice /bin/sh -c '
    while true; do
      i2cset -f -y 2 0x30 0x02 0xFF 2>/dev/null
      i2cset -f -y 2 0x30 0x03 0x00 2>/dev/null
      i2cset -f -y 2 0x30 0x04 0x00 2>/dev/null
      sleep 2
    done
  '
}
bootled_guard_stop() {
  systemctl stop "${BOOTLED_GUARD_UNIT}.service" 2>/dev/null
}

# Hazards (all four blinkers — FL=3, FR=4, RL=6, RR=7) flashing in unison
# is the universal "vehicle in trouble" signal — much more visible than
# the brake light alone, especially since the user might not be at the
# dash when the flash dies. Spawned via systemd-run for the same reason
# as bootled_blink_*: setsid alone doesn't escape the parent service's
# cgroup. Capped at 30s so an abandoned error doesn't drain the battery,
# and stopped early by the installer when it reconnects.
HAZARDS_UNIT="librescoot-bootled-hazards"
signal_error() {
  breathe_stop
  signal_progress_off
  bootled_guard_stop
  signal_error_stop
  systemd-run --unit="$HAZARDS_UNIT" --collect --quiet --slice=system.slice /bin/sh -c '
    DIM=2000
    for ch in 3 4 6 7; do
      /usr/bin/ioctl /dev/pwm_led$ch 0x00007549 -v 1 2>/dev/null
    done
    end=$(( $(date +%s) + 30 ))
    while [ "$(date +%s)" -lt "$end" ]; do
      for ch in 3 4 6 7; do
        /usr/bin/ioctl /dev/pwm_led$ch 0x0000754A -v $DIM 2>/dev/null
      done
      sleep 0.5
      for ch in 3 4 6 7; do
        /usr/bin/ioctl /dev/pwm_led$ch 0x0000754A -v 0 2>/dev/null
      done
      sleep 0.5
    done
    for ch in 3 4 6 7; do
      /usr/bin/ioctl /dev/pwm_led$ch 0x00007549 -v 0 2>/dev/null
    done
  '
}
signal_error_stop() {
  systemctl stop "${HAZARDS_UNIT}.service" 2>/dev/null
  [ -f /data/error-hazards.pid ] && kill "$(cat /data/error-hazards.pid)" 2>/dev/null
  rm -f /data/error-hazards.pid
  for ch in 3 4 6 7; do
    /usr/bin/ioctl /dev/pwm_led$ch 0x0000754A -v 0 2>/dev/null
    /usr/bin/ioctl /dev/pwm_led$ch 0x00007549 -v 0 2>/dev/null
  done
}

# Chipidea role writes can also BLOCK (not just EBUSY) if the unbind
# wedges on a dying USB device. A blocked write would freeze whoever
# called it, so give every role write a hard 15s ceiling where a timeout
# binary exists (busybox >= 1.30 and coreutils both take SECS PROG).
ROLE_PATH=/sys/kernel/debug/ci_hdrc.0/role
role_write() {
  if command -v timeout >/dev/null 2>&1; then
    timeout 15 sh -c "echo $1 > $ROLE_PATH" 2>/dev/null
  else
    sh -c "echo $1 > $ROLE_PATH" 2>/dev/null
  fi
}

# Restore USB gadget (RNDIS) mode so the installer can reach us again.
# The chipidea role write can fail (EBUSY) while a device still occupies
# the host port, and the old single-shot version silenced that, leaving
# the MDB stuck in host mode with the laptop unable to see it. So:
# verify the role actually flipped and usb0 came up, retrying a few
# times. Returns 0 only on confirmed gadget mode.
restore_gadget() {
  log "Restoring gadget mode..."
  if [ "$(cat /sys/kernel/debug/ci_hdrc.0/role 2>/dev/null)" = "gadget" ] \
      && ifconfig usb0 2>/dev/null | grep -q '192\.168\.7\.1'; then
    log "  already in gadget mode with usb0 up"
    return 0
  fi
  local attempt=0
  while [ $attempt -lt 5 ]; do
    attempt=$((attempt + 1))
    rmmod g_ether 2>/dev/null || true
    sleep 1
    role_write gadget || true
    sleep 1
    modprobe g_ether 2>/dev/null || true
    sleep 1
    ifconfig usb0 192.168.7.1 netmask 255.255.255.0 up 2>/dev/null || true
    sleep 1
    local role="$(cat /sys/kernel/debug/ci_hdrc.0/role 2>/dev/null)"
    if [ "$role" = "gadget" ] && ifconfig usb0 2>/dev/null | grep -q '192\.168\.7\.1'; then
      log "  gadget restored (attempt $attempt), UDC: $(cat /sys/class/udc/ci_hdrc.0/state 2>/dev/null)"
      return 0
    fi
    log "  gadget restore attempt $attempt failed (role=$role), retrying..."
    sleep 2
  done
  log "  gadget restore FAILED after $attempt attempts"
  return 1
}

# Detached gadget-mode rescue, spawned from fail() when restore_gadget()
# could not confirm gadget mode. Keeps re-attempting the role flip; the
# write that fails while the DBC still occupies the host port succeeds
# once the user swaps the cable. Once gadget mode + usb0 are up it only
# watches, exiting when the laptop enumerates us. If gadget mode still
# can't be established after 240s, it reboots the MDB: a normal boot
# always comes back in gadget mode, so the reboot is guaranteed recovery.
# Before rebooting it installs rescue-onboot.sh as /data/onboot.sh so the
# red error blink comes back right after boot; the installer reads the
# status file as soon as it reconnects, so the error surfaces either way.
# systemd-run for the same cgroup-survival reason as the LED units;
# stop-error-signals.sh stops it if it's still around on reconnect.
GADGET_RESCUE_UNIT="librescoot-gadget-rescue"
gadget_rescue_start() {
  systemctl stop "${GADGET_RESCUE_UNIT}.service" 2>/dev/null
  systemd-run --unit="$GADGET_RESCUE_UNIT" --collect --quiet --slice=system.slice /bin/sh -c '
    LOG=/data/installer/trampoline.log
    DEADLINE=$(( $(date +%s) + 240 ))
    while :; do
      ROLE="$(cat /sys/kernel/debug/ci_hdrc.0/role 2>/dev/null)"
      if [ "$ROLE" = "gadget" ] && ifconfig usb0 2>/dev/null | grep -q "192\.168\.7\.1"; then
        if cat /sys/class/udc/ci_hdrc.0/state 2>/dev/null | grep -q configured; then
          echo "$(date "+%H:%M:%S") gadget-rescue: laptop enumerated, done" >> "$LOG"
          exit 0
        fi
        sleep 2
      else
        echo "$(date "+%H:%M:%S") gadget-rescue: role=$ROLE, retrying gadget restore" >> "$LOG"
        rmmod g_ether 2>/dev/null
        sleep 1
        if command -v timeout >/dev/null 2>&1; then
          timeout 15 sh -c "echo gadget > /sys/kernel/debug/ci_hdrc.0/role" 2>/dev/null
        else
          echo gadget > /sys/kernel/debug/ci_hdrc.0/role 2>/dev/null
        fi
        sleep 1
        modprobe g_ether 2>/dev/null
        sleep 1
        ifconfig usb0 192.168.7.1 netmask 255.255.255.0 up 2>/dev/null
        sleep 2
      fi
      if [ "$(date +%s)" -ge "$DEADLINE" ]; then
        ROLE="$(cat /sys/kernel/debug/ci_hdrc.0/role 2>/dev/null)"
        if [ "$ROLE" = "gadget" ]; then
          echo "$(date "+%H:%M:%S") gadget-rescue: gadget up, laptop never enumerated, leaving as-is" >> "$LOG"
          exit 0
        fi
        echo "$(date "+%H:%M:%S") gadget-rescue: gadget mode unrecoverable after 240s, rebooting MDB" >> "$LOG"
        if [ -f /data/onboot.sh ]; then
          cp /data/onboot.sh /data/installer/onboot.sh.rescue-bak
        fi
        cp /data/installer/rescue-onboot.sh /data/onboot.sh
        chmod +x /data/onboot.sh
        sync &
        sleep 10
        reboot &
        sleep 30
        reboot -f
        exit 0
      fi
    done
  '
}

# Last-ditch watchdog for a trampoline that dies in host mode WITHOUT
# reaching fail(): OOM kill, script bug, or (most likely) the flasher
# stuck in uninterruptible sleep on a USB device that died mid-write.
# The trampoline logs constantly, so the log mtime is a free heartbeat:
# if the role is still host and the log has been silent for 15 minutes,
# the install is dead and nobody is coming to restore gadget mode.
# 15 min is sized for the slowest legitimate quiet stretch (the dd
# fallback flasher only writes to the log when it finishes). Recovery
# itself lives in the staged watchdog-recover.sh; this unit only
# detects the stall. Armed once at trampoline start (it never fires
# while the role is gadget), gone on any reboot, stopped explicitly in
# fail() so it can't race the gadget-rescue unit.
TRAMPOLINE_WATCHDOG_UNIT="librescoot-trampoline-watchdog"
trampoline_watchdog_start() {
  systemctl stop "${TRAMPOLINE_WATCHDOG_UNIT}.service" 2>/dev/null
  systemd-run --unit="$TRAMPOLINE_WATCHDOG_UNIT" --collect --quiet --slice=system.slice /bin/sh -c '
    while :; do
      sleep 60
      [ "$(cat /sys/kernel/debug/ci_hdrc.0/role 2>/dev/null)" = "host" ] || continue
      [ -n "$(find /data/installer/trampoline.log -mmin +15 2>/dev/null)" ] || continue
      /bin/sh /data/installer/watchdog-recover.sh
      exit 0
    done
  '
}
trampoline_watchdog_stop() {
  systemctl stop "${TRAMPOLINE_WATCHDOG_UNIT}.service" 2>/dev/null
}

# "Did the user yank the DBC cable and replace it with the laptop?"
# probe. We can't passively detect VBUS / PHY-connect from userspace on
# this i.MX6 driver, so we briefly flip to gadget mode and check the
# UDC state: if a laptop is on the other end it'll enumerate us and the
# UDC reaches "configured" within ~2 s. If yes → fail() with a clear
# disconnect message (fail() leaves us in gadget so the installer's
# RNDIS waiter picks the device up and reads the status). If no →
# switch back to host.
#
# SAFETY: this is disruptive — switching to gadget while DBC is mid-
# reboot from Linux back into u-boot UMS races the enumeration and can
# cost us the install. ONLY call this when we've otherwise given up
# (step 6 final timeout / step 7 retry exhaustion). Never on a periodic
# tick inside an active wait. Total wall-clock cost per call: ~8 s.
probe_for_laptop_then_restore_host() {
  log "  probing gadget mode for laptop reconnect..."
  rmmod g_ether 2>/dev/null || true
  sleep 1
  role_write gadget || true
  modprobe g_ether 2>/dev/null || true
  sleep 1
  ifconfig usb0 192.168.7.1 netmask 255.255.255.0 up 2>/dev/null || true

  local elapsed=0
  while [ $elapsed -lt 3 ]; do
    if cat /sys/class/udc/ci_hdrc.0/state 2>/dev/null | grep -q configured; then
      log "  laptop UDC=configured — DBC was disconnected, aborting"
      fail "DBC USB disconnected during flash. Reconnect the DBC cable to the MDB and retry the install from the start."
    fi
    sleep 1
    elapsed=$((elapsed + 1))
  done

  log "  no laptop on UDC; switching back to host"
  rmmod g_ether 2>/dev/null || true
  sleep 1
  role_write host || true
  sleep 2
}

fail() {
  log "ERROR: $1"
  echo "error: $1" > "$STATUS_FILE"
  cat "$LOG_FILE" >> "$STATUS_FILE"
  # Status must survive a rescue reboot, so flush it early. Backgrounded:
  # a wedged USB device can hang a full sync, and the LED signals and
  # gadget restore below must still run regardless.
  sync &
  sleep 2
  # signal_error first: it stops the amber guard, so the red blink below
  # starts clean instead of fighting the guard's 2s re-assert.
  signal_error
  bootled_blink_red
  if ! restore_gadget; then
    gadget_rescue_start
  fi
  # Watchdog stopped only after the restore attempt: if a wedged role
  # write ever blocked restore_gadget despite the timeout, the still-armed
  # watchdog stays as the backstop. No race with the rescue unit: its
  # retries write to the log, so the 15-min silence the watchdog needs
  # can never accumulate while the rescue is alive.
  trampoline_watchdog_stop
  # Indicators are detached and run until the installer reconnects via SSH
  # and stops them. Just exit cleanly here.
  exit 1
}

# SSH/SCP to DBC with retries. -y -y makes dropbear skip host-key checking
# entirely. A flash gives the DBC a brand-new host key; the MDB still has the
# previous one in known_hosts, so a single -y (accept unknown, but ABORT on
# mismatch) still fails on a re-flash. -y -y is required to reach a freshly
# flashed DBC.
dbc_ssh() {
  local tries=0
  while [ $tries -lt 3 ]; do
    ssh -y -y root@$DBC_IP "$@" && return 0
    tries=$((tries + 1))
    log "  ssh retry $tries/3..."
    sleep 3
  done
  return 1
}
dbc_scp() {
  local tries=0
  while [ $tries -lt 3 ]; do
    scp "$@" && return 0
    tries=$((tries + 1))
    log "  scp retry $tries/3..."
    sleep 3
  done
  return 1
}

wait_dbc_ssh() {
  local timeout="${1:-90}" elapsed=0
  log "  waiting for DBC SSH (timeout ${timeout}s)..."
  while [ $elapsed -lt $timeout ]; do
    if ssh -y -y root@$DBC_IP 'echo ok' >/dev/null; then
      local stable=1
      sleep 1
      ssh -y -y root@$DBC_IP 'echo ok' >/dev/null && stable=$((stable+1))
      sleep 1
      ssh -y -y root@$DBC_IP 'echo ok' >/dev/null && stable=$((stable+1))
      if [ $stable -ge 3 ]; then
        log "  DBC SSH stable after ${elapsed}s"
        return 0
      fi
    fi
    elapsed=$((elapsed + 3))
    sleep 3
  done
  return 1
}

# Switch MDB to USB host and probe what the DBC is showing on the bus.
# Sets DBC_ALREADY_UMS=yes if u-boot is already in `ums 0 mmc 2`.
# Calls fail() (does not return) if the DBC is in i.MX BootROM/SDP recovery
# (VID 15a2) — that's a hard-brick that requires imx_usb_loader to rescue
# and is out of scope for this installer.
# Calls fail() if neither UMS nor SDP is on the bus.
probe_dbc_or_fail() {
  rmmod g_ether 2>/dev/null || true
  sleep 1
  role_write host || true
  sleep 3
  PROBE_LSUSB=$(lsusb 2>/dev/null)
  if echo "$PROBE_LSUSB" | grep -q "0525:a4a5"; then
    DBC_ALREADY_UMS="yes"
    log "  DBC is in UMS mode — skipping to flash"
    return 0
  fi
  log "  lsusb output:"
  echo "$PROBE_LSUSB" | sed 's/^/    /' >> "$LOG_FILE"
  if echo "$PROBE_LSUSB" | grep -qi "15a2:"; then
    fail "DBC is in BootROM (SDP) recovery mode — this installer cannot fix that. Manual rescue required (imx_usb_loader)."
  fi
  fail "DBC not reachable and not in UMS mode"
}

find_dbc_block_device() {
  for syspath in /sys/block/sd*; do
    [ -d "$syspath" ] || continue
    local devname="$(basename "$syspath")"
    local dir="$(readlink -f "$syspath/device" 2>/dev/null)"
    while [ -n "$dir" ] && [ "$dir" != "/" ]; do
      if [ -f "$dir/idVendor" ] && [ -f "$dir/idProduct" ]; then
        local vid="$(cat "$dir/idVendor" 2>/dev/null)"
        local pid="$(cat "$dir/idProduct" 2>/dev/null)"
        if [ "$vid" = "0525" ] && [ "$pid" = "a4a5" ]; then
          echo "/dev/$devname"
          return 0
        fi
        break
      fi
      dir="$(dirname "$dir")"
    done
  done
  return 1
}

# Heartbeat for the host-mode watchdog during the long flash write. The
# Go flasher logs progress, but gunzip|dd is silent until it exits, and
# this eMMC writes at only 2-4 MB/s via u-boot UMS, so a full image can
# stay quiet well past the watchdog's 15-minute stall threshold. Sample
# the block device's written-sectors counter once a minute and log it
# only when it advanced: a healthy-but-slow flash keeps the log mtime
# fresh forever, while a flasher stuck in D-state stops the counter and
# still lets the watchdog fire.
FLASH_MON_PID=""
flash_progress_monitor_start() {
  local name="$(basename "$1")"
  (
    last=""
    while :; do
      sleep 60
      cur="$(awk '{print $7}' "/sys/block/$name/stat" 2>/dev/null)"
      [ -n "$cur" ] || continue
      if [ "$cur" != "$last" ]; then
        log "  flash progress: $cur sectors written to $name"
        last="$cur"
      fi
    done
  ) &
  FLASH_MON_PID=$!
}
flash_progress_monitor_stop() {
  [ -n "$FLASH_MON_PID" ] && kill $FLASH_MON_PID 2>/dev/null
  FLASH_MON_PID=""
}

# V3: grow the DBC data partition + fs over UMS and copy tiles, so the DBC
# boots once already-complete. The DBC ships /data at 256M and grows it on
# first boot (mender grow-data + systemd-growfs); doing it here makes that a
# no-op. Tiles land at the exact on-disk paths the onboot HTTP push targets:
# OSM display tiles -> /data/maps/map.mbtiles, Valhalla routing tiles ->
# /data/valhalla/tiles.tar (the DBC boots fresh afterward, so valhalla picks
# up its tiles on start; no service restart needed here). Returns 0 on success
# (grown + tiles copied, or no tiles to copy), non-zero on ANY failure so the
# caller falls back to the proven onboot path. Never proceeds on partial
# failure. NOTE: partition number ($dev4 -> DBC mmcblk3p4) and the presence of
# resize2fs/parted/sfdisk on the MDB image are unverified in this environment;
# any mismatch returns non-zero and the proven onboot path takes over.
grow_and_populate_dbc() {
  dev="$1"
  command -v resize2fs >/dev/null 2>&1 || { log "V3: resize2fs missing"; return 1; }
  partprobe "$dev" 2>/dev/null || blockdev --rereadpt "$dev" 2>/dev/null || true
  sleep 1
  data_part="${dev}4"   # DBC data is mmcblk3p4 -> sdX4 over UMS; verify on hardware
  [ -b "$data_part" ] || { log "V3: data partition $data_part not found"; return 1; }
  # Grow the partition to fill the disk, then the filesystem.
  if command -v parted >/dev/null 2>&1; then
    parted -s "$dev" resizepart 4 100% 2>/dev/null || { log "V3: parted resizepart failed"; return 1; }
  elif command -v sfdisk >/dev/null 2>&1; then
    echo ", +" | sfdisk --no-reread -N 4 "$dev" 2>/dev/null || { log "V3: sfdisk grow failed"; return 1; }
  else
    log "V3: no parted/sfdisk"; return 1
  fi
  partprobe "$dev" 2>/dev/null || blockdev --rereadpt "$dev" 2>/dev/null || true
  sleep 1
  e2fsck -fy "$data_part" 2>/dev/null || true   # tolerate fsck rc<8; resize2fs will fail if truly bad
  resize2fs "$data_part" 2>/dev/null || { log "V3: resize2fs failed"; return 1; }
  if [ "$INSTALL_TILES" = "true" ]; then
    mkdir -p /mnt/dbcdata 2>/dev/null
    mount -t ext4 "$data_part" /mnt/dbcdata 2>/dev/null || { log "V3: mount failed"; return 1; }
    mkdir -p /mnt/dbcdata/maps /mnt/dbcdata/valhalla 2>/dev/null
    rc=0
    # (source, dest) pairs mirror the proven onboot HTTP push exactly:
    # OSM -> /data/maps/map.mbtiles, Valhalla -> /data/valhalla/tiles.tar.
    if [ -n "$OSM_TILES_FILE" ] && [ -f "$OSM_TILES_FILE" ]; then
      if cp "$OSM_TILES_FILE" /mnt/dbcdata/maps/map.mbtiles 2>/dev/null; then
        log "V3: copied display tiles -> maps/map.mbtiles"
      else
        log "V3: copy display tiles failed"; rc=1
      fi
    fi
    if [ -n "$VALHALLA_TILES_FILE" ] && [ -f "$VALHALLA_TILES_FILE" ]; then
      if cp "$VALHALLA_TILES_FILE" /mnt/dbcdata/valhalla/tiles.tar 2>/dev/null; then
        log "V3: copied routing tiles -> valhalla/tiles.tar"
      else
        log "V3: copy routing tiles failed"; rc=1
      fi
    fi
    sync
    umount /mnt/dbcdata 2>/dev/null || true
    [ "$rc" = 0 ] || return 1
  fi
  log "V3: grow+tiles complete"
  return 0
}

# =========================================================================
# Drop a small helper the installer can invoke via SSH after a failure to
# stop the boot-LED blink and the hazard flash, reset the LED state, and
# unmask keycard-service so a later boot has a working keycard reader.
cat > "$INSTALLER_DIR/stop-error-signals.sh" << 'STOP_HELPER'
#!/bin/sh
# Stop the systemd-run transient units the trampoline/onboot launched for
# the boot-LED blink, the LED guard loop, and the hazards flash. systemctl
# stop is the primary path; the PID-file cleanup below is for older builds.
systemctl stop librescoot-bootled-blink.service 2>/dev/null
systemctl stop librescoot-bootled-guard.service 2>/dev/null
systemctl stop librescoot-bootled-hazards.service 2>/dev/null
# Gadget-mode rescue loop from fail(): normally exits on its own once the
# laptop enumerates, but stop it explicitly so it can never reboot the MDB
# out from under a connected installer.
systemctl stop librescoot-gadget-rescue.service 2>/dev/null
# Host-mode stall watchdog: harmless once we're reachable again (it only
# acts on host role + silent log), but stop it for the same reason.
systemctl stop librescoot-trampoline-watchdog.service 2>/dev/null
if [ -f /data/bootled-blink.pid ]; then
  pid="$(cat /data/bootled-blink.pid 2>/dev/null)"
  if [ -n "$pid" ]; then
    kill -- -"$pid" 2>/dev/null
    kill "$pid" 2>/dev/null
  fi
  rm -f /data/bootled-blink.pid
fi
if [ -f /data/error-hazards.pid ]; then
  pid="$(cat /data/error-hazards.pid 2>/dev/null)"
  if [ -n "$pid" ]; then
    kill -- -"$pid" 2>/dev/null
    kill "$pid" 2>/dev/null
  fi
  rm -f /data/error-hazards.pid
fi
# LED off
i2cset -f -y 2 0x30 0x02 0x00 2>/dev/null
i2cset -f -y 2 0x30 0x03 0x00 2>/dev/null
i2cset -f -y 2 0x30 0x04 0x00 2>/dev/null
# Blinkers off + deactivate
for ch in 3 4 6 7; do
  /usr/bin/ioctl /dev/pwm_led$ch 0x0000754A -v 0 2>/dev/null
  /usr/bin/ioctl /dev/pwm_led$ch 0x00007549 -v 0 2>/dev/null
done
# Unmask keycard-service: the trampoline masked it pre-flash so it couldn't
# race us on the LED. The installer's keycardSetup phase will start it
# explicitly; until then it stays inactive but unmasked, so a power cycle
# during a failed install doesn't leave the user with a dead keycard reader.
systemctl unmask librescoot-keycard keycard-service 2>/dev/null || true
# Re-enable BLE — the trampoline masked librescoot-bluetooth so a paired
# phone couldn't send unlock/lock commands via the nRF52 mid-flash. The
# installer's bluetoothPairing phase needs the service running, so start
# it now (unlike keycard, we have no reason to keep it stopped).
systemctl unmask librescoot-bluetooth 2>/dev/null || true
systemctl start librescoot-bluetooth 2>/dev/null || true
# Re-enable UMS — masked pre-flash so it couldn't grab the OTG UDC. A failed
# install must not leave the user with mass-storage permanently masked.
systemctl unmask librescoot-ums 2>/dev/null || true
systemctl start librescoot-ums 2>/dev/null || true
exit 0
STOP_HELPER
chmod +x "$INSTALLER_DIR/stop-error-signals.sh"

# =========================================================================
# Staged for the emergency-reboot paths (gadget-rescue deadline, watchdog).
# Installed as /data/onboot.sh just before an emergency MDB reboot so the
# red error blink comes back right after boot instead of leaving the user
# with a dark scooter. Restores any backed-up onboot.sh (or self-deletes)
# without executing it, same as the step-8 onboot does. The blink unit is
# stopped by stop-error-signals.sh when the installer reconnects.
cat > "$INSTALLER_DIR/rescue-onboot.sh" << 'RESCUE_ONBOOT'
#!/bin/sh
# Written by the installer's emergency-reboot recovery. Re-arms the red
# error blink after boot, then puts /data/onboot.sh back the way it was.
INSTALLER_DIR="/data/installer"
if [ -f "$INSTALLER_DIR/onboot.sh.rescue-bak" ]; then
  mv "$INSTALLER_DIR/onboot.sh.rescue-bak" /data/onboot.sh
else
  rm -f /data/onboot.sh
fi
# LP5562 init (keycard-service is masked, so nobody else does this)
i2cset -f -y 2 0x30 0x0D 0xFF 2>/dev/null
i2cset -f -y 2 0x30 0x01 0x3F 2>/dev/null
i2cset -f -y 2 0x30 0x70 0x00 2>/dev/null
i2cset -f -y 2 0x30 0x08 0x61 2>/dev/null
i2cset -f -y 2 0x30 0x00 0xC0 2>/dev/null
i2cset -f -y 2 0x30 0x05 0xAF 2>/dev/null
i2cset -f -y 2 0x30 0x06 0xAF 2>/dev/null
i2cset -f -y 2 0x30 0x07 0xAF 2>/dev/null
systemctl stop librescoot-bootled-blink.service 2>/dev/null
systemd-run --unit=librescoot-bootled-blink --collect --quiet --slice=system.slice /bin/sh -c '
  while true; do
    i2cset -f -y 2 0x30 0x02 0x00 2>/dev/null
    i2cset -f -y 2 0x30 0x03 0x00 2>/dev/null
    i2cset -f -y 2 0x30 0x04 0xFF 2>/dev/null
    sleep 0.4
    i2cset -f -y 2 0x30 0x02 0x00 2>/dev/null
    i2cset -f -y 2 0x30 0x03 0x00 2>/dev/null
    i2cset -f -y 2 0x30 0x04 0x00 2>/dev/null
    sleep 0.4
  done
'
exit 0
RESCUE_ONBOOT
chmod +x "$INSTALLER_DIR/rescue-onboot.sh"

# =========================================================================
# Recovery action for the host-mode stall watchdog. Kept as a staged file
# so it gets full quoting freedom (the watchdog unit itself is a single-
# quoted systemd-run string). Tries an in-place gadget restore first: if
# that works we keep the running system (and its LED signals) and just
# blink red until the installer reconnects and reads the status. If the
# role is wedged, fall back to the emergency reboot. A stalled flasher in
# D-state can hang sync and even a graceful reboot, hence the timeouts
# and the reboot -f fallback.
cat > "$INSTALLER_DIR/watchdog-recover.sh" << 'WATCHDOG_RECOVER'
#!/bin/sh
INSTALLER_DIR="/data/installer"
LOG="$INSTALLER_DIR/trampoline.log"
STATUS="$INSTALLER_DIR/trampoline-status"
log() { echo "$(date '+%H:%M:%S') watchdog: $1" >> "$LOG"; }

log "trampoline stalled in host mode, attempting recovery"
echo "error: installation stalled in USB host mode and was recovered by the watchdog. Please retry the install." > "$STATUS"
cat "$LOG" >> "$STATUS"
sync &
sleep 5

systemctl stop librescoot-bootled-guard.service 2>/dev/null

attempt=0
while [ $attempt -lt 3 ]; do
  attempt=$((attempt + 1))
  rmmod g_ether 2>/dev/null
  sleep 1
  if command -v timeout >/dev/null 2>&1; then
    timeout 15 sh -c "echo gadget > /sys/kernel/debug/ci_hdrc.0/role" 2>/dev/null
  else
    echo gadget > /sys/kernel/debug/ci_hdrc.0/role 2>/dev/null
  fi
  sleep 1
  modprobe g_ether 2>/dev/null
  sleep 1
  ifconfig usb0 192.168.7.1 netmask 255.255.255.0 up 2>/dev/null
  sleep 1
  if [ "$(cat /sys/kernel/debug/ci_hdrc.0/role 2>/dev/null)" = "gadget" ] \
      && ifconfig usb0 2>/dev/null | grep -q '192\.168\.7\.1'; then
    log "gadget restored in place (attempt $attempt)"
    systemctl stop librescoot-bootled-blink.service 2>/dev/null
    systemd-run --unit=librescoot-bootled-blink --collect --quiet --slice=system.slice /bin/sh -c '
      while true; do
        i2cset -f -y 2 0x30 0x02 0x00 2>/dev/null
        i2cset -f -y 2 0x30 0x03 0x00 2>/dev/null
        i2cset -f -y 2 0x30 0x04 0xFF 2>/dev/null
        sleep 0.4
        i2cset -f -y 2 0x30 0x02 0x00 2>/dev/null
        i2cset -f -y 2 0x30 0x03 0x00 2>/dev/null
        i2cset -f -y 2 0x30 0x04 0x00 2>/dev/null
        sleep 0.4
      done
    '
    exit 0
  fi
  sleep 2
done

log "gadget restore failed, rebooting MDB"
if [ -f /data/onboot.sh ]; then
  cp /data/onboot.sh "$INSTALLER_DIR/onboot.sh.rescue-bak"
fi
cp "$INSTALLER_DIR/rescue-onboot.sh" /data/onboot.sh
chmod +x /data/onboot.sh
sync &
sleep 10
reboot &
sleep 30
reboot -f
WATCHDOG_RECOVER
chmod +x "$INSTALLER_DIR/watchdog-recover.sh"

echo "" > "$LOG_FILE"
log "=========================================="
log "Trampoline started"
log "  DBC_IMAGE=$DBC_IMAGE"
log "  INSTALL_TILES=$INSTALL_TILES"
log "  OSM=$OSM_TILES_FILE"
log "  VALHALLA=$VALHALLA_TILES_FILE"
log "=========================================="

# Log all errors, always: route every command's stderr into the log so no
# failure is ever silent (this is how the post-flash DBC SSH host-key
# rejection went unseen). Commands still opt out with 2>/dev/null only where
# a failure is expected and handled (LED writes, ping polling, || true).
exec 2>>"$LOG_FILE"

# Stop services that interfere. Persistent mask survives the MDB reboot
# we do after writing onboot.sh; onboot.sh unmasks at the end of its
# success branch, and stop-error-signals.sh unmasks on the failure path
# when the installer reconnects.
#
# librescoot-keycard / keycard-service: both drive the LP5562 via i2cset
#   on /dev/i2c-2 @ 0x30. If they fire mid-flash they stomp our amber.
# librescoot-bluetooth: bridges nRF52 BLE ↔ Redis. A paired phone could
#   LPUSH unlock/lock onto scooter:state via this service. The laptop is
#   physically disconnected during the autonomous flash, so the user
#   can't catch a stray BLE-triggered unlock until they reconnect.
#   Stopping the service severs the BLE → Redis path for the duration.
# librescoot-ums: binds a USB mass-storage gadget on the same OTG UDC
#   (ci_hdrc.0) the trampoline drives for g_ether and the gadget<->host
#   role switch. It's enabled + Restart=always, so a plain stop comes back
#   on the post-flash MDB reboot and can grab the UDC out from under us,
#   stalling the DBC UMS handoff (step 6). Mask it like keycard/bluetooth;
#   re-enabled at the end of onboot.sh's success branch and on the failure
#   path via stop-error-signals.sh.
# librescoot-pm: standard "get out of the way" stop (no UDC conflict).
log "Stopping services..."
systemctl stop librescoot-keycard keycard-service 2>/dev/null || true
systemctl mask librescoot-keycard keycard-service 2>/dev/null || true
systemctl stop librescoot-bluetooth 2>/dev/null || true
systemctl mask librescoot-bluetooth 2>/dev/null || true
systemctl stop librescoot-ums 2>/dev/null || true
systemctl mask librescoot-ums 2>/dev/null || true
systemctl stop librescoot-pm 2>/dev/null || true

bootled_init
bootled amber
# vehicle-service also drives the LP5562 (for blinker brightness) and we
# can't mask it — we need it for `lsc dbc on-wait`. Start the guard loop
# that re-asserts amber every 2s so any stray write loses within a tick.
bootled_guard_start

# Capture system journal in background for debugging
journalctl -f --no-pager >> "$INSTALLER_DIR/trampoline-journal.log" 2>&1 &
JOURNAL_PID=$!

# Arm the host-mode stall watchdog. Inert while the role is gadget, so
# arming this early is free; it covers every host-mode stint from here on.
trampoline_watchdog_start

# Phase 0 — Prep: front ring breathes, FL blinker breathes.
set_progress_phase 0
breathe_start 1

# Verify image
[ -f "$DBC_IMAGE" ] || fail "DBC image not found: $DBC_IMAGE"
log "Image: $(ls -lh "$DBC_IMAGE" | awk '{print $5}')"

# Step 1: Wait for laptop disconnect
step_begin "Step 1: wait for laptop disconnect"
# The laptop is gone when VBUS drops: udc state -> "not attached". Require it to
# hold stable so a transient blip (host autosuspend, RNDIS re-enumeration) can't
# flip us to host mode while the laptop is still attached. ~250ms of stable reads;
# the swap itself takes seconds, so a short hold loses nothing. Tune GONE_NEEDED on
# hardware to the real sleep granularity.
UDC_STATE=/sys/class/udc/ci_hdrc.0/state
GONE_NEEDED=3
GONE=0
while [ "$GONE" -lt "$GONE_NEEDED" ]; do
  if grep -q "not attached" "$UDC_STATE" 2>/dev/null; then
    GONE=$((GONE + 1))
  else
    GONE=0
  fi
  sleep 0.1 2>/dev/null || sleep 1
done
log "Laptop disconnected (debounced)"
step_end

# Step 2: Re-init g_ether for DBC
step_begin "Step 2: re-init g_ether"
rmmod g_ether 2>/dev/null || true
sleep 1
modprobe g_ether 2>/dev/null || true
sleep 2
ifconfig usb0 192.168.7.1 netmask 255.255.255.0 up 2>/dev/null || true
log "  usb0 ready"
step_end

# Step 3: Power on DBC
step_begin "Step 3: power on DBC"
DBC_ALREADY_UMS=""

lsc --redis-addr localhost:6379 dbc on-wait >> "$LOG_FILE" 2>&1
if [ $? -ne 0 ]; then
  log "  DBC on-wait failed, checking USB state..."
  probe_dbc_or_fail
fi

if [ "$DBC_ALREADY_UMS" != "yes" ]; then
  # Quick ping check — if DBC isn't even pingable, don't waste time on SSH
  if ! ping -c 1 -W 3 $DBC_IP >/dev/null 2>&1; then
    log "  DBC not pingable after on-wait, checking USB state..."
    probe_dbc_or_fail
  fi
fi
step_end

if [ "$DBC_ALREADY_UMS" != "yes" ]; then
  step_begin "Step 3b: wait for DBC SSH"
  wait_dbc_ssh 30 || fail "DBC SSH not reachable"
  log "DBC reachable"
  step_end

  # Identify the DBC over SSH while it still runs its own OS. This is the only
  # reliable identity signal (no DBC-unique USB id exists). Skip the destructive
  # flash if it is already at the exact target Librescoot version.
  DBC_OS=$(dbc_ssh 'cat /etc/os-release 2>/dev/null')
  DBC_VERSION=$(printf '%s\n' "$DBC_OS" | sed -n 's/^VERSION_ID=//p' | tr -d '"')
  DBC_ID=$(printf '%s\n' "$DBC_OS" | sed -n 's/^ID=//p' | tr -d '"')
  log "DBC identity: ID='${DBC_ID:-unknown}' VERSION_ID='${DBC_VERSION:-unknown}'"

  TARGET_DBC_VERSION='{{TARGET_DBC_VERSION}}'
  FORCE_REFLASH='{{FORCE_DBC_REFLASH}}'
  if [ "$FORCE_REFLASH" != "true" ] && [ -n "$TARGET_DBC_VERSION" ] && [ -n "$DBC_VERSION" ] \
     && [ "$DBC_VERSION" = "$TARGET_DBC_VERSION" ] \
     && printf '%s' "$DBC_ID" | grep -q '^librescoot'; then
    log "DBC already at target $TARGET_DBC_VERSION; skipping DBC flash"
    echo "success" > "$STATUS_FILE"
    restore_gadget
    signal_progress_off
    bootled_guard_stop
    bootled_blink_green
    exit 0
  fi

  # Step 4: Configure DBC for UMS (retry up to 3x if DBC shuts down)
  step_begin "Step 4: configure DBC bootloader for UMS"
  STEP4_OK=""
  for STEP4_ATTEMPT in 1 2 3; do
    log "  step 4 attempt $STEP4_ATTEMPT/3..."

    # Check if DBC is still reachable
    if ! ping -c 1 -W 2 $DBC_IP >/dev/null 2>&1; then
      log "  DBC not reachable, turning on..."
      lsc --redis-addr localhost:6379 dbc on-wait >> "$LOG_FILE" 2>&1 || true
      wait_dbc_ssh 30 || { log "  DBC SSH failed after on-wait"; continue; }
    fi

    # Check native fw_setenv (Librescoot DBC) vs stock
    HAS_NATIVE=$(ssh -y -y root@$DBC_IP 'test -x /usr/bin/fw_setenv && test -f /etc/fw_env.config && echo yes' 2>/dev/null || echo no)
    log "  native fw_setenv: $HAS_NATIVE"

    if [ "$HAS_NATIVE" = "yes" ]; then
      FWCMD="fw_setenv"
      FWCFG=""
    else
      log "  copying stock DBC fw tools..."
      dbc_scp "$INSTALLER_DIR/fwtools/stock-dbc/fw_setenv" root@$DBC_IP:/tmp/ || { log "  scp failed"; continue; }
      dbc_scp "$INSTALLER_DIR/fwtools/stock-dbc/fw_env.config" root@$DBC_IP:/tmp/fw_env.config || { log "  scp failed"; continue; }
      dbc_ssh 'chmod +x /tmp/fw_setenv' || true
      FWCMD="/tmp/fw_setenv"
      FWCFG="-c /tmp/fw_env.config"
    fi

    log "  setting bootcmd..."
    BOOTCMD_OUT=$(dbc_ssh "$FWCMD $FWCFG bootcmd 'fuse prog -y 0 5 0x00003860; fuse prog -y 0 6 0x00000010; ums 0 mmc 2;'" 2>&1)
    if [ $? -ne 0 ]; then
      log "  bootcmd failed: $BOOTCMD_OUT"
      BOOTCMD_OUT=$(dbc_ssh "$FWCMD $FWCFG bootcmd 'ums 0 mmc 2'" 2>&1)
      if [ $? -ne 0 ]; then
        log "  fallback bootcmd also failed, DBC may have shut down"
        sleep 5
        continue
      fi
    fi
    log "  bootcmd set: $BOOTCMD_OUT"

    # Wait a moment then check if DBC is still alive
    sleep 3
    if ! ping -c 1 -W 2 $DBC_IP >/dev/null 2>&1; then
      log "  DBC went down after fw_setenv — retrying..."
      sleep 5
      continue
    fi

    log "  setting bootdelay=0..."
    dbc_ssh "$FWCMD $FWCFG bootdelay 0" >> "$LOG_FILE" 2>&1 || log "  bootdelay failed"

    log "  syncing DBC..."
    dbc_ssh 'sync' >> "$LOG_FILE" 2>&1 || log "  sync failed"

    # Reboot the DBC into u-boot UMS. Soft-reboot first so the DBC syncs and
    # shuts down its filesystem cleanly, then after 10s force a hard power
    # cycle. The force (dashboard:off:force) is required: a plain dashboard:off
    # is rejected while a DBC update is flagged, and otherwise runs a graceful
    # `dbc:command poweroff` + 4s wait that the seatbox-open / awake vehicle
    # state interferes with, so the DBC never actually cycles. bootcmd is armed
    # to `ums 0 mmc 2` with bootdelay=0, so powering back on drops straight
    # into UMS; step 6 polls for the resulting block device.
    log "  rebooting DBC (soft reboot, then forced power cycle)..."
    dbc_ssh 'reboot &' >> "$LOG_FILE" 2>&1 || log "  reboot failed"
    sleep 10
    lsc --redis-addr localhost:6379 dbc off-wait --force >> "$LOG_FILE" 2>&1 || log "  forced DBC off failed"
    lsc --redis-addr localhost:6379 dbc on >> "$LOG_FILE" 2>&1 || log "  DBC power-on failed"
    sleep 3

    STEP4_OK="yes"
    break
  done
  [ "$STEP4_OK" != "yes" ] && fail "Failed to configure DBC after 3 attempts"
  step_end
fi  # end of DBC_ALREADY_UMS != yes

# Pre-write sanity: confirm we have a sane UMS volume of expected geometry before
# going destructive. The host's 1-16GB isSafeToFlash check is dead in walk-away,
# so the MDB must guard itself.
#
# Terminal vs retryable in the retry world (see the outer loop below):
#   - mmcblk / size-out-of-band / smaller-than-image are TERMINAL: a wrong or
#     oversized device won't fix itself by re-powering, so these still call
#     fail() (which exits) directly.
#   - "not readable" is RETRYABLE: the UMS volume can be present-but-not-yet-
#     ready right after enumeration, and a re-power often settles it. We signal
#     that with return code 2 so do_dbc_flash_round() treats it as a round
#     failure instead of a hard abort.
# Return: 0 = OK, 2 = retryable (device not readable yet). Terminal cases never
# return (fail() exits).
sanity_check_target() {
  dev="$1"; min_total="$2"
  name=$(basename "$dev")
  case "$name" in
    mmcblk*) fail "SAFETY: $dev is mmcblk - refusing";;
  esac
  if ! dd if="$dev" bs=512 count=1 of=/dev/null 2>/dev/null; then
    log "Sanity: $dev not readable yet - treating as retryable"
    return 2
  fi
  sectors=$(cat "/sys/block/$name/size" 2>/dev/null || echo 0)
  bytes=$((sectors * 512))
  if [ "$bytes" -lt 1000000000 ] || [ "$bytes" -gt 17000000000 ]; then
    fail "Target $dev size ${bytes}B outside 1-16GB band - refusing"
  fi
  if [ -n "$min_total" ] && [ "$bytes" -lt "$min_total" ]; then
    fail "Target $dev (${bytes}B) smaller than image (${min_total}B) - refusing"
  fi
  log "Sanity OK: $dev ${bytes}B"
  return 0
}

# One flash round: flip MDB to USB host (step 5), wait for the DBC UMS block
# device (step 6), run the pre-write sanity gate, then the inner 3-attempt
# write+verify loop (step 7). Returns 0 only on a verified flash. Returns
# non-zero on a retryable failure (no DBC device on the bus, device not
# readable yet, or all 3 inner write attempts failed) so the outer loop can
# re-power the DBC and try again. Terminal conditions (laptop reconnected,
# SDP brick, wrong/oversized device) still call fail() and exit from within.
# On success, leaves the verified device path in DBC_DEV for the V3/onboot
# paths that run after a successful round.
do_dbc_flash_round() {
  # Step 5: Switch MDB to USB host (may already be in host mode if DBC was in UMS)
  step_begin "Step 5: switch MDB to USB host mode"
  CURRENT_ROLE=$(cat /sys/kernel/debug/ci_hdrc.0/role 2>/dev/null)
  if [ "$CURRENT_ROLE" != "host" ]; then
    rmmod g_ether 2>/dev/null || true
    sleep 1
    if ! role_write host; then
      log "  failed to switch to host mode this round"
      step_end
      return 1
    fi
    sleep 3
  else
    log "  already in host mode"
  fi
  log "  role: $(cat /sys/kernel/debug/ci_hdrc.0/role 2>/dev/null)"
  log "  lsusb: $(lsusb 2>/dev/null | grep 0525 || echo 'no 0525')"
  step_end

  # Step 6: Find DBC block device (DBC may still be rebooting from step 4).
  # This window absorbs two variable delays: the DBC reboot into u-boot UMS,
  # AND the human swapping the single USB cable from the laptop over to the
  # DBC. A slow swap is the common case, and timing out here is expensive to
  # recover from — step 4 already armed the DBC bootcmd to `ums 0 mmc 2` with
  # bootdelay=0, so a DBC that never got flashed will keep booting straight
  # into UMS until it's reflashed. Give the user real time (5 min) before
  # giving up.
  # We don't peek at gadget mode during the wait — flipping roles can
  # race the DBC enumeration. Only after the full timeout, if there's
  # really nothing on the bus, do a single gadget probe to disambiguate
  # "DBC absent" vs "laptop reconnected"; that gives the user a clear
  # error message instead of a generic "UMS not found".
  step_begin "Step 6: wait for DBC UMS device"
  TIMEOUT=300
  ELAPSED=0
  DBC_DEV=""
  # Remember where the captured journal stood when the wait started, so the
  # timeout analysis below only looks at bus activity from THIS window.
  # Earlier host-mode stints (step 3 probe) would otherwise pollute it.
  STEP6_JNL_START=$(wc -l < "$INSTALLER_DIR/trampoline-journal.log" 2>/dev/null || echo 0)
  STEP6_REPOWERED=""
  while [ $ELAPSED -lt $TIMEOUT ]; do
    DBC_DEV="$(find_dbc_block_device 2>/dev/null)" && break
    ELAPSED=$((ELAPSED + 2))
    if [ $((ELAPSED % 10)) -eq 0 ]; then
      log "  ${ELAPSED}s... $(lsusb 2>/dev/null | grep 0525 || echo 'no USB')"
    fi
    # Halfway nudge: re-power the DBC once. Recovers a DBC that hung before
    # reaching UMS; bootcmd is armed with bootdelay=0, so a healthy DBC just
    # lands back in UMS. Harmless if the cable simply isn't connected yet.
    if [ $ELAPSED -ge $((TIMEOUT / 2)) ] && [ -z "$STEP6_REPOWERED" ]; then
      STEP6_REPOWERED="yes"
      log "  halfway through the wait, re-powering DBC once..."
      lsc --redis-addr localhost:6379 dbc off-wait --force >> "$LOG_FILE" 2>&1 || log "  DBC off failed"
      lsc --redis-addr localhost:6379 dbc on >> "$LOG_FILE" 2>&1 || log "  DBC on failed"
    fi
    sleep 2
  done
  if [ -z "$DBC_DEV" ]; then
    # Last-ditch: see if the user yanked the DBC and connected the laptop.
    # If so, probe_for_laptop_then_restore_host calls fail() with a clear
    # message and never returns (a laptop reconnect is terminal, not a
    # round-failure — retrying can't help if the DBC is no longer attached).
    probe_for_laptop_then_restore_host
    # No laptop, no DBC device. Classify what (if anything) the bus saw
    # during the wait, from the journal we're already capturing, and log it
    # so the eventual outer-exhaustion fail() carries the best message. This
    # is a RETRYABLE round failure: a re-power may bring the DBC back.
    STEP6_JNL=$(tail -n +$((STEP6_JNL_START + 1)) "$INSTALLER_DIR/trampoline-journal.log" 2>/dev/null | grep "usb 1-1")
    if [ -z "$STEP6_JNL" ]; then
      ROUND_FAIL_MSG="No USB device was detected while waiting for the DBC. The USB cable is probably not plugged into the DBC. Connect the MDB's USB cable to the DBC and retry."
    elif echo "$STEP6_JNL" | grep -qiE "device descriptor read|device not accepting|unable to enumerate|error"; then
      ROUND_FAIL_MSG="A USB device was detected but failed to enumerate. Reseat the USB cable between MDB and DBC and retry."
    else
      ROUND_FAIL_MSG="DBC UMS not found in ${TIMEOUT}s"
    fi
    log "  round failed: $ROUND_FAIL_MSG"
    step_end
    return 1
  fi
  log "DBC device: $DBC_DEV ($(cat /sys/block/$(basename $DBC_DEV)/size 2>/dev/null || echo '?') sectors)"
  step_end

  # Prep complete — advance to phase 1 (FL filled, FR breathing).
  set_progress_phase 1

  # Step 7: Flash DBC
  step_begin "Step 7: flash DBC"
  breathe_stop
  led_off 1  # front ring off during flash

  # Read uncompressed size from gzip footer (last 4 bytes, little-endian uint32)
  FLASH_TOTAL=$(python3 -c "import struct; f=open('$DBC_IMAGE','rb'); f.seek(-4,2); print(struct.unpack('<I',f.read(4))[0])" 2>/dev/null || echo 2500000000)
  log "  image uncompressed size: $FLASH_TOTAL"

  sanity_check_target "$DBC_DEV" "$FLASH_TOTAL"
  SANITY_RC=$?
  # rc 0 = OK (fall through), rc 2 = device not readable yet (retryable round
  # failure), terminal cases never return (fail() exited). Defensive: any
  # other non-zero is also treated as a retryable round failure.
  if [ "$SANITY_RC" -ne 0 ]; then
    ROUND_FAIL_MSG="DBC UMS volume not ready (sanity rc=$SANITY_RC)"
    log "  round failed: $ROUND_FAIL_MSG"
    step_end
    return 1
  fi

  FLASH_OK=""
  ATTEMPT=0
  while [ $ATTEMPT -lt 3 ]; do
    ATTEMPT=$((ATTEMPT + 1))
    log "  flash attempt $ATTEMPT/3..."
    flash_progress_monitor_start "$DBC_DEV"

    FLASHER="$INSTALLER_DIR/librescoot-flasher"
    USING_DD=""
    if [ -x "$FLASHER" ] && [ -f "$DBC_BMAP" ]; then
      log "  using librescoot-flasher (bmap: $DBC_BMAP)"
      $FLASHER --image "$DBC_IMAGE" --bmap "$DBC_BMAP" --device "$DBC_DEV" >> "$LOG_FILE" 2>&1
      FLASH_RC=$?
    elif [ -x "$FLASHER" ]; then
      log "  using librescoot-flasher (sequential)"
      $FLASHER --image "$DBC_IMAGE" --device "$DBC_DEV" >> "$LOG_FILE" 2>&1
      FLASH_RC=$?
    else
      USING_DD="yes"
      log "  using dd (oflag=direct), image size: $FLASH_TOTAL"
      gunzip -c "$DBC_IMAGE" | dd bs=4M iflag=fullblock of=$DBC_DEV oflag=direct 2>> "$LOG_FILE"
      # $? of a pipeline is dd's status (PIPESTATUS is bash-only and a bad
      # substitution under busybox ash). A gunzip failure truncates the
      # stream without failing dd; the boot-sector verify below catches it.
      FLASH_RC=$?
    fi

    flash_progress_monitor_stop
    if [ "${FLASH_RC:-0}" -ne 0 ]; then
      log "  flash failed (rc=$FLASH_RC), retrying..."
      sleep 3
      DBC_DEV="$(find_dbc_block_device 2>/dev/null)" || { log "  device gone, waiting..."; sleep 5; DBC_DEV="$(find_dbc_block_device 2>/dev/null)" || continue; }
      log "  re-probed device: $DBC_DEV"
      continue
    fi

    sync

    # Go flasher paths (bmap + sequential) already verify source/bmap integrity
    # per range and surface write errors as non-zero exit; trust the exit code.
    if [ -z "$USING_DD" ]; then
      log "  flasher reports success"
      FLASH_OK="yes"
      break
    fi

    # dd fallback: sanity-check boot sector (24 MB). iflag=direct bypasses page
    # cache, which otherwise serves stale data populated by udev at enumeration.
    log "  verifying boot sector ($BOOT_AREA_BLOCKS blocks = 24 MB)..."
    SRC_HASH=$(gunzip -c "$DBC_IMAGE" | dd bs=4M iflag=fullblock count=$BOOT_AREA_BLOCKS 2>/dev/null | md5sum | cut -d' ' -f1)
    DEV_HASH=$(dd if=$DBC_DEV bs=4M iflag=direct count=$BOOT_AREA_BLOCKS 2>/dev/null | md5sum | cut -d' ' -f1)
    log "  src=$SRC_HASH dev=$DEV_HASH"

    if [ "$SRC_HASH" = "$DEV_HASH" ]; then
      log "  verified OK"
      FLASH_OK="yes"
      break
    else
      log "  checksum mismatch, retrying..."
      sleep 3
      DBC_DEV="$(find_dbc_block_device 2>/dev/null)" || { log "  device gone, waiting..."; sleep 5; DBC_DEV="$(find_dbc_block_device 2>/dev/null)" || continue; }
      log "  re-probed device: $DBC_DEV"
    fi
  done

  if [ "$FLASH_OK" != "yes" ]; then
    ROUND_FAIL_MSG="DBC flash failed after 3 attempts"
    log "  round failed: $ROUND_FAIL_MSG"
    step_end
    return 1
  fi
  log "DBC flash complete"
  step_end
  return 0
}

# Outer retry loop: keep flashing the DBC until a round verifies, bounded by
# BOTH an attempt cap and a wall-clock budget. The host is gone during the
# autonomous flash, so nobody can retry for the user — but a DBC that fell
# into i.MX BootROM/SDP recovery (USB id 15a2:) is a hard brick that can never
# present as the UMS device, so we short-circuit that as terminal before every
# round instead of retrying forever. Between rounds we re-power the DBC (the
# step-4 bootcmd lands it back in UMS) and back off, emitting a log line at
# each round start and around every sleep so the 15-min host-mode stall
# watchdog (which keys on trampoline.log mtime) stays inert during legitimate
# retries.
DBC_FLASH_MAX_ROUNDS=8
DBC_FLASH_BUDGET_S=3600   # wall-clock ceiling across all rounds
DBC_FLASH_T0=$(date +%s)
ROUND=0
ROUND_FAIL_MSG="DBC flash did not complete"
DBC_FLASH_DONE=""
while [ $ROUND -lt $DBC_FLASH_MAX_ROUNDS ]; do
  ROUND=$((ROUND + 1))
  NOW=$(date +%s)
  ELAPSED_TOTAL=$((NOW - DBC_FLASH_T0))
  log "=== DBC flash round $ROUND/$DBC_FLASH_MAX_ROUNDS (T+${ELAPSED_TOTAL}s of ${DBC_FLASH_BUDGET_S}s budget) ==="

  # Terminal SDP short-circuit: a DBC in BootROM/SDP recovery (VID 15a2) is a
  # hard brick — it can never present as the UMS device 0525:a4a5, so retrying
  # is pointless. This is the one unrecoverable case; fail() exits.
  if lsusb 2>/dev/null | grep -qi '15a2:'; then
    fail "DBC is in BootROM (SDP) recovery mode - manual rescue required (imx_usb_loader). The installer cannot fix that."
  fi

  if do_dbc_flash_round; then
    DBC_FLASH_DONE="yes"
    break
  fi

  # Round failed (retryable). Stop here if we've spent the budget or used the
  # last attempt; surface the best classified message via the terminal fail().
  NOW=$(date +%s)
  ELAPSED_TOTAL=$((NOW - DBC_FLASH_T0))
  if [ $ROUND -ge $DBC_FLASH_MAX_ROUNDS ]; then
    log "  exhausted $DBC_FLASH_MAX_ROUNDS rounds"
    break
  fi
  if [ $ELAPSED_TOTAL -ge $DBC_FLASH_BUDGET_S ]; then
    log "  wall-clock budget (${DBC_FLASH_BUDGET_S}s) exhausted after $ROUND rounds"
    break
  fi

  # Re-power the DBC between rounds so a hung/half-booted DBC gets a clean
  # cycle; the step-4 bootcmd (ums 0 mmc 2, bootdelay=0) lands it straight
  # back in UMS for the next round. Same lsc invocation form as elsewhere.
  log "  round $ROUND failed: $ROUND_FAIL_MSG"
  log "  re-powering DBC before retry..."
  lsc --redis-addr localhost:6379 dbc off-wait --force >> "$LOG_FILE" 2>&1 || log "  DBC off failed"
  lsc --redis-addr localhost:6379 dbc on >> "$LOG_FILE" 2>&1 || log "  DBC on failed"

  # Back off, capped, with a heartbeat: sleep in 5s slices and log each so
  # trampoline.log mtime stays fresh and the stall watchdog never false-trips
  # during a legitimate backoff.
  case $ROUND in
    1) BACKOFF=5;;
    2) BACKOFF=15;;
    3) BACKOFF=30;;
    *) BACKOFF=60;;
  esac
  log "  backing off ${BACKOFF}s before round $((ROUND + 1))..."
  SLEPT=0
  while [ $SLEPT -lt $BACKOFF ]; do
    sleep 5
    SLEPT=$((SLEPT + 5))
    log "  ...backoff ${SLEPT}/${BACKOFF}s"
  done
done

if [ "$DBC_FLASH_DONE" != "yes" ]; then
  # All retryable avenues exhausted (attempt cap or wall-clock budget).
  # Surface the failure via the terminal fail() as before, carrying the best
  # message we classified from the last round.
  fail "$ROUND_FAIL_MSG"
fi

# Flash done — advance to phase 2 (FL/FR filled, RR breathing). onboot.sh
# reads PHASE_FILE after the MDB reboot and re-lights the same segments
# before continuing to phase 3.
set_progress_phase 2

# V3 happy path: while STILL in UMS/host mode (DBC exposed as $DBC_DEV), grow
# the DBC data partition + fs and copy tiles directly, so the DBC boots once
# already-complete — no MDB reboot, no onboot HTTP tile push. If V3 fails for
# ANY reason (tools missing, partition not found, grow/mount/copy failed) we
# fall through to the proven onboot.sh + reboot path below, unchanged.
step_begin "Step 8a: grow DBC data + copy tiles over UMS (V3)"
if grow_and_populate_dbc "$DBC_DEV"; then
  log "DBC complete via UMS (V3); no MDB reboot, no onboot tile push needed"
  step_end
  # Power the DBC on so its dashboard comes up = done. The DBC's own first-boot
  # grow now no-ops (already grown). Mirror the clean-success LED sequence used
  # by the "DBC already at target" early-exit above.
  log "  syncing..."
  sync
  if ! restore_gadget; then
    gadget_rescue_start
  fi
  trampoline_watchdog_stop
  log "  powering DBC on..."
  lsc --redis-addr localhost:6379 dbc on 2>/dev/null || true
  echo "success" > "$STATUS_FILE"
  cat "$LOG_FILE" >> "$STATUS_FILE"
  signal_progress_off
  bootled_guard_stop
  bootled_blink_green
  exit 0
fi
log "V3 grow/tiles failed or unavailable; falling back to onboot tile push + MDB reboot"
step_end

# Step 8: Sync, power off DBC, write onboot script, reboot MDB
step_begin "Step 8: post-flash cleanup"

# Power off the DBC cleanly. Historically we did off-wait → on-wait →
# off-wait here to "let the DBC do its first boot / partition resize"
# while the MDB was still up — but onboot.sh re-powers the DBC and
# already has a stable-wait loop that absorbs the resize-induced reboot,
# so doing it twice was just ~60–90 s of wall-clock time the user spent
# staring at empty blinkers. Skip the on-wait; let onboot.sh's loop
# handle first-boot.
log "  syncing..."
sync
log "  turning off DBC..."
lsc --redis-addr localhost:6379 dbc off-wait 2>/dev/null || true

# Write /data/onboot.sh on MDB — runs automatically on next boot via
# librescoot-onboot.service (ConditionPathExists=/data/onboot.sh). The
# onboot.sh path itself is fixed by the systemd unit and can't move; all
# other state we touch lives under /data/installer/ so a single rm -rf
# at finish cleans up after us.
if [ -f /data/onboot.sh ]; then
  log "  backing up existing /data/onboot.sh to $INSTALLER_DIR/onboot.sh.bak"
  cp /data/onboot.sh "$INSTALLER_DIR/onboot.sh.bak"
fi
log "  writing /data/onboot.sh for post-reboot tile installation..."
cat > /data/onboot.sh << 'ONBOOT'
#!/bin/sh
# Auto-generated by installer trampoline — runs once on MDB boot
INSTALLER_DIR="/data/installer"
LOG="$INSTALLER_DIR/trampoline.log"
DBC_IP="192.168.7.2"
STATUS_FILE="$INSTALLER_DIR/trampoline-status"
PHASE_FILE="$INSTALLER_DIR/trampoline-phase"
mkdir -p "$INSTALLER_DIR"

log() { echo "$(date '+%H:%M:%S') $1" >> "$LOG"; }
# Log all errors, always: every command's stderr appends to the log.
exec 2>>"$LOG"
dbc_ssh() { local t=0; while [ $t -lt 3 ]; do ssh -y -y root@$DBC_IP "$@" && return 0; t=$((t+1)); sleep 3; done; return 1; }
dbc_scp() { local t=0; while [ $t -lt 3 ]; do scp "$@" && return 0; t=$((t+1)); sleep 3; done; return 1; }

# Re-light the blinker progress bar FIRST, before the slower service stops
# and LP5562 init below, so the bar returns as early as possible after the
# MDB reboot instead of staying dark until the tail of onboot. Phase is
# whatever the pre-reboot half persisted to $PHASE_FILE (typically 2 =
# FL/FR filled, RR breathing); phase 4 = all-done is set at success below.
PHASE="$(cat "$PHASE_FILE" 2>/dev/null || echo 2)"
case "$PHASE" in 0|1|2|3|4) :;; *) PHASE=2 ;; esac
BLINKER_LEDS="3 7 4 6"
DIM_DUTY=150
PROGRESS_BREATHE_PID=""
relight_progress() {
  local phase="$1"
  [ "$phase" -lt 0 ] && phase=0
  [ "$phase" -gt 4 ] && phase=4
  echo "$phase" > "$PHASE_FILE" 2>/dev/null
  [ -n "$PROGRESS_BREATHE_PID" ] && kill $PROGRESS_BREATHE_PID 2>/dev/null
  PROGRESS_BREATHE_PID=""
  local i=0
  for l in $BLINKER_LEDS; do
    if [ $i -lt $phase ]; then
      /usr/bin/ioctl /dev/pwm_led$l 0x00007549 -v 1 2>/dev/null
      /usr/bin/ioctl /dev/pwm_led$l 0x0000754A -v $DIM_DUTY 2>/dev/null
    elif [ $i -eq $phase ] && [ $phase -lt 4 ]; then
      /usr/bin/ioctl /dev/pwm_led$l 0x00007549 -v 1 2>/dev/null
      (while true; do
        /usr/bin/ioctl /dev/pwm_led$l 0x00007545 -v 4 2>/dev/null; sleep 3
        /usr/bin/ioctl /dev/pwm_led$l 0x00007545 -v 9 2>/dev/null; sleep 3
      done) &
      PROGRESS_BREATHE_PID=$!
    else
      /usr/bin/ioctl /dev/pwm_led$l 0x0000754A -v 0 2>/dev/null
      /usr/bin/ioctl /dev/pwm_led$l 0x00007549 -v 0 2>/dev/null
    fi
    i=$((i + 1))
  done
}
log "Onboot: relighting progress phase=$PHASE"
relight_progress "$PHASE"

log "Onboot: post-reboot DBC tile installation"

# Stop+mask keycard / bluetooth / ums services so they can't race us on the
# LP5562 i2c bus (keycard), fire a phone-triggered unlock through the nRF52
# (bluetooth), or grab the OTG UDC (ums). The trampoline already masked them
# before the flash, but re-asserting here is cheap insurance against weird
# boot orderings.
systemctl stop librescoot-keycard keycard-service 2>/dev/null || true
systemctl mask librescoot-keycard keycard-service 2>/dev/null || true
systemctl stop librescoot-bluetooth 2>/dev/null || true
systemctl mask librescoot-bluetooth 2>/dev/null || true
systemctl stop librescoot-ums 2>/dev/null || true
systemctl mask librescoot-ums 2>/dev/null || true

# Initialize the LP5562 (RAG boot LED on i2c-2 @ 0x30) for direct PWM
# control. After this, registers 0x02/0x03/0x04 are amber/green/red PWM.
i2cset -f -y 2 0x30 0x0D 0xFF 2>/dev/null
i2cset -f -y 2 0x30 0x01 0x3F 2>/dev/null
i2cset -f -y 2 0x30 0x70 0x00 2>/dev/null
i2cset -f -y 2 0x30 0x08 0x61 2>/dev/null
i2cset -f -y 2 0x30 0x00 0xC0 2>/dev/null
i2cset -f -y 2 0x30 0x05 0xAF 2>/dev/null
i2cset -f -y 2 0x30 0x06 0xAF 2>/dev/null
i2cset -f -y 2 0x30 0x07 0xAF 2>/dev/null

# Smoothly fade the whole progress bar out. Used once at all-done so the
# blinkers release with a soft ramp instead of sitting lit. Ramp starts at
# DIM_DUTY (150) and steps down to 0 over ~1s, then deactivates each channel.
fade_progress_off() {
  [ -n "$PROGRESS_BREATHE_PID" ] && kill $PROGRESS_BREATHE_PID 2>/dev/null
  PROGRESS_BREATHE_PID=""
  for l in $BLINKER_LEDS; do
    /usr/bin/ioctl /dev/pwm_led$l 0x00007549 -v 1 2>/dev/null
  done
  for d in 150 110 75 48 28 14 6 0; do
    for l in $BLINKER_LEDS; do
      /usr/bin/ioctl /dev/pwm_led$l 0x0000754A -v $d 2>/dev/null
    done
    sleep 0.12
  done
  for l in $BLINKER_LEDS; do
    /usr/bin/ioctl /dev/pwm_led$l 0x00007549 -v 0 2>/dev/null
  done
}

# Boot LED + hazards helpers. Spawned via systemd-run so they run in their
# own transient unit under system.slice — librescoot-onboot.service is
# Type=oneshot with KillMode=control-group, so once /data/onboot.sh exits,
# anything still in its cgroup gets killed. setsid alone doesn't escape
# that. Stopped via systemctl stop.
BOOTLED_BLINK_UNIT="librescoot-bootled-blink"
HAZARDS_UNIT="librescoot-bootled-hazards"
bootled_blink_stop() {
  systemctl stop "${BOOTLED_BLINK_UNIT}.service" 2>/dev/null
  if [ -f /data/bootled-blink.pid ]; then
    pid="$(cat /data/bootled-blink.pid 2>/dev/null)"
    if [ -n "$pid" ]; then
      kill -- -"$pid" 2>/dev/null
      kill "$pid" 2>/dev/null
    fi
    rm -f /data/bootled-blink.pid
  fi
}
bootled_blink_green() {
  bootled_blink_stop
  systemd-run --unit="$BOOTLED_BLINK_UNIT" --collect --quiet --slice=system.slice /bin/sh -c '
    while true; do
      i2cset -f -y 2 0x30 0x02 0x00 2>/dev/null
      i2cset -f -y 2 0x30 0x03 0xFF 2>/dev/null
      i2cset -f -y 2 0x30 0x04 0x00 2>/dev/null
      sleep 0.4
      i2cset -f -y 2 0x30 0x02 0x00 2>/dev/null
      i2cset -f -y 2 0x30 0x03 0x00 2>/dev/null
      i2cset -f -y 2 0x30 0x04 0x00 2>/dev/null
      sleep 0.4
    done
  '
}
bootled_blink_red() {
  bootled_blink_stop
  systemd-run --unit="$BOOTLED_BLINK_UNIT" --collect --quiet --slice=system.slice /bin/sh -c '
    while true; do
      i2cset -f -y 2 0x30 0x02 0x00 2>/dev/null
      i2cset -f -y 2 0x30 0x03 0x00 2>/dev/null
      i2cset -f -y 2 0x30 0x04 0xFF 2>/dev/null
      sleep 0.4
      i2cset -f -y 2 0x30 0x02 0x00 2>/dev/null
      i2cset -f -y 2 0x30 0x03 0x00 2>/dev/null
      i2cset -f -y 2 0x30 0x04 0x00 2>/dev/null
      sleep 0.4
    done
  '
}
hazards_30s() {
  systemctl stop "${HAZARDS_UNIT}.service" 2>/dev/null
  systemd-run --unit="$HAZARDS_UNIT" --collect --quiet --slice=system.slice /bin/sh -c '
    DIM=2000
    for ch in 3 4 6 7; do
      /usr/bin/ioctl /dev/pwm_led$ch 0x00007549 -v 1 2>/dev/null
    done
    end=$(( $(date +%s) + 30 ))
    while [ "$(date +%s)" -lt "$end" ]; do
      for ch in 3 4 6 7; do
        /usr/bin/ioctl /dev/pwm_led$ch 0x0000754A -v $DIM 2>/dev/null
      done
      sleep 0.5
      for ch in 3 4 6 7; do
        /usr/bin/ioctl /dev/pwm_led$ch 0x0000754A -v 0 2>/dev/null
      done
      sleep 0.5
    done
    for ch in 3 4 6 7; do
      /usr/bin/ioctl /dev/pwm_led$ch 0x00007549 -v 0 2>/dev/null
    done
  '
}

# Re-arm the boot-LED guard. vehicle-service can stomp the LP5562 when
# it drives blinker brightness; the guard re-asserts amber every 2s.
# Stopped explicitly before bootled_blink_{green,red} at the end.
BOOTLED_GUARD_UNIT="librescoot-bootled-guard"
bootled_guard_start() {
  systemctl stop "${BOOTLED_GUARD_UNIT}.service" 2>/dev/null
  systemd-run --unit="$BOOTLED_GUARD_UNIT" --collect --quiet --slice=system.slice /bin/sh -c '
    while true; do
      i2cset -f -y 2 0x30 0x02 0xFF 2>/dev/null
      i2cset -f -y 2 0x30 0x03 0x00 2>/dev/null
      i2cset -f -y 2 0x30 0x04 0x00 2>/dev/null
      sleep 2
    done
  '
}
bootled_guard_stop() {
  systemctl stop "${BOOTLED_GUARD_UNIT}.service" 2>/dev/null
}

# Image write succeeded but we're not done — tile uploads to the DBC still
# need to happen over the same USB link. Stay amber so the user knows the
# MDB is still talking to the DBC and does NOT yank the cable. Green blink
# (= "safe to disconnect USB from DBC and reconnect laptop") is started in
# the success branch at the bottom of this script, after DBC power-off.
# Set amber directly — onboot.sh has no bootled() helper, only the guard.
i2cset -f -y 2 0x30 0x02 0xFF 2>/dev/null
i2cset -f -y 2 0x30 0x03 0x00 2>/dev/null
i2cset -f -y 2 0x30 0x04 0x00 2>/dev/null
bootled_guard_start

# Restore original onboot.sh if backed up, otherwise delete ourselves
if [ -f "$INSTALLER_DIR/onboot.sh.bak" ]; then
  mv "$INSTALLER_DIR/onboot.sh.bak" /data/onboot.sh
else
  rm -f /data/onboot.sh
fi

# Brief wait for MDB services to settle — historically 20 s. Most of that
# was just defensive; redis is ready within a few seconds of MDB boot.
# Poll redis directly so we wait exactly as long as we have to.
log "  waiting for MDB redis..."
WAITED=0
while [ $WAITED -lt 30 ]; do
  redis-cli -h localhost ping >/dev/null 2>&1 && break
  WAITED=$((WAITED + 1))
  sleep 1
done
log "  redis ready after ${WAITED}s"

# Keep trying dbc on-wait until it succeeds — DBC may restart several times
log "  powering on DBC (may take multiple attempts)..."
ATTEMPTS=0
while [ $ATTEMPTS -lt 5 ]; do
  ATTEMPTS=$((ATTEMPTS + 1))
  log "  dbc on-wait attempt $ATTEMPTS..."
  lsc --redis-addr localhost:6379 dbc on-wait 2>/dev/null && break
  log "  attempt $ATTEMPTS failed, retrying..."
  sleep 5
done

# Wait for DBC to be stable. Requires 10s of consecutive ping success.
# Was 20s — the resize-induced reboot is the only thing that breaks the
# ping stream, and the in-loop handler below already covers that. 10s of
# stable pings is plenty to confirm we're past the resize.
log "  waiting for DBC to be stable (10s consecutive ping)..."
STABLE=0
ELAPSED=0
while [ $STABLE -lt 10 ] && [ $ELAPSED -lt 300 ]; do
  if ping -c 1 -W 2 $DBC_IP >/dev/null 2>&1; then
    STABLE=$((STABLE + 1))
  else
    if [ $STABLE -gt 0 ]; then
      log "  ping dropped after ${STABLE}s stable — DBC rebooting, waiting 5s then turning on..."
      sleep 5
      lsc --redis-addr localhost:6379 dbc on 2>/dev/null || true
    fi
    STABLE=0
  fi
  ELAPSED=$((ELAPSED + 2))
  sleep 1
done
log "  DBC stable after ${ELAPSED}s (stable_count=$STABLE)"

# Stay on phase 2 (BR breathing = "MDB & DBC restart") through the SSH wait.
# Re-establishing the DBC connection is part of the restart, not the copy, so
# advancing to phase 3 (BL = "maps") happens only once the actual upload
# starts. That keeps the two distinguishable: a BR blinker stuck breathing
# means the DBC never came back (USB/boot issue), a stuck BL means the data
# copy itself is slow.
# Wait for SSH, re-asserting DBC power as we go. A freshly flashed DBC
# reboots once on first boot to apply its boot-partition (u-boot) update,
# and that update's `complete-dbc` makes vehicle-service power the DBC off
# if the vehicle is in standby. Either way the DBC drops off the bus. So
# whenever it's unpingable, force it back on (`lsc dbc on`) — the boot
# update only fires once, so it comes up and stays up. Poll, not a blind
# wait: breaks the instant the DBC answers. Skipping tiles = no offline maps.
log "  waiting for DBC SSH..."
ELAPSED=0
while [ $ELAPSED -lt 300 ]; do
  ssh -y -y root@$DBC_IP 'echo ok' >/dev/null && break
  if ! ping -c 1 -W 2 $DBC_IP >/dev/null 2>&1 && [ $((ELAPSED % 20)) -eq 0 ]; then
    log "  DBC unreachable — re-asserting power (lsc dbc on)"
    lsc --redis-addr localhost:6379 dbc on >/dev/null 2>&1 || true
  fi
  ELAPSED=$((ELAPSED + 5))
  sleep 5
done

if [ $ELAPSED -ge 300 ]; then
  log "WARNING: DBC not reachable after 300s — skipping tiles"
  echo "success" > "$STATUS_FILE"
  cat "$LOG" >> "$STATUS_FILE"
  lsc --redis-addr localhost:6379 dbc off 2>/dev/null || true
  # No tiles to do, jump straight to all-done.
  relight_progress 4
  bootled_guard_stop
  bootled_blink_green
  # Let the completed bar register, then fade it out so it doesn't sit lit.
  sleep 1
  fade_progress_off
  systemctl unmask librescoot-keycard keycard-service 2>/dev/null || true
  systemctl unmask librescoot-bluetooth 2>/dev/null || true
  systemctl start librescoot-bluetooth 2>/dev/null || true
  systemctl unmask librescoot-ums 2>/dev/null || true
  systemctl start librescoot-ums 2>/dev/null || true
  exit 0
fi
log "  DBC reachable"
ONBOOT

# Append tile installation commands with actual paths
if [ "$INSTALL_TILES" = "true" ]; then
  cat >> /data/onboot.sh << TILES
# DBC connection is up — now advance to phase 3 (BL breathing = "maps"). From
# here a slow BL blinker means the tile copy itself is slow, not a connection
# problem.
relight_progress 3
dbc_ssh "mkdir -p /data/maps /data/valhalla" || log "WARNING: mkdir failed"

# Detect whether DBC has data-server running (new firmware) or needs the
# Python fallback (older firmware). data-server identifies itself via the
# Server response header. Both servers are rooted at /data, so the URL
# layout is identical either way.
DBC_PYTHON_STARTED="no"
if curl -sSI "http://\$DBC_IP:8080/" 2>/dev/null | grep -qi "^Server: librescoot-data-server"; then
  log "  DBC has data-server running"
else
  log "  DBC lacks data-server, starting Python fallback..."
  dbc_ssh 'cat > /tmp/upload_srv.py << "PYEOF"
import http.server
import os

class H(http.server.BaseHTTPRequestHandler):
    def do_PUT(self):
        p = "/data" + self.path
        os.makedirs(os.path.dirname(p), exist_ok=True)
        l = int(self.headers["Content-Length"])
        with open(p, "wb") as f:
            r = l
            while r > 0:
                c = self.rfile.read(min(65536, r))
                if not c:
                    break
                f.write(c)
                r -= len(c)
        self.send_response(200)
        self.end_headers()

    def log_message(self, *a):
        pass

with open("/tmp/upload_srv.pid", "w") as pf:
    pf.write(str(os.getpid()))

http.server.HTTPServer(("0.0.0.0", 8080), H).serve_forever()
PYEOF
nohup python3 /tmp/upload_srv.py > /dev/null 2>&1 &' && DBC_PYTHON_STARTED="yes" || log "WARNING: failed to start DBC upload server"
  sleep 2
fi

TILE_ERRORS=0

upload_tile() {
  local src="\$1" dst="\$2" name="\$3"
  local attempt=0
  while [ \$attempt -lt 3 ]; do
    attempt=\$((attempt + 1))
    log "  uploading \$name (attempt \$attempt/3)..."
    if curl -T "\$src" "http://\$DBC_IP:8080\$dst" 2>>"\$LOG"; then
      log "  \$name done"
      return 0
    fi
    log "  \$name upload failed, restarting DBC..."
    lsc --redis-addr localhost:6379 dbc on-wait 2>/dev/null || true
    sleep 5
  done
  log "ERROR: \$name upload failed after 3 attempts"
  return 1
}

if [ -f "$OSM_TILES_FILE" ]; then
  upload_tile "$OSM_TILES_FILE" "/maps/map.mbtiles" "display tiles" || TILE_ERRORS=\$((TILE_ERRORS + 1))
fi
if [ -f "$VALHALLA_TILES_FILE" ]; then
  if upload_tile "$VALHALLA_TILES_FILE" "/valhalla/tiles.tar" "routing tiles"; then
    dbc_ssh "systemctl restart valhalla" 2>/dev/null || true
  else
    TILE_ERRORS=\$((TILE_ERRORS + 1))
  fi
fi

# Stop DBC Python upload server if we started one
if [ "\$DBC_PYTHON_STARTED" = "yes" ]; then
  dbc_ssh 'kill \$(cat /tmp/upload_srv.pid 2>/dev/null) 2>/dev/null; rm -f /tmp/upload_srv.pid /tmp/upload_srv.py' || true
fi
TILES
fi

cat >> /data/onboot.sh << 'ONBOOT_END'
# Turn off DBC
lsc --redis-addr localhost:6379 dbc off 2>/dev/null || true

if [ "${TILE_ERRORS:-0}" -gt 0 ]; then
  log "=========================================="
  log "Installation FAILED — $TILE_ERRORS tile upload(s) failed"
  log "=========================================="
  echo "error: $TILE_ERRORS tile upload(s) failed" > "$STATUS_FILE"
  cat "$LOG" >> "$STATUS_FILE"
  # Switch the boot LED from solid amber (set at the top of onboot.sh) to
  # blinking red, and add hazards (capped at 30s so an abandoned error
  # doesn't drain the battery). Both indicators stop on installer reconnect
  # via /data/installer/stop-error-signals.sh. The guard loop must stop
  # first or it'll fight the red blink every 2s.
  bootled_guard_stop
  bootled_blink_red
  hazards_30s
else
  log "=========================================="
  log "Installation complete - SUCCESS"
  log "=========================================="
  echo "success" > "$STATUS_FILE"
  cat "$LOG" >> "$STATUS_FILE"
  # All MDB<->DBC work is done (image flashed, tiles uploaded, DBC powered
  # off). Now and only now signal the user it's safe to swap the MDB's
  # single USB port back to the laptop.
  # Phase 4: all four segments filled, no active breathing.
  relight_progress 4
  # Stop the LED guard before starting the green blink, otherwise the
  # guard re-asserts amber every 2s and we get an ugly amber/green flicker.
  bootled_guard_stop
  bootled_blink_green
  # Let the completed bar register, then fade it out so it doesn't sit lit.
  sleep 1
  fade_progress_off
  # Unmask keycard-service. The installer's keycardSetup phase will start
  # it explicitly. We deliberately do NOT start it now: a freshly flashed
  # device with no master would auto-enter master-learning and silently
  # teach in whatever card the user taps before they reach explicit setup.
  systemctl unmask librescoot-keycard keycard-service 2>/dev/null || true
  # Unmask + start bluetooth — the installer's bluetoothPairing phase
  # needs it running. No equivalent "wait for explicit start" concern.
  systemctl unmask librescoot-bluetooth 2>/dev/null || true
  systemctl start librescoot-bluetooth 2>/dev/null || true
  # Re-enable UMS now that all USB-host work on the OTG UDC is done.
  systemctl unmask librescoot-ums 2>/dev/null || true
  systemctl start librescoot-ums 2>/dev/null || true
fi
ONBOOT_END
chmod +x /data/onboot.sh
log "  onboot.sh written"

# Mark as rebooting (installer checks for "success" or "rebooting")
echo "rebooting" > "$STATUS_FILE"
cat "$LOG_FILE" >> "$STATUS_FILE"

step_end  # close step 8
log "Total trampoline wall-clock: $(($(date +%s) - SCRIPT_T0))s"

# Phase 2 (FL/FR filled, RR breathing) is now the user-visible "flash
# done, MDB rebooting" cue — onboot.sh reads PHASE_FILE and re-lights
# the same state after the reboot, so the progress bar looks continuous
# across MDB reboot. bootled_guard is left running so amber stays solid
# right up until systemd-shutdown tears down our cgroup.
breathe_stop
[ -n "$JOURNAL_PID" ] && kill $JOURNAL_PID 2>/dev/null
log "  rebooting MDB..."
reboot

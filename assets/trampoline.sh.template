#!/bin/sh
# Librescoot DBC Trampoline Script
# Generated by installer - runs autonomously on MDB

INSTALLER_DIR="/data/installer"
# The phases the board runs on its own. /data/onboot.sh is a coordinator the
# installer put there before any of this ran; it executes the numbered phases
# it finds here, in order, and retires itself once none are left. Nothing in
# this script writes /data/onboot.sh.
SCRIPTS_DIR="$INSTALLER_DIR/scripts"
STATUS_FILE="$INSTALLER_DIR/trampoline-status"
LOG_FILE="$INSTALLER_DIR/trampoline.log"
PHASE_FILE="$INSTALLER_DIR/trampoline-phase"
RUN_ID="$(cat "$INSTALLER_DIR/run-id" 2>/dev/null)"
RUN_HISTORY_DIR="$INSTALLER_DIR/history"
RUN_STATE_FILE="$INSTALLER_DIR/run-state"
MODE="{{MODE}}"                        # flash = write the stage-0 image first, upgrade = artifact only
DBC_IMAGE="{{DBC_IMAGE_PATH}}"
DBC_MENDER="{{DBC_MENDER_PATH}}"       # .mender staged on the MDB, empty when the DBC gets no artifact
DBC_TARGET="{{DBC_TARGET_VERSION}}"    # VERSION_ID the DBC has to report once the artifact is live
# Autonomous finish. When true, onboot does the work the installer's finish
# phase would otherwise do over the laptop link, so the user never has to plug
# back in on the happy path. Everything it needs is known before the cable swap.
FINISH_ON_DEVICE="{{FINISH_ON_DEVICE}}"   # true = do not wait for the laptop
MDB_ACTION="{{MDB_ACTION}}"               # upgrade | cleanInstall | fullImage | leave
MDB_TARGET="{{MDB_TARGET_VERSION}}"       # VERSION_ID the MDB should be on, for the record
FINISH_LANGUAGE="{{FINISH_LANGUAGE}}"     # dashboard.language to persist, empty to skip
FINISH_CHANNEL="{{FINISH_CHANNEL}}"       # lsc ota channel to persist, empty to skip
DBC_BMAP="${DBC_IMAGE%.sdimg.gz}.sdimg.bmap"
DBC_IP="192.168.7.2"
BOOT_AREA_BLOCKS=6
INSTALL_TILES="{{INSTALL_TILES}}"
OSM_TILES_FILE="{{OSM_TILES_FILE}}"
VALHALLA_TILES_FILE="{{VALHALLA_TILES_FILE}}"
TILES_REGION="{{TILES_REGION}}"
TILES_REGION_NAME="{{TILES_REGION_NAME}}"

mkdir -p "$INSTALLER_DIR"
# A previous run's DBC version must not survive into this one's status file:
# the second layer writes it again only after it really installed an artifact,
# so a leftover would report a version this run never verified.
rm -f "$INSTALLER_DIR/dbc-version"

log() { echo "$(date '+%H:%M:%S') $1" >> "$LOG_FILE"; }

write_run_state() {
  local stage="$1"
  local result="${2:-running}"
  local finish="${3:-pending}"
  local history_tmp="$RUN_HISTORY_DIR/$RUN_ID/.record.tmp"
  local current_tmp="$INSTALLER_DIR/.run-state.$RUN_ID.tmp"
  mkdir -p "$RUN_HISTORY_DIR/$RUN_ID"
  {
    echo "run-id: $RUN_ID"
    echo "actor: trampoline"
    echo "stage: $stage"
    echo "result: $result"
    echo "finish: $finish"
    echo "updated: $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  } > "$history_tmp" &&
    mv -f "$history_tmp" "$RUN_HISTORY_DIR/$RUN_ID/record" &&
    cp "$RUN_HISTORY_DIR/$RUN_ID/record" "$current_tmp" &&
    mv -f "$current_tmp" "$RUN_STATE_FILE"
}

write_status() {
  local verdict="$1"
  shift
  local status_tmp="$STATUS_FILE.$RUN_ID.tmp"
  local result="running"
  mkdir -p "$INSTALLER_DIR"
  case "$verdict" in
    success*) result="success" ;;
    error*) result="error" ;;
  esac
  {
    echo "$verdict"
    echo "run-id: $RUN_ID"
    echo "finish: pending"
    [ -n "$STEP_LABEL" ] && echo "stage: $STEP_LABEL"
    for field in "$@"; do echo "$field"; done
    cat "$LOG_FILE" 2>/dev/null
  } > "$status_tmp" && mv -f "$status_tmp" "$STATUS_FILE"
  write_run_state "${STEP_LABEL:-trampoline}" "$result" pending
}

# Per-step elapsed-time bookkeeping. SCRIPT_T0 is the wall-clock start;
# step_begin/step_end log "<label> took Ns" so post-mortem time accounting
# is one grep away. SECONDS resets per-step.
SCRIPT_T0=$(date +%s)
STEP_LABEL=""
STEP_T0=0
step_begin() {
  STEP_LABEL="$1"
  STEP_T0=$(date +%s)
  log ">>> $STEP_LABEL (T+$((STEP_T0 - SCRIPT_T0))s)"
  write_run_state "$STEP_LABEL"
}
step_end() {
  local now=$(date +%s)
  [ -n "$STEP_LABEL" ] && log "<<< $STEP_LABEL took $((now - STEP_T0))s"
  STEP_LABEL=""
}

# --- Signalling ---
# The blinker bar, the front light, the dashboard LED and the hazards all live
# in one file, staged beside the phases so the trampoline, every phase, the
# coordinator and the rescue drive them the same way. They used to be defined
# here and again inside the heredoc that writes the dashboard phase, with a
# test whose whole job was noticing when the two drifted apart.
. "$SCRIPTS_DIR/signal.sh" || { echo "missing $SCRIPTS_DIR/signal.sh" >&2; exit 1; }

# --- DBC device control ---
# dbc_ssh, wait_dbc_ssh and the dashboard power helpers, same story as the
# signalling above: one copy, staged beside the phases, sourced here and again
# from inside the heredoc that writes the dashboard phase.
. "$SCRIPTS_DIR/device.sh" || { echo "missing $SCRIPTS_DIR/device.sh" >&2; exit 1; }

# Where the chipidea role-switch file lives depends on the MDB kernel:
# linux-imx 5.4 (pre-1.2.0 images) creates the chipidea debugfs dir at the
# debugfs root, linux-fslc 6.12 (wrynose) under usb/. Both kernels also
# expose the `role` sysfs device attribute, which needs no debugfs at all,
# as a final fallback. The embedded rescue scripts re-probe on their own
# because they run standalone (single-quoted systemd-run / staged files).
for ROLE_PATH in /sys/kernel/debug/ci_hdrc.0/role \
                 /sys/kernel/debug/usb/ci_hdrc.0/role \
                 /sys/bus/platform/devices/ci_hdrc.0/role; do
  [ -f "$ROLE_PATH" ] && break
done

# Chipidea role writes can also BLOCK (not just EBUSY) if the unbind
# wedges on a dying USB device. A blocked write would freeze whoever
# called it, so give every role write a hard 15s ceiling where a timeout
# binary exists (busybox >= 1.30 and coreutils both take SECS PROG).
role_write() {
  if command -v timeout >/dev/null 2>&1; then
    timeout 15 sh -c "echo $1 > $ROLE_PATH" 2>/dev/null
  else
    sh -c "echo $1 > $ROLE_PATH" 2>/dev/null
  fi
}

usb0_up() {
  ip addr replace 192.168.7.1/24 dev usb0 2>/dev/null || true
  ip link set usb0 up 2>/dev/null || true
}

usb0_is_up() {
  ip -4 addr show usb0 2>/dev/null | grep -q '192\.168\.7\.1'
}

# Restore USB gadget (RNDIS) mode so the installer can reach us again.
# The chipidea role write can fail (EBUSY) while a device still occupies
# the host port, and the old single-shot version silenced that, leaving
# the MDB stuck in host mode with the laptop unable to see it. So:
# verify the role actually flipped and usb0 came up, retrying a few
# times. Returns 0 only on confirmed gadget mode.
# Force the host controller to look for a device again.
#
# Switching to host with the cable already seated gives the port no connect
# event, so the controller never enumerates what is sitting on it. Unbinding
# and rebinding re-initialises it and makes it enumerate whatever is attached,
# which is what physically replugging the cable achieves.
usb_host_rescan() {
  local drv=/sys/bus/platform/drivers/ci_hdrc
  [ -d "$drv" ] || { log "  no ci_hdrc driver directory, cannot rescan"; return 1; }
  log "  rebinding the USB host controller to force enumeration"
  echo ci_hdrc.0 > "$drv/unbind" 2>/dev/null
  sleep 2
  echo ci_hdrc.0 > "$drv/bind" 2>/dev/null
  sleep 3
  role_write host || true
  sleep 2
  log "  rescan done, role=$(cat "$ROLE_PATH" 2>/dev/null) $(lsusb 2>/dev/null | grep 0525 || echo 'still no 0525 device')"
}

restore_gadget() {
  log "Restoring gadget mode..."
  if [ "$(cat "$ROLE_PATH" 2>/dev/null)" = "gadget" ] && usb0_is_up; then
    log "  already in gadget mode with usb0 up"
    return 0
  fi
  local attempt=0
  while [ $attempt -lt 5 ]; do
    attempt=$((attempt + 1))
    rmmod g_ether 2>/dev/null || true
    sleep 1
    role_write gadget || true
    sleep 1
    modprobe g_ether 2>/dev/null || true
    sleep 1
    usb0_up
    sleep 1
    local role="$(cat "$ROLE_PATH" 2>/dev/null)"
    if [ "$role" = "gadget" ] && usb0_is_up; then
      log "  gadget restored (attempt $attempt), UDC: $(cat /sys/class/udc/ci_hdrc.0/state 2>/dev/null)"
      return 0
    fi
    log "  gadget restore attempt $attempt failed (role=$role), retrying..."
    sleep 2
  done
  log "  gadget restore FAILED after $attempt attempts"
  return 1
}

# Detached gadget-mode rescue, spawned from fail() when restore_gadget()
# could not confirm gadget mode. Keeps re-attempting the role flip; the
# write that fails while the DBC still occupies the host port succeeds
# once the user swaps the cable. Once gadget mode + usb0 are up it only
# watches, exiting when the laptop enumerates us. If gadget mode still
# can't be established after 240s, it reboots the MDB: a normal boot
# always comes back in gadget mode, so the reboot is guaranteed recovery.
# Before rebooting it drops every phase this run queued and stages
# rescue-onboot.sh as the 00-rescue phase, so nothing carries on from a state
# the rescue exists to abandon. Every phase, not just the dashboard one: the
# rest would reboot onto a new image and unlock a scooter whose dashboard was
# never flashed.
# systemd-run for the same cgroup-survival reason as the LED units;
# stop-error-signals.sh stops it if it's still around on reconnect.
GADGET_RESCUE_UNIT="librescoot-gadget-rescue"
gadget_rescue_start() {
  systemctl stop "${GADGET_RESCUE_UNIT}.service" 2>/dev/null
  systemd-run --unit="$GADGET_RESCUE_UNIT" --collect --quiet --slice=system.slice /bin/sh -c '
    LOG=/data/installer/trampoline.log
    DEADLINE=$(( $(date +%s) + 240 ))
    for RP in /sys/kernel/debug/ci_hdrc.0/role \
              /sys/kernel/debug/usb/ci_hdrc.0/role \
              /sys/bus/platform/devices/ci_hdrc.0/role; do
      [ -f "$RP" ] && break
    done
    while :; do
      ROLE="$(cat "$RP" 2>/dev/null)"
      if [ "$ROLE" = "gadget" ] && ip -4 addr show usb0 2>/dev/null | grep -q "192\.168\.7\.1"; then
        if cat /sys/class/udc/ci_hdrc.0/state 2>/dev/null | grep -q configured; then
          echo "$(date "+%H:%M:%S") gadget-rescue: laptop enumerated, done" >> "$LOG"
          exit 0
        fi
        sleep 2
      else
        echo "$(date "+%H:%M:%S") gadget-rescue: role=$ROLE, retrying gadget restore" >> "$LOG"
        rmmod g_ether 2>/dev/null
        sleep 1
        if command -v timeout >/dev/null 2>&1; then
          timeout 15 sh -c "echo gadget > $RP" 2>/dev/null
        else
          echo gadget > "$RP" 2>/dev/null
        fi
        sleep 1
        modprobe g_ether 2>/dev/null
        sleep 1
        ip addr replace 192.168.7.1/24 dev usb0 2>/dev/null
        ip link set usb0 up 2>/dev/null
        sleep 2
      fi
      if [ "$(date +%s)" -ge "$DEADLINE" ]; then
        ROLE="$(cat "$RP" 2>/dev/null)"
        if [ "$ROLE" = "gadget" ]; then
          echo "$(date "+%H:%M:%S") gadget-rescue: gadget up, laptop never enumerated, leaving as-is" >> "$LOG"
          exit 0
        fi
        echo "$(date "+%H:%M:%S") gadget-rescue: gadget mode unrecoverable after 240s, rebooting MDB" >> "$LOG"
        mkdir -p /data/installer/scripts
        # Cleared before 00-rescue is staged, so the glob cannot take it too.
        # Status, phase bookkeeping and logs are left: an aborted run is the
        # one most worth reading afterwards.
        rm -f /data/installer/scripts/[0-9][0-9]-*.sh \
              /data/installer/scripts/[0-9][0-9]-*.sh.tries
        cp /data/installer/rescue-onboot.sh /data/installer/scripts/00-rescue.sh
        chmod +x /data/installer/scripts/00-rescue.sh
        sync &
        sleep 10
        reboot &
        sleep 30
        reboot -f
        exit 0
      fi
    done
  '
}

# Last-ditch watchdog for a trampoline that dies in host mode WITHOUT
# reaching fail(): OOM kill, script bug, or (most likely) the flasher
# stuck in uninterruptible sleep on a USB device that died mid-write.
# The trampoline logs constantly, so the log mtime is a free heartbeat:
# if the role is still host and the log has been silent for 15 minutes,
# the install is dead and nobody is coming to restore gadget mode.
# 15 min is sized for the slowest legitimate quiet stretch (the dd
# fallback flasher only writes to the log when it finishes). Recovery
# itself lives in the staged watchdog-recover.sh; this unit only
# detects the stall. Armed once at trampoline start (it never fires
# while the role is gadget), gone on any reboot, stopped explicitly in
# fail() so it can't race the gadget-rescue unit.
TRAMPOLINE_WATCHDOG_UNIT="librescoot-trampoline-watchdog"
trampoline_watchdog_start() {
  systemctl stop "${TRAMPOLINE_WATCHDOG_UNIT}.service" 2>/dev/null
  systemd-run --unit="$TRAMPOLINE_WATCHDOG_UNIT" --collect --quiet --slice=system.slice /bin/sh -c '
    for RP in /sys/kernel/debug/ci_hdrc.0/role \
              /sys/kernel/debug/usb/ci_hdrc.0/role \
              /sys/bus/platform/devices/ci_hdrc.0/role; do
      [ -f "$RP" ] && break
    done
    while :; do
      sleep 60
      [ "$(cat "$RP" 2>/dev/null)" = "host" ] || continue
      [ -n "$(find /data/installer/trampoline.log -mmin +15 2>/dev/null)" ] || continue
      /bin/sh /data/installer/watchdog-recover.sh
      exit 0
    done
  '
}
trampoline_watchdog_stop() {
  systemctl stop "${TRAMPOLINE_WATCHDOG_UNIT}.service" 2>/dev/null
}

# "Did the user yank the DBC cable and replace it with the laptop?"
# probe. We can't passively detect VBUS / PHY-connect from userspace on
# this i.MX6 driver, so we briefly flip to gadget mode and check the
# UDC state: if a laptop is on the other end it'll enumerate us and the
# UDC reaches "configured" within ~2 s. If yes -> fail() with a clear
# disconnect message (fail() leaves us in gadget so the installer's
# RNDIS waiter picks the device up and reads the status). If no ->
# switch back to host.
#
# SAFETY: this is disruptive - switching to gadget while DBC is mid-
# reboot from Linux back into u-boot UMS races the enumeration and can
# cost us the install. ONLY call this when we've otherwise given up
# (step 6 final timeout / step 7 retry exhaustion). Never on a periodic
# tick inside an active wait. Total wall-clock cost per call: ~8 s.
probe_for_laptop_then_restore_host() {
  log "  probing gadget mode for laptop reconnect..."
  rmmod g_ether 2>/dev/null || true
  sleep 1
  role_write gadget || true
  modprobe g_ether 2>/dev/null || true
  sleep 1
  usb0_up

  local elapsed=0
  while [ $elapsed -lt 3 ]; do
    if cat /sys/class/udc/ci_hdrc.0/state 2>/dev/null | grep -q configured; then
      log "  laptop UDC=configured - DBC was disconnected, aborting"
      fail "DBC USB disconnected during flash. Reconnect the DBC cable to the MDB and retry the install from the start."
    fi
    sleep 1
    elapsed=$((elapsed + 1))
  done

  log "  no laptop on UDC; switching back to host"
  rmmod g_ether 2>/dev/null || true
  sleep 1
  role_write host || true
  sleep 2
}

fail() {
  log "ERROR: $1"
  # Disarm what this run queued, as the rescue paths do. Left in place, the
  # owner's next power cycle runs them headless: the artifact installs and the
  # board reboots for a run that failed before it touched the dashboard.
  # Status, logs and the phase bookkeeping stay, which is what says what
  # happened. The plan record goes too: with the phases gone the coordinator
  # would otherwise report every one of them as never having run and overwrite
  # the verdict written just below.
  rm -f "$SCRIPTS_DIR"/[0-9][0-9]-*.sh "$SCRIPTS_DIR"/[0-9][0-9]-*.sh.tries \
    "$SCRIPTS_DIR/.expected"
  # journalctl -f outlives this script otherwise: it is a child of the SSH
  # session scope, not a service cgroup, so an abandoned failure keeps
  # appending to the journal file until the disk notices.
  [ -n "$JOURNAL_PID" ] && kill $JOURNAL_PID 2>/dev/null
  write_status "error: $1"
  # Status must survive a rescue reboot, so flush it early. Backgrounded:
  # a wedged USB device can hang a full sync, and the LED signals and
  # gadget restore below must still run regardless.
  sync &
  sleep 2
  # Takes the bar and the front light down, stops the amber guard, and leaves
  # the red blink and the hazards running for whoever comes back to the
  # vehicle. Both are stopped by stop-error-signals.sh on reconnect.
  signal_error
  if ! restore_gadget; then
    gadget_rescue_start
  fi
  # Watchdog stopped only after the restore attempt: if a wedged role
  # write ever blocked restore_gadget despite the timeout, the still-armed
  # watchdog stays as the backstop. No race with the rescue unit: its
  # retries write to the log, so the 15-min silence the watchdog needs
  # can never accumulate while the rescue is alive.
  trampoline_watchdog_stop
  # Indicators are detached and run until the installer reconnects via SSH
  # and stops them. Just exit cleanly here.
  exit 1
}

# Copying to the DBC goes through the same ssh dbc_ssh uses, for the same
# reason. Dropbear's scp frontend has no equivalent of -y -y (it rejects -y
# outright), so scp is the one transport here that would still abort on the
# changed key. `cat` on the far side exits 0 even when the stream was cut
# short, so the byte count is compared there before the file is moved into
# place.
dbc_put() {
  local src="$1" dst="$2" tries=0 size
  size=$(wc -c < "$src") || return 1
  while [ $tries -lt 3 ]; do
    if ssh -y -y root@$DBC_IP "cat > '$dst.part'" < "$src" &&
       ssh -y -y root@$DBC_IP "[ \"\$(wc -c < '$dst.part')\" -eq $size ] && mv '$dst.part' '$dst'"; then
      return 0
    fi
    ssh -y -y root@$DBC_IP "rm -f '$dst.part'" >/dev/null 2>&1 || true
    tries=$((tries + 1))
    log "  copy retry $tries/3..."
    sleep 3
  done
  return 1
}

# Switch MDB to USB host and probe what the DBC is showing on the bus.
# Sets DBC_ALREADY_UMS=yes if u-boot is already in `ums 0 mmc 2`.
# Calls fail() (does not return) if the DBC is in i.MX BootROM/SDP recovery
# (VID 15a2) - that's a hard-brick that requires imx_usb_loader to rescue
# and is out of scope for this installer.
# Calls fail() if neither UMS nor SDP is on the bus.
# Dashboard power (dbc_power_on/off, dbc_power_on_wait/off_wait), without lsc,
# lives in device.sh, sourced above.

probe_dbc_or_fail() {
  rmmod g_ether 2>/dev/null || true
  sleep 1
  role_write host || true
  sleep 3
  PROBE_LSUSB=$(lsusb 2>/dev/null)
  if echo "$PROBE_LSUSB" | grep -q "0525:a4a5"; then
    DBC_ALREADY_UMS="yes"
    log "  DBC is in UMS mode - skipping to flash"
    return 0
  fi
  log "  lsusb output:"
  echo "$PROBE_LSUSB" | sed 's/^/    /' >> "$LOG_FILE"
  if echo "$PROBE_LSUSB" | grep -qi "15a2:"; then
    fail "DBC is in BootROM (SDP) recovery mode - this installer cannot fix that. Manual rescue required (imx_usb_loader)."
  fi
  fail "DBC not reachable and not in UMS mode"
}

dbc_may_already_be_ums() {
  local prev
  for prev in "$RUN_HISTORY_DIR"/*/record; do
    [ -f "$prev" ] || continue
    [ "$prev" = "$RUN_HISTORY_DIR/$RUN_ID/record" ] && continue
    case "$(grep '^stage:' "$prev" 2>/dev/null)" in
      *"Step 4"*|*"Step 5"*|*"Step 6"*|*"Step 7"*) return 0 ;;
    esac
  done
  return 1
}

# Sets DBC_PINGED=yes (gadget kept) or DBC_ALREADY_UMS=yes (host kept, which
# step 5 expects); returns 1 once $1 seconds are gone.
dbc_ping_or_ums_wait() {
  local budget="${1:-300}"
  local peek="no"
  dbc_may_already_be_ums && peek="yes"
  local t0=$(date +%s) hint=0 stretch=0
  DBC_PINGED=""
  PING_ELAPSED=0
  while [ "$PING_ELAPSED" -lt "$budget" ]; do
    stretch=0
    while [ "$stretch" -lt 24 ] && [ "$PING_ELAPSED" -lt "$budget" ]; do
      if ping -c 1 -W 2 "$DBC_IP" >/dev/null 2>&1; then
        DBC_PINGED="yes"
        return 0
      fi
      sleep 2
      stretch=$((stretch + 2))
      PING_ELAPSED=$(( $(date +%s) - t0 ))
      if [ $((PING_ELAPSED - hint)) -ge 30 ]; then
        hint=$PING_ELAPSED
        log "  waiting for the DBC (${PING_ELAPSED}s, swap the USB cable if you have not)"
      fi
    done
    [ "$PING_ELAPSED" -lt "$budget" ] || break
    [ "$peek" = "yes" ] || continue
    rmmod g_ether 2>/dev/null || true
    sleep 1
    role_write host || true
    sleep 3
    if lsusb 2>/dev/null | grep -q "0525:a4a5"; then
      DBC_ALREADY_UMS="yes"
      log "  DBC is in UMS mode after ${PING_ELAPSED}s - skipping to flash"
      return 0
    fi
    if ! restore_gadget; then
      log "  gadget did not come back after the peek, giving up the wait"
      break
    fi
    PING_ELAPSED=$(( $(date +%s) - t0 ))
  done
  return 1
}

find_dbc_block_device() {
  for syspath in /sys/block/sd*; do
    [ -d "$syspath" ] || continue
    local devname="$(basename "$syspath")"
    local dir="$(readlink -f "$syspath/device" 2>/dev/null)"
    while [ -n "$dir" ] && [ "$dir" != "/" ]; do
      if [ -f "$dir/idVendor" ] && [ -f "$dir/idProduct" ]; then
        local vid="$(cat "$dir/idVendor" 2>/dev/null)"
        local pid="$(cat "$dir/idProduct" 2>/dev/null)"
        if [ "$vid" = "0525" ] && [ "$pid" = "a4a5" ]; then
          echo "/dev/$devname"
          return 0
        fi
        break
      fi
      dir="$(dirname "$dir")"
    done
  done
  return 1
}

# Heartbeat for the host-mode watchdog during the long flash write. The
# Go flasher logs progress, but gunzip|dd is silent until it exits, and
# this eMMC writes at only 2-4 MB/s via u-boot UMS, so a full image can
# stay quiet well past the watchdog's 15-minute stall threshold. Sample
# the block device's written-sectors counter once a minute and log it
# only when it advanced: a healthy-but-slow flash keeps the log mtime
# fresh forever, while a flasher stuck in D-state stops the counter and
# still lets the watchdog fire.
FLASH_MON_PID=""
flash_progress_monitor_start() {
  local name="$(basename "$1")"
  (
    last=""
    while :; do
      sleep 60
      cur="$(awk '{print $7}' "/sys/block/$name/stat" 2>/dev/null)"
      [ -n "$cur" ] || continue
      if [ "$cur" != "$last" ]; then
        log "  flash progress: $cur sectors written to $name"
        last="$cur"
      fi
    done
  ) &
  FLASH_MON_PID=$!
}
flash_progress_monitor_stop() {
  [ -n "$FLASH_MON_PID" ] && kill $FLASH_MON_PID 2>/dev/null
  FLASH_MON_PID=""
}

# =========================================================================
# Drop a small helper the installer can invoke via SSH after a failure to
# stop the boot-LED blink and the hazard flash, reset the LED state, and
# unmask keycard-service so a later boot has a working keycard reader.
cat > "$INSTALLER_DIR/stop-error-signals.sh" << 'STOP_HELPER'
#!/bin/sh
# Stop the systemd-run transient units the trampoline/onboot launched for
# the boot-LED blink, the LED guard loop, and the hazards flash. systemctl
# stop is the primary path; the PID-file cleanup below is for older builds.
systemctl stop librescoot-bootled-blink.service 2>/dev/null
systemctl stop librescoot-bootled-guard.service 2>/dev/null
systemctl stop librescoot-bootled-hazards.service 2>/dev/null
# The progress bar's animation and the front-light pulse. Both outlive the
# script that started them, by design, so a run the installer came back to has
# to be told to stop them or a reconnected vehicle keeps pulsing at a user who
# is being asked to do something else.
systemctl stop librescoot-progress-breathe.service 2>/dev/null
systemctl stop librescoot-front-pulse.service 2>/dev/null
# Gadget-mode rescue loop from fail(): normally exits on its own once the
# laptop enumerates, but stop it explicitly so it can never reboot the MDB
# out from under a connected installer.
systemctl stop librescoot-gadget-rescue.service 2>/dev/null
# Host-mode stall watchdog: harmless once we're reachable again (it only
# acts on host role + silent log), but stop it for the same reason.
systemctl stop librescoot-trampoline-watchdog.service 2>/dev/null
if [ -f /data/bootled-blink.pid ]; then
  pid="$(cat /data/bootled-blink.pid 2>/dev/null)"
  if [ -n "$pid" ]; then
    kill -- -"$pid" 2>/dev/null
    kill "$pid" 2>/dev/null
  fi
  rm -f /data/bootled-blink.pid
fi
if [ -f /data/error-hazards.pid ]; then
  pid="$(cat /data/error-hazards.pid 2>/dev/null)"
  if [ -n "$pid" ]; then
    kill -- -"$pid" 2>/dev/null
    kill "$pid" 2>/dev/null
  fi
  rm -f /data/error-hazards.pid
fi
# LED off
i2cset -f -y 2 0x30 0x02 0x00 2>/dev/null
i2cset -f -y 2 0x30 0x03 0x00 2>/dev/null
i2cset -f -y 2 0x30 0x04 0x00 2>/dev/null
# Blinkers and the front light off: set duty 0 but leave the channels active.
# Deactivating (activate=0) gates the PWM output off in the driver, and
# vehicle-service only sets activate=1 once at its Init and afterwards just
# loads duties, so a deactivated channel stays dark even while vehicle-service
# drives it, until it re-inits. This helper runs on reconnect/resume, where
# nothing re-activates afterwards, so duty 0 with activate=1 keeps them ready
# to fire.
for ch in 1 3 4 6 7; do
  /usr/bin/ioctl /dev/pwm_led$ch 0x0000754A -v 0 2>/dev/null
done
# Unmask keycard-service: the trampoline masked it pre-flash so it couldn't
# race us on the LED. The installer's keycardSetup phase will start it
# explicitly; until then it stays inactive but unmasked, so a power cycle
# during a failed install doesn't leave the user with a dead keycard reader.
systemctl unmask librescoot-keycard keycard-service 2>/dev/null || true
# Re-enable BLE - the trampoline masked librescoot-bluetooth so a paired
# phone couldn't send unlock/lock commands via the nRF52 mid-flash. The
# installer's bluetoothPairing phase needs the service running, so start
# it now (unlike keycard, we have no reason to keep it stopped).
systemctl unmask librescoot-bluetooth 2>/dev/null || true
systemctl start librescoot-bluetooth 2>/dev/null || true
# Re-enable UMS - masked pre-flash so it couldn't grab the OTG UDC. A failed
# install must not leave the user with mass-storage permanently masked.
systemctl unmask librescoot-ums 2>/dev/null || true
systemctl start librescoot-ums 2>/dev/null || true
exit 0
STOP_HELPER
chmod +x "$INSTALLER_DIR/stop-error-signals.sh"

# =========================================================================
# Staged for the emergency-reboot paths (gadget-rescue deadline, watchdog).
# Staged as a phase just before an emergency MDB reboot so the red error blink
# comes back right after boot instead of leaving the user with a dark scooter.
# It is numbered below the install phases and the arming deletes those, so a
# boot after an emergency reboot runs this and nothing else. The blink unit is
# stopped by stop-error-signals.sh when the installer reconnects.
cat > "$INSTALLER_DIR/rescue-onboot.sh" << 'RESCUE_ONBOOT'
#!/bin/sh
# Written by the installer's emergency-reboot recovery. Re-arms the red error
# blink after boot. Removing itself is what tells the coordinator the run is
# over, so it puts /data/onboot.sh back the way it found it.
rm -f "$0" "$0.tries"
# The LP5562 needs its init before anything can drive it, and keycard-service
# is masked, so nobody else has done it on this boot.
. /data/installer/scripts/signal.sh || { echo "missing /data/installer/scripts/signal.sh" >&2; exit 1; }
bootled_init
signal_error
exit 0
RESCUE_ONBOOT
chmod +x "$INSTALLER_DIR/rescue-onboot.sh"

# =========================================================================
# Recovery action for the host-mode stall watchdog. Kept as a staged file
# so it gets full quoting freedom (the watchdog unit itself is a single-
# quoted systemd-run string). Tries an in-place gadget restore first: if
# that works we keep the running system (and its LED signals) and just
# blink red until the installer reconnects and reads the status. If the
# role is wedged, fall back to the emergency reboot. A stalled flasher in
# D-state can hang sync and even a graceful reboot, hence the timeouts
# and the reboot -f fallback.
cat > "$INSTALLER_DIR/watchdog-recover.sh" << 'WATCHDOG_RECOVER'
#!/bin/sh
INSTALLER_DIR="/data/installer"
# The heredoc that writes this file is quoted, so nothing is inherited: every
# path it uses has to be spelled out here. Without this one the disarm below
# globbed from the filesystem root and staged the rescue phase at /.
SCRIPTS_DIR="$INSTALLER_DIR/scripts"
LOG="$INSTALLER_DIR/trampoline.log"
STATUS="$INSTALLER_DIR/trampoline-status"
RUN_ID="$(cat "$INSTALLER_DIR/run-id" 2>/dev/null)"
log() { echo "$(date '+%H:%M:%S') watchdog: $1" >> "$LOG"; }
# Same reason: the trampoline's own usb0 helpers are not inherited either,
# and without them every in-place restore below was command-not-found and
# the script always fell through to the reboot.
usb0_up() {
  ip addr replace 192.168.7.1/24 dev usb0 2>/dev/null || true
  ip link set usb0 up 2>/dev/null || true
}
usb0_is_up() {
  ip -4 addr show usb0 2>/dev/null | grep -q '192\.168\.7\.1'
}
. "$SCRIPTS_DIR/signal.sh" || { echo "missing $SCRIPTS_DIR/signal.sh" >&2; exit 1; }

for ROLE_PATH in /sys/kernel/debug/ci_hdrc.0/role \
                 /sys/kernel/debug/usb/ci_hdrc.0/role \
                 /sys/bus/platform/devices/ci_hdrc.0/role; do
  [ -f "$ROLE_PATH" ] && break
done

log "trampoline stalled in host mode, attempting recovery"
STATUS_TMP="$STATUS.$RUN_ID.tmp"
{
  echo "error: installation stalled in USB host mode and was recovered by the watchdog. Please retry the install."
  echo "run-id: $RUN_ID"
  echo "finish: pending"
  echo "stage: host-mode-watchdog"
  cat "$LOG"
} > "$STATUS_TMP" && mv -f "$STATUS_TMP" "$STATUS"
mkdir -p "$INSTALLER_DIR/history/$RUN_ID"
RUN_TMP="$INSTALLER_DIR/history/$RUN_ID/.record.tmp"
{
  echo "run-id: $RUN_ID"
  echo "actor: trampoline"
  echo "stage: host-mode-watchdog"
  echo "result: error"
  echo "finish: pending"
  echo "updated: $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
} > "$RUN_TMP" && mv -f "$RUN_TMP" "$INSTALLER_DIR/history/$RUN_ID/record"
cp "$INSTALLER_DIR/history/$RUN_ID/record" "$INSTALLER_DIR/.run-state.$RUN_ID.tmp" &&
  mv -f "$INSTALLER_DIR/.run-state.$RUN_ID.tmp" "$INSTALLER_DIR/run-state"
sync &
sleep 5

bootled_guard_stop

attempt=0
while [ $attempt -lt 3 ]; do
  attempt=$((attempt + 1))
  rmmod g_ether 2>/dev/null
  sleep 1
  if command -v timeout >/dev/null 2>&1; then
    timeout 15 sh -c "echo gadget > $ROLE_PATH" 2>/dev/null
  else
    echo gadget > "$ROLE_PATH" 2>/dev/null
  fi
  sleep 1
  modprobe g_ether 2>/dev/null
  sleep 1
  usb0_up
  sleep 1
  if [ "$(cat "$ROLE_PATH" 2>/dev/null)" = "gadget" ] \
      && usb0_is_up; then
    log "gadget restored in place (attempt $attempt)"
    signal_error
    exit 0
  fi
  sleep 2
done

log "gadget restore failed, rebooting MDB"
mkdir -p "$SCRIPTS_DIR"
# Disarm everything this run queued; keep what says what happened.
rm -f "$SCRIPTS_DIR"/[0-9][0-9]-*.sh "$SCRIPTS_DIR"/[0-9][0-9]-*.sh.tries
cp "$INSTALLER_DIR/rescue-onboot.sh" "$SCRIPTS_DIR/00-rescue.sh"
chmod +x "$SCRIPTS_DIR/00-rescue.sh"
sync &
sleep 10
reboot &
sleep 30
reboot -f
WATCHDOG_RECOVER
chmod +x "$INSTALLER_DIR/watchdog-recover.sh"

echo "" > "$LOG_FILE"

# Claim the status file before doing anything with it. It is never truncated
# otherwise, so a run that dies before reaching fail() (killed, wedged, power
# cut, a watchdog that missed it) leaves the previous run's verdict on disk and
# the installer reads that as this run's outcome. Writing "running" here means
# an unfinished run reads as unfinished, which is what it is.
write_status "running" "started: $(date -u '+%Y-%m-%dT%H:%M:%SZ')"

log "=========================================="
log "Trampoline started"
log "  MODE=$MODE"
log "  DBC_IMAGE=$DBC_IMAGE"
log "  DBC_MENDER=$DBC_MENDER"
log "  INSTALL_TILES=$INSTALL_TILES"
log "  OSM=$OSM_TILES_FILE"
log "  VALHALLA=$VALHALLA_TILES_FILE"
log "  TILES_REGION=$TILES_REGION"
# The finish config decides whether the device closes the install out itself
# or hands back to the laptop, and it is invisible in the log otherwise: a
# run that quietly handed back looks exactly like one that finished.
log "  FINISH_ON_DEVICE=$FINISH_ON_DEVICE"
log "  FINISH_LANGUAGE=$FINISH_LANGUAGE CHANNEL=$FINISH_CHANNEL"
log "  MDB_ACTION=$MDB_ACTION MDB_TARGET=$MDB_TARGET"
log "=========================================="

# Log all errors, always: route every command's stderr into the log so no
# failure is ever silent (this is how the post-flash DBC SSH host-key
# rejection went unseen). Commands still opt out with 2>/dev/null only where
# a failure is expected and handled (LED writes, ping polling, || true).
exec 2>>"$LOG_FILE"

# Nothing a previous run left lit or breathing belongs to this one. Dark first,
# then this run's own signals from a known state.
signal_all_off

# Front light pulsing FIRST, before the slower service stops below, so the
# vehicle shows something within a second or two of the run starting instead
# of going dark for the ~15s the stops below take (librescoot-bluetooth in
# particular, which is mid BLE/UART work). Same ordering used at the resume
# point after the MDB reboot. Safe this early: the front-ring channel is not
# one keycard/bluetooth/ums/pm touch, so there is nothing to race here.
front_pulse_start

# Stop services that interfere. Persistent mask survives the MDB reboot
# we do after writing onboot.sh; onboot.sh unmasks at the end of its
# success branch, and stop-error-signals.sh unmasks on the failure path
# when the installer reconnects.
#
# librescoot-keycard / keycard-service: both drive the LP5562 via i2cset
#   on /dev/i2c-2 @ 0x30. If they fire mid-flash they stomp our amber.
# librescoot-bluetooth stays up. It is what answers the nRF52, and on the
#   full image the nRF expects to keep hearing from it once it has been
#   spoken to in this power cycle: with the service stopped, the nRF's
#   watchdog cuts power to the whole board about two minutes later, in the
#   middle of whatever step was running. A phone unlock through it is
#   refused by the vehicle state the run holds, not by silencing the radio.
# librescoot-ums: binds a USB mass-storage gadget on the same OTG UDC
#   (ci_hdrc.0) the trampoline drives for g_ether and the gadget<->host
#   role switch. It's enabled + Restart=always, so a plain stop comes back
#   on the post-flash MDB reboot and can grab the UDC out from under us,
#   stalling the DBC UMS handoff (step 6). Mask it like keycard/bluetooth;
#   re-enabled at the end of onboot.sh's success branch and on the failure
#   path via stop-error-signals.sh.
# librescoot-pm: standard "get out of the way" stop (no UDC conflict).
log "Stopping services..."
systemctl stop librescoot-keycard keycard-service 2>/dev/null || true
systemctl mask librescoot-keycard keycard-service 2>/dev/null || true
systemctl stop librescoot-ums 2>/dev/null || true
systemctl mask librescoot-ums 2>/dev/null || true
systemctl stop librescoot-pm 2>/dev/null || true

# Amber, and a guard loop that re-asserts it every 2s: vehicle-service also
# drives the LP5562 (for blinker brightness) and cannot be masked, because
# `lsc dbc on-wait` needs it. Deliberately kept after the stops above, not
# moved alongside the front light: keycard-service is still live until the
# mask above lands, and starting the guard loop before that would just mean
# a few seconds of the guard fighting keycard for the LP5562 instead of zero.
signal_install_start

# Reject a MODE we do not recognise before anything else runs. The value comes
# from a template placeholder, so a script the installer never rendered lands
# here with the placeholder still in it, is not equal to "flash", takes the
# upgrade path, finds no artifact and reports success without ever having
# touched the DBC. This check sits here rather than next to the declaration
# because fail() is not defined until further down and its red blink needs the
# LP5562 init just above.
case "$MODE" in
  flash|upgrade) log "Mode: $MODE" ;;
  *) fail "unrecognised install mode: $MODE" ;;
esac

# Capture system journal in background for debugging
journalctl -f --no-pager >> "$INSTALLER_DIR/trampoline-journal.log" 2>&1 &
JOURNAL_PID=$!

if [ "$MODE" = "flash" ]; then

  # Arm the host-mode stall watchdog. Inert while the role is gadget, so
  # arming this early is free; it covers every host-mode stint from here on.
  # Only flash mode ever enters host mode, so an upgrade never arms it.
  trampoline_watchdog_start

  # Verify image
  [ -f "$DBC_IMAGE" ] || fail "DBC image not found: $DBC_IMAGE"
  log "Image: $(ls -lh "$DBC_IMAGE" | awk '{print $5}')"
fi

# Same treatment for the artifact, in both modes: a path the renderer asked
# for but did not stage is a hard stop. Catching it here costs the user
# nothing; catching it in onboot.sh costs them an MDB reboot and a cable swap
# first. onboot.sh checks again because the reboot sits between the two.
if [ -n "$DBC_MENDER" ]; then
  CURRENT_STAGE="installing-dbc-artifact"
  [ "$INSTALL_TILES" = "true" ] &&
    CURRENT_STAGE="installing-dbc-artifact-and-tiles"
  write_run_state "$CURRENT_STAGE"
  [ -f "$DBC_MENDER" ] || fail "DBC artifact not found: $DBC_MENDER"
  log "Artifact: $(ls -lh "$DBC_MENDER" | awk '{print $5}')"
fi

# Step 1: Wait for laptop disconnect
step_begin "Step 1: wait for laptop disconnect"
# Debounced: this port never reports "not attached", it cycles through
# default and addressed while re-enumerating, so a single non-configured
# sample can be an RNDIS blip with the laptop still plugged in. Acting on one
# flips the controller to host mode under a live laptop. Three consecutive
# seconds costs nothing against a cable swap that takes several.
UDC_STATE=/sys/class/udc/ci_hdrc.0/state
GONE_NEEDED=3
GONE=0
while [ "$GONE" -lt "$GONE_NEEDED" ]; do
  if grep -q "configured" "$UDC_STATE" 2>/dev/null; then
    GONE=0
  else
    GONE=$((GONE + 1))
  fi
  sleep 1
done
log "Laptop disconnected (debounced)"
step_end

# Step 2: Re-init g_ether for DBC
step_begin "Step 2: re-init g_ether"
rmmod g_ether 2>/dev/null || true
sleep 1
modprobe g_ether 2>/dev/null || true
sleep 2
usb0_up
log "  usb0 ready"
step_end

# Steps 3-7 are stage 0: power the DBC into u-boot mass storage, flip the MDB
# to USB host and write the disk image to the DBC's eMMC. An upgrade already
# has a booted DBC and only needs the artifact install in onboot.sh, so it
# skips the lot and goes straight to step 8.
if [ "$MODE" = "flash" ]; then

# Step 3: Power on DBC
step_begin "Step 3: power on DBC"
DBC_ALREADY_UMS=""

# Power on without waiting: the wait below owns the whole window, and a DBC
# already in UMS never answers the ping that on-wait would sit 90s on.
dbc_power_on || log "  DBC power-on failed, falling through to the reachability check"

if [ "$DBC_ALREADY_UMS" != "yes" ]; then
  # This wait is the cable swap. The DBC is only reachable once the user has
  # moved the MDB's single USB plug off the laptop and onto the internal DBC
  # cable: a screw-lock mini-B, in a footwell, by hand. Step 6 already budgets
  # 300s for the same swap and says so in its comment; step 3 needs the swap
  # to have happened too and used to allow one packet, which put a stopwatch
  # on the user that nothing told them about.
  #
  # A dead DBC now takes the full window to report, which is the trade step 6
  # already made. The blinker progress bar covers the wait. The wait itself
  # alternates: mostly pinging in gadget mode, with a brief host-mode lsusb
  # peek between stretches so a DBC already parked in UMS is found in well
  # under a minute instead of after the whole budget.
  if ! dbc_ping_or_ums_wait 300; then
    log "  DBC not pingable after ${PING_ELAPSED}s, checking USB state..."
    probe_dbc_or_fail
  fi
  [ "$DBC_PINGED" = "yes" ] && log "  DBC is reachable after ${PING_ELAPSED}s"
fi
step_end

# The dashboard is on the cable, one way or the other, so the wait the front
# ring was announcing is over. It stays off for the rest of the run: the bar
# carries everything after this, and a ring that came back would read as
# another cable to move. Segment 1 lights here and not at the start for the
# same reason: it means the dashboard being put into mass storage and written,
# which begins now, and a segment breathing under the ring's wait said two
# things at once.
front_pulse_stop
progress_set "$SEGMENT_PREP" active

if [ "$DBC_ALREADY_UMS" != "yes" ]; then
  step_begin "Step 3b: wait for DBC SSH"
  wait_dbc_ssh 30 || fail "DBC SSH not reachable"
  log "DBC reachable"
  step_end

  # Step 4: Configure DBC for UMS (retry up to 3x if DBC shuts down)
  step_begin "Step 4: configure DBC bootloader for UMS"
  STEP4_OK=""
  for STEP4_ATTEMPT in 1 2 3; do
    log "  step 4 attempt $STEP4_ATTEMPT/3..."

    # Check if DBC is still reachable
    if ! ping -c 1 -W 2 $DBC_IP >/dev/null 2>&1; then
      log "  DBC not reachable, turning on..."
      dbc_power_on_wait || true
      wait_dbc_ssh 30 || { log "  DBC SSH failed after on-wait"; continue; }
    fi

    # Check native fw_setenv (Librescoot DBC) vs stock
    HAS_NATIVE=$(ssh -y -y root@$DBC_IP 'test -x /usr/bin/fw_setenv && test -f /etc/fw_env.config && echo yes' 2>/dev/null || echo no)
    log "  native fw_setenv: $HAS_NATIVE"

    if [ "$HAS_NATIVE" = "yes" ]; then
      FWCMD="fw_setenv"
      FWCFG=""
    else
      log "  copying stock DBC fw tools..."
      dbc_put "$INSTALLER_DIR/fwtools/stock-dbc/fw_setenv" /tmp/fw_setenv || { log "  fw_setenv copy failed"; continue; }
      dbc_put "$INSTALLER_DIR/fwtools/stock-dbc/fw_env.config" /tmp/fw_env.config || { log "  fw_env.config copy failed"; continue; }
      dbc_ssh 'chmod +x /tmp/fw_setenv' || true
      FWCMD="/tmp/fw_setenv"
      FWCFG="-c /tmp/fw_env.config"
    fi

    log "  setting bootcmd..."
    BOOTCMD_OUT=$(dbc_ssh "$FWCMD $FWCFG bootcmd 'fuse prog -y 0 5 0x00003860; fuse prog -y 0 6 0x00000010; ums 0 mmc 2;'" 2>&1)
    if [ $? -ne 0 ]; then
      log "  bootcmd failed: $BOOTCMD_OUT"
      BOOTCMD_OUT=$(dbc_ssh "$FWCMD $FWCFG bootcmd 'ums 0 mmc 2'" 2>&1)
      if [ $? -ne 0 ]; then
        log "  fallback bootcmd also failed, DBC may have shut down"
        sleep 5
        continue
      fi
    fi
    log "  bootcmd set: $BOOTCMD_OUT"

    # Wait a moment then check if DBC is still alive
    sleep 3
    if ! ping -c 1 -W 2 $DBC_IP >/dev/null 2>&1; then
      log "  DBC went down after fw_setenv - retrying..."
      sleep 5
      continue
    fi

    log "  setting bootdelay=0..."
    dbc_ssh "$FWCMD $FWCFG bootdelay 0" >> "$LOG_FILE" 2>&1 || log "  bootdelay failed"

    log "  syncing DBC..."
    dbc_ssh 'sync' >> "$LOG_FILE" 2>&1 || log "  sync failed"

    # Reboot the DBC into u-boot UMS. Soft-reboot first so the DBC syncs and
    # shuts down its filesystem cleanly, then after 10s force a hard power
    # cycle. The force (dashboard:off:force) is required: a plain dashboard:off
    # is rejected while a DBC update is flagged, and otherwise runs a graceful
    # `dbc:command poweroff` + 4s wait that the seatbox-open / awake vehicle
    # state interferes with, so the DBC never actually cycles. bootcmd is armed
    # to `ums 0 mmc 2` with bootdelay=0, so powering back on drops straight
    # into UMS; step 6 polls for the resulting block device.
    log "  rebooting DBC (soft reboot, then forced power cycle)..."
    dbc_ssh 'reboot &' >> "$LOG_FILE" 2>&1 || log "  reboot failed"
    sleep 10
    dbc_power_off_wait || log "  forced DBC off failed"
    dbc_power_on || log "  DBC power-on failed"
    sleep 3

    STEP4_OK="yes"
    break
  done
  [ "$STEP4_OK" != "yes" ] && fail "Failed to configure DBC after 3 attempts"
  step_end
fi  # end of DBC_ALREADY_UMS != yes

# Step 5: Switch MDB to USB host (may already be in host mode if DBC was in UMS)
step_begin "Step 5: switch MDB to USB host mode"
CURRENT_ROLE=$(cat "$ROLE_PATH" 2>/dev/null)
if [ "$CURRENT_ROLE" != "host" ]; then
  rmmod g_ether 2>/dev/null || true
  sleep 1
  role_write host || fail "Failed to switch to host mode"
  sleep 3
else
  log "  already in host mode"
fi
log "  role: $(cat "$ROLE_PATH" 2>/dev/null)"
log "  lsusb: $(lsusb 2>/dev/null | grep 0525 || echo 'no 0525')"
step_end

# Step 6: Find DBC block device (DBC may still be rebooting from step 4).
# This window absorbs two variable delays: the DBC reboot into u-boot UMS,
# AND the human swapping the single USB cable from the laptop over to the
# DBC. A slow swap is the common case, and timing out here is expensive to
# recover from - step 4 already armed the DBC bootcmd to `ums 0 mmc 2` with
# bootdelay=0, so a DBC that never got flashed will keep booting straight
# into UMS until it's reflashed. Give the user real time (5 min) before
# giving up.
# We don't peek at gadget mode during the wait - flipping roles can
# race the DBC enumeration. Only after the full timeout, if there's
# really nothing on the bus, do a single gadget probe to disambiguate
# "DBC absent" vs "laptop reconnected"; that gives the user a clear
# error message instead of a generic "UMS not found".
step_begin "Step 6: wait for DBC UMS device"
TIMEOUT=300
ELAPSED=0
DBC_DEV=""
# Remember where the captured journal stood when the wait started, so the
# timeout analysis below only looks at bus activity from THIS window.
# Earlier host-mode stints (step 3 probe) would otherwise pollute it.
STEP6_JNL_START=$(wc -l < "$INSTALLER_DIR/trampoline-journal.log" 2>/dev/null || echo 0)
STEP6_REPOWERED=""
STEP6_RESCANNED=""
while [ $ELAPSED -lt $TIMEOUT ]; do
  DBC_DEV="$(find_dbc_block_device 2>/dev/null)" && break
  ELAPSED=$((ELAPSED + 2))
  if [ $((ELAPSED % 10)) -eq 0 ]; then
    log "  ${ELAPSED}s... $(lsusb 2>/dev/null | grep 0525 || echo 'no USB')"
  fi
  # Halfway nudge: re-power the DBC once. Recovers a DBC that hung before
  # reaching UMS; bootcmd is armed with bootdelay=0, so a healthy DBC just
  # lands back in UMS. Harmless if the cable simply isn't connected yet.
  # First and most likely cause: the cable was plugged into the dashboard
  # while the controller was still a gadget, and the switch to host gave the
  # port no connect event to act on. Rescan early, because this is the normal
  # sequence rather than a fault.
  if [ $ELAPSED -ge 12 ] && [ -z "$STEP6_RESCANNED" ]; then
    STEP6_RESCANNED="yes"
    log "  nothing on the bus yet, rescanning..."
    usb_host_rescan || true
  fi
  # Then the device side: re-power the dashboard, which recovers one that hung
  # before reaching UMS. bootcmd is armed with bootdelay=0, so a healthy one
  # lands straight back in UMS.
  if [ $ELAPSED -ge $((TIMEOUT / 3)) ] && [ -z "$STEP6_REPOWERED" ]; then
    STEP6_REPOWERED="yes"
    log "  still nothing, re-powering the dashboard once..."
    dbc_power_off_wait || log "  DBC off failed"
    dbc_power_on || log "  DBC on failed"
    STEP6_RESCANNED=""
  fi
  sleep 2
done
if [ -z "$DBC_DEV" ]; then
  # Last-ditch: see if the user yanked the DBC and connected the laptop.
  # If so, probe_for_laptop_then_restore_host calls fail() with a clear
  # message and never returns.
  probe_for_laptop_then_restore_host
  # Classify what (if anything) the bus saw during the wait, from the
  # journal we're already capturing. An unplugged cable and an unpowered
  # device are electrically identical (no D+ pullup), so total silence
  # means the cable most likely never reached the DBC; enumeration errors
  # mean something is plugged but the link is bad.
  STEP6_JNL=$(tail -n +$((STEP6_JNL_START + 1)) "$INSTALLER_DIR/trampoline-journal.log" 2>/dev/null | grep "usb 1-1")
  if [ -z "$STEP6_JNL" ]; then
    fail "No USB device was detected while waiting for the DBC. The USB cable is probably not plugged into the DBC. Connect the MDB's USB cable to the DBC and retry."
  elif echo "$STEP6_JNL" | grep -qiE "device descriptor read|device not accepting|unable to enumerate|error"; then
    fail "A USB device was detected but failed to enumerate. Reseat the USB cable between MDB and DBC and retry."
  fi
  fail "DBC UMS not found in ${TIMEOUT}s"
fi
log "DBC device: $DBC_DEV ($(cat /sys/block/$(basename $DBC_DEV)/size 2>/dev/null || echo '?') sectors)"
step_end

# Safety
echo "$DBC_DEV" | grep -q "mmcblk" && fail "SAFETY: $DBC_DEV is mmcblk - refusing!"

# Step 7: Flash DBC
step_begin "Step 7: flash DBC"

# Read uncompressed size from gzip footer (last 4 bytes, little-endian uint32)
FLASH_TOTAL=$(python3 -c "import struct; f=open('$DBC_IMAGE','rb'); f.seek(-4,2); print(struct.unpack('<I',f.read(4))[0])" 2>/dev/null || echo 2500000000)
log "  image uncompressed size: $FLASH_TOTAL"

FLASH_OK=""
ATTEMPT=0
while [ $ATTEMPT -lt 3 ]; do
  ATTEMPT=$((ATTEMPT + 1))
  log "  flash attempt $ATTEMPT/3..."
  flash_progress_monitor_start "$DBC_DEV"

  FLASHER="$INSTALLER_DIR/librescoot-flasher"
  USING_DD=""
  if [ -x "$FLASHER" ] && [ -f "$DBC_BMAP" ]; then
    log "  using librescoot-flasher (bmap: $DBC_BMAP)"
    $FLASHER --image "$DBC_IMAGE" --bmap "$DBC_BMAP" --device "$DBC_DEV" >> "$LOG_FILE" 2>&1
    FLASH_RC=$?
  elif [ -x "$FLASHER" ]; then
    log "  using librescoot-flasher (sequential)"
    $FLASHER --image "$DBC_IMAGE" --device "$DBC_DEV" >> "$LOG_FILE" 2>&1
    FLASH_RC=$?
  else
    USING_DD="yes"
    log "  using dd (oflag=direct), image size: $FLASH_TOTAL"
    gunzip -c "$DBC_IMAGE" | dd bs=4M iflag=fullblock of=$DBC_DEV oflag=direct 2>> "$LOG_FILE"
    # $? of a pipeline is dd's status (PIPESTATUS is bash-only and a bad
    # substitution under busybox ash). A gunzip failure truncates the
    # stream without failing dd; the boot-sector verify below catches it.
    FLASH_RC=$?
  fi

  flash_progress_monitor_stop
  if [ "${FLASH_RC:-0}" -ne 0 ]; then
    log "  flash failed (rc=$FLASH_RC), retrying..."
    sleep 3
    DBC_DEV="$(find_dbc_block_device 2>/dev/null)" || { log "  device gone, waiting..."; sleep 5; DBC_DEV="$(find_dbc_block_device 2>/dev/null)" || continue; }
    log "  re-probed device: $DBC_DEV"
    continue
  fi

  sync

  # Go flasher paths (bmap + sequential) already verify source/bmap integrity
  # per range and surface write errors as non-zero exit; trust the exit code.
  if [ -z "$USING_DD" ]; then
    log "  flasher reports success"
    FLASH_OK="yes"
    break
  fi

  # dd fallback: sanity-check boot sector (24 MB). iflag=direct bypasses page
  # cache, which otherwise serves stale data populated by udev at enumeration.
  log "  verifying boot sector ($BOOT_AREA_BLOCKS blocks = 24 MB)..."
  SRC_HASH=$(gunzip -c "$DBC_IMAGE" | dd bs=4M iflag=fullblock count=$BOOT_AREA_BLOCKS 2>/dev/null | md5sum | cut -d' ' -f1)
  DEV_HASH=$(dd if=$DBC_DEV bs=4M iflag=direct count=$BOOT_AREA_BLOCKS 2>/dev/null | md5sum | cut -d' ' -f1)
  log "  src=$SRC_HASH dev=$DEV_HASH"

  if [ "$SRC_HASH" = "$DEV_HASH" ]; then
    log "  verified OK"
    FLASH_OK="yes"
    break
  else
    log "  checksum mismatch, retrying..."
    sleep 3
    DBC_DEV="$(find_dbc_block_device 2>/dev/null)" || { log "  device gone, waiting..."; sleep 5; DBC_DEV="$(find_dbc_block_device 2>/dev/null)" || continue; }
    log "  re-probed device: $DBC_DEV"
  fi
done

[ "$FLASH_OK" != "yes" ] && fail "DBC flash failed after 3 attempts"
log "DBC flash complete"
step_end

# The preparation is done, and only in this mode was there any: an upgrade
# writes no stage-0 image, so it leaves segment 1 dark rather than filling it
# for work it never did.
progress_set "$SEGMENT_PREP" done

fi  # end of MODE = flash

# The front light is deliberately left as it is here. An upgrade never reached
# the stop at step 7 because it never talks to the dashboard, so on that path
# the cable-swap wait is still genuinely open and ends in the dashboard phase,
# once the board answers.

# Step 8: Sync, power off DBC, write onboot script, reboot MDB
step_begin "Step 8: post-flash cleanup"

# Power off the DBC cleanly. Historically we did off-wait -> on-wait ->
# off-wait here to "let the DBC do its first boot / partition resize"
# while the MDB was still up - but onboot.sh re-powers the DBC and
# already has a stable-wait loop that absorbs the resize-induced reboot,
# so doing it twice was just ~60-90 s of wall-clock time the user spent
# staring at empty blinkers. Skip the on-wait; let onboot.sh's loop
# handle first-boot.
log "  syncing..."
sync
log "  turning off DBC..."
dbc_power_off_wait || true

# Write the post-reboot phase on MDB - /data/onboot.sh runs it on the next
# boot, and is itself started by librescoot-onboot.service
# (ConditionPathExists=/data/onboot.sh). That path is fixed by the unit; all
# other state we touch lives under /data/installer/ so a single rm -rf
# at finish cleans up after us.
mkdir -p "$SCRIPTS_DIR"
log "  writing the post-reboot phase to $SCRIPTS_DIR/20-dbc.sh..."
cat > "$SCRIPTS_DIR/20-dbc.sh" << 'ONBOOT'
#!/bin/sh
# Auto-generated by installer trampoline - run by /data/onboot.sh on MDB boot
INSTALLER_DIR="/data/installer"
SCRIPTS_DIR="$INSTALLER_DIR/scripts"
LOG="$INSTALLER_DIR/trampoline.log"
DBC_IP="192.168.7.2"
STATUS_FILE="$INSTALLER_DIR/trampoline-status"
PHASE_FILE="$INSTALLER_DIR/trampoline-phase"
RUN_ID="$(cat "$INSTALLER_DIR/run-id" 2>/dev/null)"
RUN_HISTORY_DIR="$INSTALLER_DIR/history"
RUN_STATE_FILE="$INSTALLER_DIR/run-state"
mkdir -p "$INSTALLER_DIR"

write_run_state() {
  local stage="$1"
  local result="${2:-running}"
  local finish="${3:-pending}"
  local history_tmp="$RUN_HISTORY_DIR/$RUN_ID/.record.tmp"
  local current_tmp="$INSTALLER_DIR/.run-state.$RUN_ID.tmp"
  mkdir -p "$RUN_HISTORY_DIR/$RUN_ID"
  {
    echo "run-id: $RUN_ID"
    echo "actor: trampoline"
    echo "stage: $stage"
    echo "result: $result"
    echo "finish: $finish"
    echo "updated: $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  } > "$history_tmp" &&
    mv -f "$history_tmp" "$RUN_HISTORY_DIR/$RUN_ID/record" &&
    cp "$RUN_HISTORY_DIR/$RUN_ID/record" "$current_tmp" &&
    mv -f "$current_tmp" "$RUN_STATE_FILE"
}

write_status() {
  local verdict="$1"
  shift
  local status_tmp="$STATUS_FILE.$RUN_ID.tmp"
  local result="running"
  case "$verdict" in
    success*) result="success" ;;
    error*) result="error" ;;
  esac
  {
    echo "$verdict"
    echo "run-id: $RUN_ID"
    echo "finish: pending"
    for field in "$@"; do echo "$field"; done
    cat "$LOG" 2>/dev/null
  } > "$status_tmp" && mv -f "$status_tmp" "$STATUS_FILE"
  write_run_state "${CURRENT_STAGE:-post-reboot}" "$result" pending
}

write_completion_record() {
  local history_tmp="$RUN_HISTORY_DIR/$RUN_ID/.record.complete"
  local last_tmp="$INSTALLER_DIR/.last-install.$RUN_ID.tmp"
  local current_tmp="$INSTALLER_DIR/.run-state.$RUN_ID.complete"
  mkdir -p "$RUN_HISTORY_DIR/$RUN_ID"
  {
    echo "result: success"
    echo "run-id: $RUN_ID"
    echo "finish: complete"
    echo "stage: complete"
    echo "mode: $MODE"
    echo "finished: $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    echo "mdb: $MDB_TARGET"
    echo "dbc: ${DBC_COMPLETED_VERSION:-}"
  } > "$history_tmp" || return 1
  mv -f "$history_tmp" "$RUN_HISTORY_DIR/$RUN_ID/record" || return 1
  cp "$RUN_HISTORY_DIR/$RUN_ID/record" "$last_tmp" &&
    mv -f "$last_tmp" "$INSTALLER_DIR/last-install" || return 1
  cp "$RUN_HISTORY_DIR/$RUN_ID/record" "$current_tmp" &&
    mv -f "$current_tmp" "$RUN_STATE_FILE" || return 1
}
ONBOOT
# The heredoc above is quoted, so onboot.sh inherits nothing from us. Close the
# quoting for these lines to bake the values in, then reopen it so the rest of
# the script keeps its literal $.
#
# Every substituted value onboot.sh reads at runtime has to appear here. One
# left out is empty there, and an empty string fails every test quietly: the
# autonomous finish is guarded on FINISH_ON_DEVICE = "true", so omitting it
# skipped the settings restore, the completion record, the sweep and the
# reboot on every run, while the LED still went green.
cat >> "$SCRIPTS_DIR/20-dbc.sh" << ONBOOT_VARS
DBC_MENDER="$DBC_MENDER"
DBC_TARGET="$DBC_TARGET"
MODE="$MODE"
FINISH_ON_DEVICE="$FINISH_ON_DEVICE"
FINISH_LANGUAGE="$FINISH_LANGUAGE"
FINISH_CHANNEL="$FINISH_CHANNEL"
MDB_ACTION="$MDB_ACTION"
MDB_TARGET="$MDB_TARGET"
ONBOOT_VARS
# Tiles are installed while the dashboard still runs the stage-0 image, so
# this is only the definition; the call sits in the artifact section below.
# Emitted before the main chunk so the function exists by the time that runs.
if [ "$INSTALL_TILES" = "true" ]; then
  cat >> "$SCRIPTS_DIR/20-dbc.sh" << TILES
# Reads back one installed artifact and echoes "<sha256> <size> <mtime-epoch>",
# or nothing when the file is not there. The hash is computed on the dashboard
# rather than over the staged file because for a .tar.zst the installed
# artifact is the decompressed tar, whose digest this side never sees.
tile_facts() {
  dbc_ssh "test -f \$1 && echo \"\\\$(sha256sum \$1 | cut -d' ' -f1) \\\$(stat -c '%s %Y' \$1)\"" 2>/dev/null
}

# Writes /data/maps/metadata.json on the dashboard and mirrors it into the
# `maps` hash in Redis. Composes the record fresh rather than merging: this runs
# during provisioning, and any previous update-check result described tiles that
# are no longer installed.
record_tiles() {
  local d_sha="" d_size="" d_mtime="" r_sha="" r_size="" r_mtime="" facts

  facts=\$(tile_facts /data/maps/map.mbtiles)
  if [ -n "\$facts" ]; then
    d_sha=\$(echo "\$facts" | cut -d' ' -f1)
    d_size=\$(echo "\$facts" | cut -d' ' -f2)
    d_mtime=\$(echo "\$facts" | cut -d' ' -f3)
  fi
  facts=\$(tile_facts /data/valhalla/tiles.tar)
  if [ -n "\$facts" ]; then
    r_sha=\$(echo "\$facts" | cut -d' ' -f1)
    r_size=\$(echo "\$facts" | cut -d' ' -f2)
    r_mtime=\$(echo "\$facts" | cut -d' ' -f3)
  fi

  if [ -z "\$d_sha" ] && [ -z "\$r_sha" ]; then
    log "No installed tiles to record"
    return 0
  fi

  # Shape matches scootui-qt's MapMetadata::toJson, keys it omits included, so
  # the dashboard reads back a record it would have written itself.
  local json="{\\"region\\":\\"$TILES_REGION\\""
  [ -n "\$d_sha" ] && json="\$json,\\"displayTiles\\":{\\"digest\\":\\"\$d_sha\\",\\"size\\":\$d_size}"
  [ -n "\$r_sha" ] && json="\$json,\\"valhallaTiles\\":{\\"digest\\":\\"\$r_sha\\",\\"size\\":\$r_size}"
  json="\$json}"

  # Written here and uploaded over the PUT server rather than echoed into a
  # remote shell. The dashboard runs the bootstrap image during this phase and
  # its busybox has no base64 applet, which is the same trap the missing
  # timeout applet already sprang once.
  printf '%s' "\$json" > "\$INSTALLER_DIR/tile-metadata.json"
  if upload_to_dbc "\$INSTALLER_DIR/tile-metadata.json" "/maps/metadata.json" "tile metadata"; then
    log "Recorded installed tile metadata (region '$TILES_REGION')"
  else
    log "WARNING: could not write tile metadata to the dashboard"
  fi

  # The MDB's Redis is volatile, so this is not the lasting record; the
  # dashboard republishes on every boot. It is what lets anything read the
  # installed region before the dashboard has ever run on this vehicle.
  [ -n "$TILES_REGION" ] && hset_maps region "$TILES_REGION"
  [ -n "$TILES_REGION_NAME" ] && hset_maps region-name "$TILES_REGION_NAME"
  if [ -n "\$d_sha" ]; then
    hset_maps map:sha256 "\$d_sha"
    hset_maps map:size "\$d_size"
    hset_maps map:mtime "\$(epoch_to_iso "\$d_mtime")"
  fi
  if [ -n "\$r_sha" ]; then
    hset_maps routing:sha256 "\$r_sha"
    hset_maps routing:size "\$r_size"
    hset_maps routing:mtime "\$(epoch_to_iso "\$r_mtime")"
  fi
  hset_maps update-available false
  hset_maps updated-at "\$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}

install_tiles() {
dbc_ssh "mkdir -p /data/maps /data/valhalla" || log "WARNING: mkdir failed"

TILE_ERRORS=0

# A path here means the user asked for these tiles, so a file that is not
# there is a staging failure and not "none were wanted". Reporting success
# without saying so hands back a scooter with no maps and no explanation.
if [ -n "$OSM_TILES_FILE" ] && [ ! -f "$OSM_TILES_FILE" ]; then
  log "ERROR: display tiles staged at $OSM_TILES_FILE are missing"
  TILE_ERRORS=\$((TILE_ERRORS + 1))
fi
if [ -n "$VALHALLA_TILES_FILE" ] && [ ! -f "$VALHALLA_TILES_FILE" ]; then
  log "ERROR: routing tiles staged at $VALHALLA_TILES_FILE are missing"
  TILE_ERRORS=\$((TILE_ERRORS + 1))
fi

if [ -f "$OSM_TILES_FILE" ]; then
  dbc_say "{{MSG_MAPS}}"
  upload_to_dbc "$OSM_TILES_FILE" "/maps/map.mbtiles" "display tiles" || TILE_ERRORS=\$((TILE_ERRORS + 1))
fi
if [ -f "$VALHALLA_TILES_FILE" ]; then
  case "$VALHALLA_TILES_FILE" in
    *.zst)
      # Valhalla mmaps the tar, so it has to land uncompressed. Decompressing on
      # the DBC keeps the transfer about a third the size; zstd ships in the
      # DBC image and ums-service already installs routing tiles this way.
      dbc_say "{{MSG_ROUTING}}"
      # Which zstd unpacks this. The dashboard's own, when it has one: only
      # the 2026-08-09 image and later do, and an upgrade never writes the
      # stage-0 image that would have brought one, so a board on stable v1.2.1
      # has none and the unpack used to fail with the tiles already uploaded.
      #
      # Both checks run the thing rather than look for it. The board's own
      # zstd and the one we send are asked the same question, because "it is
      # there" and "it works here" are different questions: ours needs glibc
      # 2.38 and exists for older firmware, so only the second one matters.
      ZSTD_BIN=zstd
      if ! dbc_ssh "zstd --version >/dev/null 2>&1"; then
        log "  the dashboard has no zstd, sending one"
        if upload_to_dbc "$INSTALLER_DIR/zstd-dbc" "/installer/zstd-dbc" "zstd helper" &&
           dbc_ssh "chmod +x /data/installer/zstd-dbc && /data/installer/zstd-dbc --version >/dev/null 2>&1"; then
          ZSTD_BIN=/data/installer/zstd-dbc
          log "  using the zstd we sent"
        else
          log "ERROR: no usable zstd on the dashboard, routing tiles cannot be unpacked"
        fi
      fi
      if upload_to_dbc "$VALHALLA_TILES_FILE" "/valhalla/tiles.tar.zst" "routing tiles"; then
        if dbc_ssh "\$ZSTD_BIN -d -f -o /data/valhalla/tiles.tar.new /data/valhalla/tiles.tar.zst && mv -f /data/valhalla/tiles.tar.new /data/valhalla/tiles.tar && rm -f /data/valhalla/tiles.tar.zst"; then
          dbc_ssh "systemctl restart valhalla" 2>/dev/null || true
        else
          log "ERROR: routing tile decompression failed"
          dbc_ssh "rm -f /data/valhalla/tiles.tar.new /data/valhalla/tiles.tar.zst" 2>/dev/null || true
          TILE_ERRORS=\$((TILE_ERRORS + 1))
        fi
      else
        TILE_ERRORS=\$((TILE_ERRORS + 1))
      fi
      ;;
    *)
      if upload_to_dbc "$VALHALLA_TILES_FILE" "/valhalla/tiles.tar" "routing tiles"; then
        dbc_ssh "systemctl restart valhalla" 2>/dev/null || true
      else
        TILE_ERRORS=\$((TILE_ERRORS + 1))
      fi
      ;;
  esac
fi

# Record what landed, so the dashboard does not have to re-derive it and an
# MDB-side consumer can read it without powering the dashboard up. Failures are
# logged and ignored: the tiles are installed and working either way.
record_tiles

# Stop DBC Python upload server if we started one
if [ "\$DBC_PYTHON_STARTED" = "yes" ]; then
  dbc_ssh 'kill \$(cat /tmp/upload_srv.pid 2>/dev/null) 2>/dev/null; rm -f /tmp/upload_srv.pid /tmp/upload_srv.py' || true
fi
# This runs in a background subshell, so the count cannot be handed back in a
# variable. The parent reads it after waiting.
echo "\$TILE_ERRORS" > "\$INSTALLER_DIR/tile-errors"
}
TILES
else
  cat >> "$SCRIPTS_DIR/20-dbc.sh" << 'NOTILES'
install_tiles() { :; }
NOTILES
fi

cat >> "$SCRIPTS_DIR/20-dbc.sh" << 'ONBOOT'

log() { echo "$(date '+%H:%M:%S') $1" >> "$LOG"; }
# Log all errors, always: every command's stderr appends to the log.
exec 2>>"$LOG"

# One field of the `maps` hash, HSET then PUBLISH, matching the convention the
# rest of the platform uses so a live subscriber hears the change. Best effort:
# Redis may not be up yet this early, and the dashboard restates all of it on
# its next boot regardless.
hset_maps() {
  redis-cli -h localhost hset maps "$1" "$2" >/dev/null 2>&1 || return 0
  redis-cli -h localhost publish maps "$1" >/dev/null 2>&1 || true
}

# busybox date has no -d @epoch, so fall back to the GNU form and then to
# leaving the field unset rather than writing something unparseable.
epoch_to_iso() {
  [ -n "$1" ] || return 0
  date -u -d "@$1" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -r "$1" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || true
}

# dbc_ssh with a ceiling on how long the remote command may take.
#
# The bound is applied here and not on the dashboard: its image has no timeout
# binary, so wrapping the remote command in one fails instantly with "timeout:
# not found" and takes the install with it. Neither does the MDB's bootstrap
# image, which is where this runs for a clean install, so the bound is a
# background ssh watched from here rather than a timeout binary. $1 is
# seconds, the rest is the command.
dbc_ssh_bounded() {
  local secs="$1"; shift
  local t=0 pid waited
  while [ $t -lt 3 ]; do
    ssh -y -y root@$DBC_IP "$@" &
    pid=$!
    waited=0
    while kill -0 "$pid" 2>/dev/null && [ "$waited" -lt "$secs" ]; do
      sleep 1
      waited=$((waited + 1))
    done
    if kill -0 "$pid" 2>/dev/null; then
      log "  remote command still running after ${secs}s, giving up on it"
      kill "$pid" 2>/dev/null
      wait "$pid" 2>/dev/null
    elif wait "$pid"; then
      return 0
    fi
    t=$((t+1)); sleep 3
  done
  return 1
}

# The dashboard's own screen, used as a progress display.
#
# Nothing owns the framebuffer while the install runs: the dashboard UI is not
# started yet, so the console getty sits there showing a login prompt. Stop it,
# clear the screen and hide the cursor, then write our own lines. getty comes
# back on its own after a reboot, so this is re-run each time the board boots.
DBC_CONSOLE=/dev/tty1
# The dashboard is read at arm's length and often at an angle, so the text is
# kept clear of the panel edges: a blank line at the top and four columns on
# the left. Against the bezel, a line starting in column 0 is the first thing
# to become unreadable.
DBC_INDENT="    "

dbc_console_init() {
  # Escape sequences rather than setterm: setterm is util-linux and the
  # bootstrap image does not carry it, so it was never the path that ran.
  # \033%G selects UTF-8 so the umlauts below render, \033[?25l hides the
  # cursor, \033[2J clears, \033[H homes it.
  dbc_ssh "systemctl stop getty@tty1 2>/dev/null;
           printf '\033%%G\033[?25l\033[2J\033[H' > $DBC_CONSOLE 2>/dev/null;
           printf '\n${DBC_INDENT}%s\n\n' \"{{MSG_BANNER}}\" > $DBC_CONSOLE" \
    2>/dev/null || log "  (could not claim the dashboard console)"
}

# $1: the line to show. Best-effort throughout: the console is a courtesy and
# never a reason to fail an install.
dbc_say() {
  dbc_ssh "printf '${DBC_INDENT}%s\n' \"$1\" > $DBC_CONSOLE" 2>/dev/null || true
}

# What a failure puts on the dashboard. The laptop is unplugged by now, so
# this screen and the LEDs are the whole report, and the screen is the only
# one of the two that can say what actually went wrong.
dbc_fail_say() {
  dbc_say ""
  dbc_say "{{MSG_FAILED}}"
  dbc_say "$1"
  dbc_say ""
  dbc_say "{{MSG_SWAP_1}}"
  dbc_say "{{MSG_SWAP_2}}"
}

# Signalling, from the same file the trampoline and the other phases source.
# This runs first, before the slower service stops and the LP5562 init below,
# so the bar the run left behind is back as early as possible: this phase is
# entered either straight from the trampoline or on the far side of a boot,
# and on the second the vehicle has been dark for forty seconds.
. "$SCRIPTS_DIR/signal.sh" || { echo "missing $SCRIPTS_DIR/signal.sh" >&2; exit 1; }
progress_render

# dbc_ssh, wait_dbc_ssh and the dashboard power helpers (dbc_power_on/off,
# dbc_power_on_wait/off_wait, dbc_gpio_ready), same story: sourced here and
# from the trampoline's own half rather than defined twice.
. "$SCRIPTS_DIR/device.sh" || { echo "missing $SCRIPTS_DIR/device.sh" >&2; exit 1; }

# This is segment 3: the dashboard's own firmware, and the map and routing
# tiles on top of it. Segment 2, the main board's artifact, is already running
# alongside it under 10-mdb-artifact.sh, which is why both can be lit at once.
progress_set "$SEGMENT_DBC" active

log "Onboot: post-reboot DBC tile installation"

# Stop+mask keycard / ums services so they can't race us on the LP5562 i2c
# bus (keycard) or grab the OTG UDC (ums). The trampoline already masked them
# before the flash, but re-asserting here is cheap insurance against weird
# boot orderings. bluetooth-service is left alone for the reason given at
# the trampoline's own stop: the nRF52 watchdog power-cycles the board when
# it goes quiet.
systemctl stop librescoot-keycard keycard-service 2>/dev/null || true
systemctl mask librescoot-keycard keycard-service 2>/dev/null || true
systemctl stop librescoot-ums 2>/dev/null || true
systemctl mask librescoot-ums 2>/dev/null || true
# pm-service is stopped rather than masked, so it comes back on any boot. On
# the reboot path into this script that means it is running for the artifact
# install and the tile copy, free to suspend or hibernate the board mid
# transfer and leave the status stuck at running on a dark scooter. The finish
# restarts it deliberately by rebooting.
systemctl stop librescoot-pm 2>/dev/null || true

# The install is still running, so the dashboard LED stays amber and the guard
# keeps re-asserting it. It goes dark in 90-finalize.sh, on the far side of the
# reboot, because that is where the run actually ends.
signal_install_start

# Do NOT delete ourselves here. onboot.sh used to remove itself before doing any
# work, so a crash after this point left the vehicle with keycard, bluetooth and
# ums masked, pm stopped, and nothing that would ever run again to undo it: a
# scooter nobody can unlock and no light saying why. Retiring the script is now
# the last act of the success branch (and of the give-up branch below), so an
# interrupted run is simply retried on the next boot.
#
# Bounded, so a script that crashes every time cannot loop forever. On the last
# attempt we stop protecting the install and start protecting the owner: unmask
# what we masked, so the vehicle can at least be unlocked, and go red.
# Retiring the script is deliberately a function, so both the success branch and
# the give-up branch stop it running again, and nothing else does.
# Removing the phase is the whole of retiring. /data/onboot.sh belongs to the
# coordinator, which sees an empty scripts directory and takes itself out,
# putting back a user's own onboot.sh if it displaced one.
retire_onboot() {
  rm -f "$SCRIPTS_DIR/20-dbc.sh" "$SCRIPTS_DIR/20-dbc.sh.tries"
}

# Read, not written: the coordinator counts the attempt before making it, so
# by the time this runs the number is already on disk.
ONBOOT_TRIES=$(cat "$SCRIPTS_DIR/20-dbc.sh.tries" 2>/dev/null || echo 1)
log "Onboot attempt $ONBOOT_TRIES/3"
# Everything that turns a finished install into a scooter the user can ride
# away on: settings, the choices from the welcome screen, the completion
# record a returning laptop reads, and the reboot that puts back what the
# install stopped.
#
# Defined here rather than beside its use: the generated script runs top to
# bottom and the shortcut success below calls this long before the tail of
# the file is reached.
device_finish() {
    CURRENT_STAGE="finishing-on-device"
    write_run_state "$CURRENT_STAGE"
    DBC_COMPLETED_VERSION="$(cat "$INSTALLER_DIR/dbc-version" 2>/dev/null)"
    # ---- Autonomous finish ------------------------------------------------
    # Everything here is what the installer's finish phase would otherwise do
    # over the laptop link. Doing it on the device is what lets the user walk
    # away after the cable swap. Every input was known before the swap.
    #
    # Order matters: restore the settings first, then write the user's choices
    # on top. Reversed, the restore clobbers the choices.
    # The settings restore, the owner's choices, ending service mode, the
    # unlock and the completion record are all 90-finalize.sh now, queued by
    # the installer and run by the coordinator after this phase. They were
    # written twice, here and across the installer's finish, and the two had
    # drifted.
    if [ "$FINISH_ON_DEVICE" != "true" ]; then
      write_status "success" "mode: $MODE" "mdb: $MDB_TARGET" \
        "dbc: $DBC_COMPLETED_VERSION" \
        "tiles: ${TILES_SKIPPED:-no}"
    fi
    # The dashboard half is done: image installed, tiles uploaded, board
    # powered off. Only that half. The main board is very likely still writing
    # its own artifact, 80-reboot.sh joins the two and 90-finalize.sh hands the
    # vehicle back, so this fills its own segment and touches nothing else. It
    # used to declare the whole run finished here, blinking the LED green and
    # fading the bar out while the other half was still running.
    progress_set "$SEGMENT_DBC" done
    # The install is over, so the board runs what a board runs. A service left
    # stopped here stays stopped: there is no laptop attached any more and no
    # reboot coming to start it by other means, and the last instruction the
    # owner was given ("unlock with a keycard you registered") needs the reader.
    systemctl unmask librescoot-keycard keycard-service 2>/dev/null || true
    systemctl start librescoot-keycard 2>/dev/null || systemctl start keycard-service 2>/dev/null || true
    log "  started keycard-service"
    # Unmask + start bluetooth - the installer's bluetoothPairing phase
    # needs it running. No equivalent "wait for explicit start" concern.
    systemctl unmask librescoot-bluetooth 2>/dev/null || true
    systemctl start librescoot-bluetooth 2>/dev/null || true
    # Re-enable UMS now that all USB-host work on the OTG UDC is done.
    #
    # ums-service builds its 1 GiB backing store with dd if=/dev/zero as the
    # first thing it does, before it answers anything. On eMMC that is most of
    # a minute of solid writes with the service unresponsive, landing exactly
    # where the user reconnects. It only checks whether the file exists, so a
    # sparse one made here is accepted and the dd never runs.
    if [ ! -f /data/usb.drive ]; then
      log "  pre-creating the UMS backing store"
      if truncate -s 1G /data/usb.drive 2>/dev/null &&
         mkfs.fat -F 32 /data/usb.drive >/dev/null 2>&1; then
        log "  UMS backing store ready"
      else
        log "  could not pre-create it, ums-service will build its own"
        rm -f /data/usb.drive
      fi
    fi
    systemctl unmask librescoot-ums 2>/dev/null || true
    systemctl start librescoot-ums 2>/dev/null || true

    if [ "$FINISH_ON_DEVICE" = "true" ]; then
      # Sweep after the last staging consumer, so nothing below can mistake
      # leftover upload data for work still in progress. /data/ota remains as
      # the later OTA delta base.
      #
      # Retire before the sweep: retiring removes this phase from the scripts
      # directory, and the coordinator reads that directory afterwards to
      # decide what to run next. 90-finalize.sh is still in there, which is
      # what keeps the coordinator alive to run it.
      log "  retiring this phase"
      retire_onboot
      # The sweep takes the log with it, and this is the run whose log nobody
      # can ever produce: a failure keeps $INSTALLER_DIR for the installer to
      # read, a success is the one that deletes its own account of itself, so
      # a user reporting a successful install has only the laptop's half of
      # it. Keep it beside the run record and keep writing to that copy.
      mkdir -p "$RUN_HISTORY_DIR/$RUN_ID"
      cp "$LOG" "$RUN_HISTORY_DIR/$RUN_ID/trampoline.log" 2>/dev/null
      # The trampoline has done its part. Left in the scripts directory, which
      # the sweep spares, it counted as a leftover on the laptop's next connect
      # and a finished install was announced as an interrupted one.
      rm -f "$SCRIPTS_DIR/trampoline.sh"
      # Selective: the record, the logs, the queued phases and a displaced
      # onboot.sh all live under $INSTALLER_DIR now, and an rm -rf takes the
      # account of the run with it along with the phase that has not run yet.
      # mdb-artifact.result survives: 80-reboot.sh joins on it and runs
      # after this sweep. Losing it reads as an install that never finished,
      # which stops the reboot and strands the board on the bootstrap image.
      # trampoline-phase is the bar: 80-reboot.sh and the finalize light the
      # handover on top of it, and without it they relight with the rest of
      # the bar dark. stop-error-signals.sh is what the laptop runs to end a
      # red blink, and a failure after this point still raises one.
      find "$INSTALLER_DIR" -mindepth 1 -maxdepth 1 \
        ! -name history ! -name scripts ! -name onboot.sh.bak \
        ! -name last-install ! -name run-state \
        ! -name mdb-artifact.result \
        ! -name trampoline-phase ! -name stop-error-signals.sh \
        -exec rm -rf {} + 2>/dev/null || true
      LOG="$RUN_HISTORY_DIR/$RUN_ID/trampoline.log"
      log "  kept this log at $LOG"
      CURRENT_STAGE="handing-back"
      # Said here rather than from the finalize, which has no link to the
      # dashboard and runs seconds later: the DBC work is over, and this is the
      # last chance to put anything on a screen the owner is watching.
      dbc_say ""
      dbc_say "{{MSG_DONE}}"
      log "  leaving the handover to 90-finalize.sh"
    else
      retire_onboot
    fi
}

if [ "$ONBOOT_TRIES" -gt 3 ]; then
  log "ERROR: onboot has failed 3 times, giving up and restoring service"
  retire_onboot
  systemctl unmask librescoot-keycard keycard-service 2>/dev/null || true
  systemctl unmask librescoot-bluetooth 2>/dev/null || true
  systemctl start librescoot-bluetooth 2>/dev/null || true
  systemctl unmask librescoot-ums 2>/dev/null || true
  systemctl start librescoot-ums 2>/dev/null || true
  CURRENT_STAGE="post-reboot-retries-exhausted"
  write_status \
    "error: the post-reboot stage failed $((ONBOOT_TRIES - 1)) times and was abandoned" \
    "mode: $MODE"
  dbc_fail_say "{{MSG_FAIL_ONBOOT}}"
  signal_error
  exit 1
fi

# Brief wait for MDB services to settle - historically 20 s. Most of that
# was just defensive; redis is ready within a few seconds of MDB boot.
# Poll redis directly so we wait exactly as long as we have to.
log "  waiting for MDB redis..."
CURRENT_STAGE="waiting-mdb-redis"
write_run_state "$CURRENT_STAGE"
WAITED=0
while [ $WAITED -lt 30 ]; do
  redis-cli -h localhost ping >/dev/null 2>&1 && break
  WAITED=$((WAITED + 1))
  sleep 1
done
if redis-cli -h localhost ping >/dev/null 2>&1; then
  log "  redis ready after ${WAITED}s"
else
  log "  WARNING: redis never answered in ${WAITED}s, continuing anyway"
fi

# Keep trying dbc on-wait until it succeeds - DBC may restart several times
log "  powering on DBC (may take multiple attempts)..."
CURRENT_STAGE="powering-dbc"
write_run_state "$CURRENT_STAGE"
ATTEMPTS=0
while [ $ATTEMPTS -lt 5 ]; do
  ATTEMPTS=$((ATTEMPTS + 1))
  log "  dbc on-wait attempt $ATTEMPTS..."
  dbc_power_on_wait && break
  # A request that was already high is not a new request. Drop it, let the
  # rail settle, and ask again: a board that ignored the first ask answers
  # a cycle.
  log "  attempt $ATTEMPTS failed, power-cycling the dashboard and retrying..."
  dbc_power_off || true
  sleep 5
done

# Wait for DBC to be stable. Requires 10s of consecutive ping success.
# Was 20s - the resize-induced reboot is the only thing that breaks the
# ping stream, and the in-loop handler below already covers that. 10s of
# stable pings is plenty to confirm we're past the resize.
log "  waiting for DBC to be stable (10s consecutive ping)..."
STABLE=0
ELAPSED=0
while [ $STABLE -lt 10 ] && [ $ELAPSED -lt 300 ]; do
  if ping -c 1 -W 2 $DBC_IP >/dev/null 2>&1; then
    STABLE=$((STABLE + 1))
  else
    if [ $STABLE -gt 0 ]; then
      log "  ping dropped after ${STABLE}s stable - DBC rebooting, waiting 5s then turning on..."
      sleep 5
      dbc_power_on || true
    fi
    STABLE=0
  fi
  ELAPSED=$((ELAPSED + 2))
  sleep 1
done
log "  DBC stable after ${ELAPSED}s (stable_count=$STABLE)"
# The dashboard is answering, so the cable is on it. An upgrade never reached
# the trampoline's own stop, because it never talks to the dashboard at all,
# and this is the first moment on that path where the wait is provably over.
front_pulse_stop

# Stay on phase 2 (BR breathing = "MDB & DBC restart") through the SSH wait.
# Re-establishing the DBC connection is part of the restart, not the copy, so
# advancing to phase 3 (BL = "maps") happens only once the actual upload
# starts. That keeps the two distinguishable: a BR blinker stuck breathing
# means the DBC never came back (USB/boot issue), a stuck BL means the data
# copy itself is slow.
# Wait for SSH, re-asserting DBC power as we go. A freshly flashed DBC
# reboots once on first boot to apply its boot-partition (u-boot) update,
# and that update's `complete-dbc` makes vehicle-service power the DBC off
# if the vehicle is in standby. Either way the DBC drops off the bus. So
# whenever it's unpingable, cycle its power: off, a settle, on. A request
# line that is already high is not a new request, and a board that ignored
# it once answers the cycle. The boot update only fires once, so it comes up
# and stays up. Poll, not a blind
# wait: breaks the instant the DBC answers. Skipping tiles = no offline maps.
log "  waiting for DBC SSH..."
CURRENT_STAGE="waiting-dbc-ssh"
write_run_state "$CURRENT_STAGE"
ELAPSED=0
while [ $ELAPSED -lt 300 ]; do
  ssh -y -y root@$DBC_IP 'echo ok' >/dev/null && break
  if ! ping -c 1 -W 2 $DBC_IP >/dev/null 2>&1 && [ $((ELAPSED % 20)) -eq 0 ]; then
    log "  DBC unreachable - power-cycling it"
    dbc_power_off || true
    dbc_power_on || true
  fi
  ELAPSED=$((ELAPSED + 5))
  sleep 5
done

if [ $ELAPSED -ge 300 ]; then
  if [ -n "$DBC_MENDER" ]; then
    log "ERROR: DBC not reachable after 300s, artifact not installed"
    CURRENT_STAGE="waiting-dbc-ssh"
    write_status "error: DBC not reachable, artifact not installed"
    # Power the DBC down like the success branch below does, so a failed
    # install does not leave it drawing on the aux battery indefinitely.
    dbc_fail_say "{{MSG_FAIL_DBC}}"
    dbc_power_off || true
    signal_error
    exit 1
  fi
  # The artifact is on; the dashboard just did not come back in time for the
  # maps. That is a finished install missing its maps, so it takes the same
  # finish as every other success: the settings restore, the completion record
  # the returning laptop reads, and the reboot are all still owed.
  log "WARNING: DBC not reachable after 300s, skipping tiles"
  TILES_SKIPPED="yes"
  dbc_power_off || true
  device_finish || exit 1
  exit 0
fi
log "  DBC reachable"
dbc_console_init

# Make sure something on the DBC can take a PUT under /data. data-server
# identifies itself via the Server response header; older DBC images have
# none, so fall back to a small Python PUT server. Both are rooted at /data,
# so the URL layout is identical. Call this again after any DBC reboot: a
# reboot takes the Python fallback with it, and only the caller knows when
# one happened.
DBC_PYTHON_STARTED="no"
ensure_dbc_upload_server() {
DBC_PYTHON_STARTED="no"
# data-server ships in every image this installer can put on a dashboard, so a
# probe that fails means it has not started yet far more often than it means
# absent. Give it the boot it is still in the middle of.
DBC_HAS_DATA_SERVER=""
for PROBE_TRY in 1 2 3 4 5 6; do
  if curl -sSI --connect-timeout 10 --max-time 20 "http://$DBC_IP:8080/" 2>/dev/null | grep -qi "^Server: librescoot-data-server"; then
    DBC_HAS_DATA_SERVER="yes"
    break
  fi
  [ "$PROBE_TRY" -lt 6 ] && sleep 10
done
if [ "$DBC_HAS_DATA_SERVER" = yes ]; then
  log "  DBC has data-server running"
else
  log "  DBC lacks data-server, starting Python fallback..."
  dbc_ssh 'cat > /tmp/upload_srv.py << "PYEOF"
import http.server
import os

class H(http.server.BaseHTTPRequestHandler):
    def do_PUT(self):
        p = "/data" + self.path
        os.makedirs(os.path.dirname(p), exist_ok=True)
        l = int(self.headers["Content-Length"])
        with open(p, "wb") as f:
            r = l
            while r > 0:
                c = self.rfile.read(min(65536, r))
                if not c:
                    break
                f.write(c)
                r -= len(c)
        self.send_response(200)
        self.end_headers()

    def log_message(self, *a):
        pass

with open("/tmp/upload_srv.pid", "w") as pf:
    pf.write(str(os.getpid()))

http.server.HTTPServer(("0.0.0.0", 8080), H).serve_forever()
PYEOF
nohup python3 /tmp/upload_srv.py > /dev/null 2>&1 &' && DBC_PYTHON_STARTED="yes" || log "WARNING: failed to start DBC upload server"
  sleep 2
fi
}  # end of ensure_dbc_upload_server; body is unindented because the PYEOF
   # heredoc terminator and the Python source below it are column-sensitive.
ensure_dbc_upload_server

# Upload one file to the DBC. $2 is the path under /data, so
# upload_to_dbc /x/y.mender /ota/dbc/y.mender writes /data/ota/dbc/y.mender.
# Lives here rather than in the appended tile block because the artifact
# install below needs it whether or not tiles were selected.
upload_to_dbc() {
  local src="$1" dst="$2" name="$3"
  local attempt=0
  while [ $attempt -lt 3 ]; do
    attempt=$((attempt + 1))
    log "  uploading $name (attempt $attempt/3)..."
    # -f so an HTTP 405/5xx is a failure. Without it curl exits 0 on an
    # error response and we would log the upload as done, only finding out
    # when mender cannot find the file.
    if curl -f -T "$src" --connect-timeout 15 \
         --speed-limit 10240 --speed-time 120 \
         "http://$DBC_IP:8080$dst" 2>>"$LOG"; then
      log "  $name done"
      return 0
    fi
    log "  $name upload failed, restarting DBC..."
    dbc_power_on_wait || true
    # The power cycle took any Python fallback server with it, and on a clean
    # install that fallback is the only PUT endpoint the DBC has, so attempts
    # 2 and 3 cannot succeed without bringing it back.
    ensure_dbc_upload_server
    sleep 5
  done
  log "ERROR: $name upload failed after 3 attempts"
  return 1
}

# Bail out of the artifact install. Takes back any command we queued on
# scooter:update:dbc (it is a persistent queue, so one nobody consumed gets
# popped by the next update-service that ever starts on this board and
# reinstalls the artifact behind the user's back), powers the DBC down so a
# failed install does not sit draining the aux battery, and leaves the red
# blink and hazards for whoever comes back to the vehicle. $1 becomes the
# status file's first line and must start with "error: ".
DBC_UPDATE_CMD=""
artifact_fail() {
  log "ERROR: $1"
  dbc_fail_say "$1"
  if [ -n "$DBC_UPDATE_CMD" ]; then
    redis-cli -h localhost lrem scooter:update:dbc 0 "$DBC_UPDATE_CMD" >/dev/null 2>&1 || true
    DBC_UPDATE_CMD=""
  fi
  CURRENT_STAGE="installing-dbc-artifact"
  write_status "$1"
  dbc_power_off || true
  signal_error
  exit 1
}

# Install the DBC artifact, if one was staged. This runs in both modes: a
# clean install has just written the stage-0 image and the DBC is booted into
# it, and an upgrade skipped straight here. /data survives a mender install,
# so tiles copied afterwards are unaffected by the reboot below.
if [ -n "$DBC_MENDER" ]; then
  # The trampoline body checked this before it rebooted the MDB, but the
  # reboot sits between the two. An artifact that was asked for and is not
  # here is an error, never "no artifact was requested".
  [ -f "$DBC_MENDER" ] || artifact_fail "error: DBC artifact missing on the MDB: $DBC_MENDER"

  # Tiles go up while the dashboard still runs the stage-0 image. That image is
  # pinned, so it is the one place whose contents the installer controls; the
  # firmware being installed on top may predate any tool the upload needs,
  # zstd included.
  #
  # It runs alongside the artifact install rather than before it: the two touch
  # different partitions, the artifact write is the long pole at roughly a
  # minute and a half, and the upload is about twenty seconds of that. Only the
  # reboot afterwards has to wait, because a dashboard that restarts mid-upload
  # takes a truncated tile set with it.
  rm -f "$INSTALLER_DIR/tile-errors"
  install_tiles &
  TILES_JOB=$!

  DBC_ART_NAME=$(basename "$DBC_MENDER")
  DBC_ART_PATH="/data/ota/dbc/$DBC_ART_NAME"
  log "Installing DBC artifact $DBC_ART_NAME"
  dbc_say "{{MSG_INSTALLING}}"

  # What the board runs right now, so a reboot that changes nothing can be
  # told from one that installed something. Read before anything is written.
  DBC_VER_BEFORE=$(ssh -y -y root@$DBC_IP 'grep ^VERSION_ID= /etc/os-release' 2>/dev/null | cut -d= -f2 | tr -d '"')
  DBC_ART_BEFORE=$(ssh -y -y root@$DBC_IP 'mender-update show-artifact' 2>/dev/null | head -n 1 | tr -d '\r')
  log "  DBC currently runs ${DBC_VER_BEFORE:-unknown} (artifact ${DBC_ART_BEFORE:-unknown})"

  dbc_ssh "mkdir -p /data/ota/dbc" || log "WARNING: mkdir /data/ota/dbc failed"

  # A full /data on the DBC would otherwise surface as three failed curl
  # attempts with a power cycle between each, ending ten minutes later in a
  # message about the transfer rather than about the disk. Same 64 MiB
  # margin the MDB's own preflight uses.
  DBC_ART_BYTES=$(stat -c %s "$DBC_MENDER" 2>/dev/null || wc -c < "$DBC_MENDER")
  DBC_NEED_KB=$((DBC_ART_BYTES / 1024 + 65536))
  DBC_FREE_KB=$(ssh -y -y root@$DBC_IP 'df -kP /data' 2>/dev/null | awk 'NR==2 {print $4}')
  case "$DBC_FREE_KB" in
    ''|*[!0-9]*)
      log "  could not read DBC free space, transferring anyway"
      ;;
    *)
      log "  DBC /data has ${DBC_FREE_KB}K free, needs ${DBC_NEED_KB}K"
      if [ "$DBC_FREE_KB" -lt "$DBC_NEED_KB" ]; then
        artifact_fail "error: not enough space on the DBC: ${DBC_FREE_KB}K free in /data, ${DBC_NEED_KB}K needed for $DBC_ART_NAME"
      fi
      ;;
  esac

  if ! upload_to_dbc "$DBC_MENDER" "/ota/dbc/$DBC_ART_NAME" "DBC artifact"; then
    artifact_fail "error: failed to transfer the DBC artifact"
  fi

  DBC_OTA_OK="no"
  if [ "$MODE" = "upgrade" ]; then
    # The board already runs update-service, so hand the artifact to it: it
    # checks the artifact fits the target slot before running mender, and it
    # applies the boot assets from the new rootfs at first start. It listens
    # on the MDB's redis, not the DBC's.
    #
    # Flash mode deliberately does not do this. A stage-0 board has no
    # update-service to answer, and scooter:update:dbc is a persistent queue,
    # so the command would simply sit there until the rootfs we are about to
    # install boots one, which would then reinstall the same artifact minutes
    # after the installer told the user the job was done.
    DBC_UPDATE_CMD="update-from-file:$DBC_ART_PATH"
    redis-cli -h localhost hset ota status:dbc "" >/dev/null 2>&1 || true
    redis-cli -h localhost lpush scooter:update:dbc "$DBC_UPDATE_CMD" >/dev/null 2>&1 || true

    DBC_OTA_VERDICT="timeout"
    DBC_OTA_DRAINED="no"
    WAITED=0
    while [ $WAITED -lt 900 ]; do
      ST=$(redis-cli -h localhost hget ota status:dbc 2>/dev/null)
      case "$ST" in
        pending-reboot|success) DBC_OTA_VERDICT="ok"; break ;;
        error*|failed*) DBC_OTA_VERDICT="refused"; break ;;
      esac
      # Nothing picked the command up within 60s, so nothing is listening.
      # Take it back out of the queue before falling back to mender, or it
      # outlives this script.
      if [ "$DBC_OTA_DRAINED" = "no" ] && [ $WAITED -ge 60 ] && [ -z "$ST" ]; then
        DBC_OTA_DRAINED="yes"
        # lrem prints how many it removed. A redis that is not answering prints
        # nothing, which is not "0" and so used to read as "someone else took
        # it": the script then waited out the full handshake timeout and blamed
        # the artifact. Ask redis whether it is there before reading its answer.
        LREM_OUT="$(redis-cli -h localhost lrem scooter:update:dbc 0 "$DBC_UPDATE_CMD" 2>/dev/null)"
        if ! redis-cli -h localhost ping >/dev/null 2>&1; then
          log "  redis is not answering, cannot hand off to update-service"
          DBC_UPDATE_CMD=""
          DBC_OTA_VERDICT="absent"
          break
        fi
        if [ "$LREM_OUT" = "0" ]; then
          # It was popped between two polls after all, so an update-service
          # does exist here. Keep waiting rather than becoming a second
          # writer on the same slot.
          log "  queued command was consumed between polls, staying on the handshake"
        else
          DBC_UPDATE_CMD=""
          DBC_OTA_VERDICT="absent"
          break
        fi
      fi
      WAITED=$((WAITED + 5))
      sleep 5
    done

    case "$DBC_OTA_VERDICT" in
      ok)
        DBC_OTA_OK="yes"
        DBC_UPDATE_CMD=""
        log "  update-service reports: $ST"
        ;;
      absent)
        log "  no update-service response, installing with mender directly"
        ;;
      refused)
        # update-service has already judged this artifact unfit for the
        # target slot. Calling mender ourselves would reinstall exactly what
        # it refused and would skip the boot assets it applies at first start.
        artifact_fail "error: DBC update-service refused the artifact: $ST"
        ;;
      *)
        # 900s with the handshake still in progress. The install may well be
        # in flight, so a direct mender call here would be a second writer.
        artifact_fail "error: DBC artifact install timed out after 900s (status: ${ST:-none})"
        ;;
    esac
  fi

  if [ "$DBC_OTA_OK" != "yes" ]; then
    log "  running mender-update install on the DBC"
    if ! dbc_ssh_bounded 900 "mender-update install $DBC_ART_PATH"; then
      artifact_fail "error: DBC artifact install failed"
    fi
  fi

  dbc_say "{{MSG_INSTALLED}}"
  # The upload has to be finished before the dashboard goes down under it.
  if [ -n "${TILES_JOB:-}" ]; then
    log "  waiting for the tile upload to finish before rebooting"
    wait "$TILES_JOB" 2>/dev/null || true
    TILES_JOB=""
    TILE_ERRORS=$(cat "$INSTALLER_DIR/tile-errors" 2>/dev/null || echo 0)
    case "$TILE_ERRORS" in ''|*[!0-9]*) TILE_ERRORS=0 ;; esac
    log "  tile upload finished with $TILE_ERRORS error(s)"
  fi

  log "  rebooting DBC into the new rootfs"
  dbc_ssh 'sync; reboot &' >> "$LOG" 2>&1 || log "  DBC reboot command failed"
  sleep 20
  ELAPSED=0
  while [ $ELAPSED -lt 300 ]; do
    ssh -y -y root@$DBC_IP 'echo ok' >/dev/null 2>&1 && break
    if ! ping -c 1 -W 2 $DBC_IP >/dev/null 2>&1 && [ $((ELAPSED % 20)) -eq 0 ]; then
      dbc_power_on || true
    fi
    ELAPSED=$((ELAPSED + 5))
    sleep 5
  done
  if [ $ELAPSED -ge 300 ]; then
    artifact_fail "error: DBC did not come back after the artifact install"
  fi
  # Nothing here has proven the install took. u-boot rolls back a rootfs that
  # never commits, and the rolled-back board answers SSH on the old version
  # exactly as happily. An unreadable version is a failure too: written out
  # empty it renders as an absent dbc: line and the screen falls back to a
  # bare success message.
  DBC_VER=$(ssh -y -y root@$DBC_IP 'grep ^VERSION_ID= /etc/os-release' 2>/dev/null | cut -d= -f2 | tr -d '"')
  CURRENT_STAGE="verifying-dbc-artifact"
  write_run_state "$CURRENT_STAGE"
  DBC_ART_AFTER=$(ssh -y -y root@$DBC_IP 'mender-update show-artifact' 2>/dev/null | head -n 1 | tr -d '\r')
  log "  DBC now runs ${DBC_VER:-unknown} (artifact ${DBC_ART_AFTER:-unknown})"
  dbc_console_init
  dbc_say "{{MSG_RUNNING}}"
  [ -n "$DBC_VER" ] || artifact_fail "error: could not read the DBC version after the artifact install"
  if [ -n "$DBC_TARGET" ]; then
    # Lower-cased and with the tag's optional v prefix dropped, the same
    # normalisation the installer applies to the MDB.
    DBC_VER_N=$(echo "$DBC_VER" | tr 'A-Z' 'a-z' | sed 's/^v//')
    DBC_TARGET_N=$(echo "$DBC_TARGET" | tr 'A-Z' 'a-z' | sed 's/^v//')
    if [ "$DBC_VER_N" != "$DBC_TARGET_N" ]; then
      artifact_fail "error: the DBC came back on $DBC_VER instead of $DBC_TARGET, so the artifact install was rolled back"
    fi
  elif [ "$DBC_VER" = "$DBC_VER_BEFORE" ] && [ "$DBC_ART_AFTER" = "$DBC_ART_BEFORE" ]; then
    # No target to compare against, so fall back to "did anything change at
    # all": a rollback leaves both readings exactly as they were.
    artifact_fail "error: the DBC came back unchanged on $DBC_VER, so the artifact install was rolled back"
  fi
  # os-release cannot tell a stage-0 image from a full one, same distro and
  # same VERSION_ID, so a clean install that rolled back would pass the
  # version check above. The artifact name is the discriminator.
  case "$DBC_ART_AFTER" in
    *minimal*)
      artifact_fail "error: the DBC is still running the bootstrap image ($DBC_ART_AFTER) after the artifact install"
      ;;
  esac
  # Committed here, after the checks above proved this is the installed slot,
  # and before anything cuts the power. bootlimit=1 gives the new slot exactly
  # one tentative boot, this one: u-boot rolls back at the second start before
  # the kernel loads, so no later boot can commit. The DBC's update-service
  # does commit at its own start, but it races the power-off below with no
  # ordering, and on a clean install the rollback target is the bootstrap,
  # which does not carry it at all. A rolled-back board fails the checks
  # first, so this never pins the old slot.
  # A missed commit is a rollback on the next boot, so it is worth waiting and
  # retrying for: the checks above can pass seconds after the reboot, while
  # dropbear is still coming up and every ssh gets connection refused.
  wait_dbc_ssh 120 || log "  WARNING: DBC SSH did not settle before the commit"
  DBC_COMMITTED=""
  for COMMIT_TRY in 1 2 3 4 5; do
    if ssh -y -y root@$DBC_IP 'mender-update commit' >/dev/null 2>&1; then
      DBC_COMMITTED="yes"
      log "  committed the DBC slot (attempt $COMMIT_TRY)"
      break
    fi
    log "  commit attempt $COMMIT_TRY/5 failed, retrying..."
    sleep 10
  done
  # Already committed reads as a failure from mender-update, so ask the board
  # rather than trusting the exit code: the state it is in is what matters.
  if [ "$DBC_COMMITTED" != yes ]; then
    case "$(ssh -y -y root@$DBC_IP 'mender-update show-artifact' 2>/dev/null)" in
      *minimal*|'') artifact_fail "error: the DBC slot could not be committed and will roll back on its next boot" ;;
      *) log "  the DBC reports the installed artifact, treating the slot as committed" ;;
    esac
  fi
  echo "$DBC_VER" > "$INSTALLER_DIR/dbc-version"

  # The reboot above took any Python fallback server with it, and the tile
  # block below uploads over the same link, so re-probe now.
  ensure_dbc_upload_server
fi

# Tiles without an artifact: the dashboard is being left on its current
# firmware and only the maps are being replaced. Nothing has been started
# above in that case, so it runs here, in the foreground, with nothing to
# overlap it.
if [ -z "${TILES_JOB:-}" ] && [ -z "$DBC_MENDER" ]; then
  CURRENT_STAGE="installing-tiles"
  write_run_state "$CURRENT_STAGE"
  install_tiles
  TILE_ERRORS=$(cat "$INSTALLER_DIR/tile-errors" 2>/dev/null || echo 0)
  case "$TILE_ERRORS" in ''|*[!0-9]*) TILE_ERRORS=0 ;; esac
fi

# A run that started the upload but never reached the reboot that joins it,
# because the artifact install bailed out down a path that does not exit.
if [ -n "${TILES_JOB:-}" ]; then
  wait "$TILES_JOB" 2>/dev/null || true
  TILE_ERRORS=$(cat "$INSTALLER_DIR/tile-errors" 2>/dev/null || echo 0)
  case "$TILE_ERRORS" in ''|*[!0-9]*) TILE_ERRORS=0 ;; esac
fi
ONBOOT

# Append tile installation commands with actual paths

cat >> "$SCRIPTS_DIR/20-dbc.sh" << 'ONBOOT_END'
# Turn off DBC
dbc_power_off || true

if [ "${TILE_ERRORS:-0}" -gt 0 ]; then
  log "=========================================="
  log "Installation FAILED - $TILE_ERRORS tile upload(s) failed"
  log "=========================================="
  CURRENT_STAGE="installing-tiles"
  write_status "error: $TILE_ERRORS tile upload(s) failed"
  dbc_fail_say "{{MSG_FAIL_TILES}}" 
  # Amber gives way to a red blink and the hazards. Both stop on installer
  # reconnect, via /data/installer/stop-error-signals.sh.
  signal_error
  # Non-zero, like every other failure in this phase: the coordinator stops
  # here and keeps this phase queued for the retry. Returning 0 let it carry
  # on to 80-reboot.sh, which rebooted into the new image with this phase
  # still on disk, and the next boot re-ran the whole dashboard flow.
  exit 1
else
  log "=========================================="
  log "Installation complete - SUCCESS"
  log "=========================================="

  device_finish || exit 1
fi
ONBOOT_END
chmod +x "$SCRIPTS_DIR/20-dbc.sh"
log "  onboot.sh written"

# Mark the job as still running. The dashboard has not been touched yet:
# onboot.sh below does all of it. A laptop that reads the file at this point
# must keep waiting, which is why this is not a shade of success.
write_status "running"

step_end  # close step 8
log "Total trampoline wall-clock: $(($(date +%s) - SCRIPT_T0))s"

# Nothing here touches the lights. The bar is persisted and every loop driving
# it is its own systemd unit, so the animation, the amber and the front-light
# pulse all carry on unbroken into the coordinator and, if it comes to one,
# across the reboot.
[ -n "$JOURNAL_PID" ] && kill $JOURNAL_PID 2>/dev/null

# The dashboard work lives in onboot.sh and is reached one of two ways.
#
# The only thing a reboot contributes is gadget mode: the flash leaves the
# controller in host, and the dashboard has to enumerate the MDB as a gadget
# to be reachable over ethernet again. The controller flips at runtime in
# well under a second (scripts/verify-usb-role.sh measures it), against
# forty seconds of reboot during which every light on the scooter is dark
# and the user has nothing to read.
#
# So restore the role and run onboot.sh directly, and keep the reboot for
# when that does not work. onboot.sh is written out either way, because the
# rescue and watchdog paths still reboot into it, and it retires itself once
# it is done, so it cannot run twice.
#
# It goes into its own unit rather than inheriting this scope: this script
# is about to exit, and onboot.sh outlives it by many minutes.
if restore_gadget; then
  log "  gadget restored without a reboot, handing over to onboot.sh"
  systemctl stop librescoot-onboot-inline.service 2>/dev/null
  if systemd-run --unit=librescoot-onboot-inline --collect --quiet \
      --slice=system.slice /bin/sh /data/onboot.sh; then
    exit 0
  fi
  # Nothing is scheduled to run onboot.sh now, and the status file still says
  # running. The reboot below is what the boot path needs to pick it up.
  log "  could not start onboot.sh as a unit, rebooting into it instead"
fi

log "  gadget restore failed, falling back to a reboot"
log "  rebooting MDB..."
reboot

#!/bin/sh
# 80-reboot.sh — the one reboot. Generated by the installer.
#
# The MDB has been running the bootstrap image the whole way through: writing
# an artifact does not activate it. This is what puts both boards onto the
# images the owner asked for.
#
# It sits between the dashboard phase and the handover because 90-finalize.sh
# unlocks, and the vehicle should be on its real image by the time it does.
#
# Joins on 10-mdb-artifact.sh, which installs in the background so its write
# overlaps the dashboard work rather than following it.

INSTALLER_DIR="/data/installer"
SCRIPTS_DIR="$INSTALLER_DIR/scripts"
RESULT_FILE="$INSTALLER_DIR/mdb-artifact.result"
STATUS_FILE="$INSTALLER_DIR/trampoline-status"
RUN_ID="{{RUN_ID}}"
LOG="$INSTALLER_DIR/history/$RUN_ID/reboot.log"
WAIT_LIMIT={{MDB_ARTIFACT_WAIT_SECONDS}}
# How long a graceful reboot gets before the forced one.
REBOOT_FALLBACK={{REBOOT_FALLBACK_SECONDS}}

mkdir -p "$(dirname "$LOG")" 2>/dev/null
log() { echo "$(date '+%H:%M:%S') $*" >> "$LOG" 2>/dev/null; }

WAITED=0
while [ ! -f "$RESULT_FILE" ] && [ "$WAITED" -lt "$WAIT_LIMIT" ]; do
  sleep 5
  WAITED=$((WAITED + 5))
  [ $((WAITED % 60)) -eq 0 ] && log "still waiting on the MDB artifact (${WAITED}s)"
done

RESULT="$(cat "$RESULT_FILE" 2>/dev/null)"
[ -z "$RESULT" ] && RESULT="error: the MDB artifact did not finish within ${WAIT_LIMIT}s"
log "MDB artifact: $RESULT"

case "$RESULT" in
  ok|skipped) ;;
  *)
    # Rebooting into a rootfs that was never written lands back on this same
    # image via u-boot's rollback, and the run would read as having worked.
    # Leave the phase in place: the coordinator counts the attempt and gives
    # up after three, which is how this reaches a person.
    log "not rebooting: $RESULT"
    printf 'error: %s\n' "$RESULT" > "$STATUS_FILE"
    sync
    exit 1
    ;;
esac

# Retire immediately before the reboot, never at the top. A reboot that lands
# with this phase still in the directory runs it again on the next boot, and
# the vehicle reboots forever.
log "retiring this phase"
rm -f "$SCRIPTS_DIR/80-reboot.sh" "$SCRIPTS_DIR/80-reboot.sh.tries"
# The join is over, and the sweeps deliberately spare this file. Nothing
# should find it on the far side of the reboot and read it as this run's.
rm -f "$RESULT_FILE"
sync

log "rebooting to activate the installed images"
reboot &
sleep "$REBOOT_FALLBACK"
reboot -f

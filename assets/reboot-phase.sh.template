#!/bin/sh
# 80-reboot.sh — decides whether the run needs its one reboot. Generated by
# the installer.
#
# The MDB has been running the bootstrap image the whole way through, and
# writing an artifact does not activate it. This phase does not reboot: it
# exits 75 to ask the coordinator to, because the reboot belongs between
# phases and a phase that reboots never returns to be recorded as having run.
#
# It sits between the dashboard phase and the handover because 90-finalize.sh
# unlocks, and the vehicle should be on its real image by the time it does.
#
# Joins on 10-mdb-artifact.sh, which installs in the background so its write
# overlaps the dashboard work rather than following it.

INSTALLER_DIR="/data/installer"
SCRIPTS_DIR="$INSTALLER_DIR/scripts"
RESULT_FILE="$INSTALLER_DIR/mdb-artifact.result"
STATUS_FILE="$INSTALLER_DIR/trampoline-status"
RUN_ID="{{RUN_ID}}"
LOG="$INSTALLER_DIR/history/$RUN_ID/reboot.log"
WAIT_LIMIT={{MDB_ARTIFACT_WAIT_SECONDS}}

mkdir -p "$(dirname "$LOG")" 2>/dev/null
log() { echo "$(date '+%H:%M:%S') $*" >> "$LOG" 2>/dev/null; }

WAITED=0
while [ ! -f "$RESULT_FILE" ] && [ "$WAITED" -lt "$WAIT_LIMIT" ]; do
  sleep 5
  WAITED=$((WAITED + 5))
  [ $((WAITED % 60)) -eq 0 ] && log "still waiting on the MDB artifact (${WAITED}s)"
done

RESULT="$(cat "$RESULT_FILE" 2>/dev/null)"
[ -z "$RESULT" ] && RESULT="error: the MDB artifact did not finish within ${WAIT_LIMIT}s"
log "MDB artifact: $RESULT"

retire() {
  rm -f "$SCRIPTS_DIR/80-reboot.sh" "$SCRIPTS_DIR/80-reboot.sh.tries"
  rm -f "$RESULT_FILE"
  sync
}

case "$RESULT" in
  ok)
    log "asking the coordinator to reboot into the installed images"
    # The slot being left behind. mender-update install always switches slots,
    # so coming back up on this one means u-boot rolled the new image back,
    # and 90-finalize.sh must not call that success.
    BOOTED_ROOT="$(sed -n 's/.*root=\([^ ]*\).*/\1/p' "${CMDLINE:-/proc/cmdline}")"
    [ -n "$BOOTED_ROOT" ] && printf '%s\n' "$BOOTED_ROOT" > "$INSTALLER_DIR/previous-root"
    retire
    exit 75
    ;;
  skipped)
    # Nothing was installed here, so there is nothing to activate and a reboot
    # would only take the vehicle dark for a minute. The dashboard was powered
    # off when its own work finished, and the unlock in 90-finalize.sh brings
    # it back up on the image it just installed.
    log "no MDB artifact in this run, so no reboot is needed"
    retire
    exit 0
    ;;
  *)
    # Rebooting into a rootfs that was never written lands back on this same
    # image via u-boot's rollback, and the run would read as having worked.
    # Left queued so the coordinator's attempt counter reaches a person.
    log "not asking for a reboot: $RESULT"
    printf '%s\n' "$RESULT" > "$STATUS_FILE"
    sync
    exit 1
    ;;
esac
